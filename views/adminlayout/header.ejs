		<!-- Sidenav Menu End -->

		<!-- ========================
			Start Page Content
		========================= -->

        <style>

/* =========================================================
   PARENT MENU ACTIVE
   ========================================================= */

#sidebar-menu li.submenu.parent-active > a {
    background-color: #fde8e8 !important;
    color: #075e70 !important;
    border-radius: 8px !important;
}


/* Parent icon */

#sidebar-menu li.submenu.parent-active > a > i {
    color: #075e70 !important;
}


/* Parent arrow */

#sidebar-menu li.submenu.parent-active > a .menu-arrow {
    color: #075e70 !important;
}


/* =========================================================
   IMPORTANT:
   CHILDREN MUST NOT GET PARENT ACTIVE STYLE
   ========================================================= */

#sidebar-menu li.submenu.parent-active > ul li > a {
    background-color: transparent;
}


/* Current child */

#sidebar-menu li.submenu.parent-active > ul li.active > a {
    background-color: #fde8e8 !important;
    color: #075e70 !important;
}


/* Non-active child */

#sidebar-menu li.submenu.parent-active > ul li:not(.active) > a {
    background-color: transparent !important;
    color: #6c757d;
}

</style>
<script>
document.addEventListener('DOMContentLoaded', function () {

    const sidebar = document.getElementById('sidebar-menu');

    if (!sidebar) {
        return;
    }


    /* =========================================================
       CURRENT PATH
    ========================================================== */

    let currentPath = window.location.pathname;


    function normalizePath(path) {

        if (!path) {
            return '';
        }

        path = path.split('?')[0];

        if (
            path.length > 1 &&
            path.endsWith('/')
        ) {
            path = path.slice(0, -1);
        }

        return path;
    }


    currentPath = normalizePath(currentPath);


    /* =========================================================
       CHECK IF CHILD WAS JUST CLICKED
    ========================================================== */

    const closeAfterChildClick =
        sessionStorage.getItem(
            'sidebar_close_after_child'
        ) === '1';


    /*
     * Remove immediately.
     */

    sessionStorage.removeItem(
        'sidebar_close_after_child'
    );


    /* =========================================================
       RESET STATES
    ========================================================== */

    sidebar
        .querySelectorAll(
            'a.active'
        )
        .forEach(function (link) {

            link.classList.remove('active');

        });


    sidebar
        .querySelectorAll(
            'li.active'
        )
        .forEach(function (li) {

            li.classList.remove('active');

        });


    sidebar
        .querySelectorAll(
            'a.subdrop'
        )
        .forEach(function (link) {

            link.classList.remove('subdrop');

        });


    sidebar
        .querySelectorAll(
            'li.submenu'
        )
        .forEach(function (li) {

            li.classList.remove(
                'submenu-open'
            );


            li.classList.remove(
                'parent-active'
            );


            const submenu =
                li.querySelector(
                    ':scope > ul'
                );


            if (submenu) {

                submenu.style.display =
                    'none';

            }

        });


    /* =========================================================
       FIND CURRENT ACTIVE LINK
    ========================================================== */

    const links =
        sidebar.querySelectorAll(
            'a[href]'
        );


    let activeLink = null;
    let bestMatchLength = 0;


    links.forEach(function (link) {

        let href =
            link.getAttribute('href');


        if (!href) {
            return;
        }


        /* Ignore javascript links */

        if (
            href === '#' ||
            href.startsWith(
                'javascript:'
            )
        ) {
            return;
        }


        /* Ignore external links */

        if (
            href.startsWith('http://') ||
            href.startsWith('https://') ||
            href.startsWith('//')
        ) {
            return;
        }


        href =
            normalizePath(href);


        /* =====================================================
           EXACT MATCH
        ====================================================== */

        if (
            currentPath === href
        ) {

            activeLink = link;

            bestMatchLength =
                href.length;

            return;
        }


        /* =====================================================
           NESTED ROUTE MATCH
        ====================================================== */

        if (
            href !== '/admin' &&
            currentPath.startsWith(
                href + '/'
            ) &&
            href.length > bestMatchLength
        ) {

            activeLink = link;

            bestMatchLength =
                href.length;

        }

    });


    /* =========================================================
       NO ACTIVE LINK
    ========================================================== */

    if (!activeLink) {
        return;
    }


    /* =========================================================
       ACTIVE CHILD
    ========================================================== */

    activeLink.classList.add(
        'active'
    );


    const activeChildLi =
        activeLink.closest('li');


    if (activeChildLi) {

        activeChildLi.classList.add(
            'active'
        );

    }


    /* =========================================================
       FIND PARENT SUBMENU
    ========================================================== */

    let parentSubmenu =
        activeChildLi
            ? activeChildLi.closest(
                'li.submenu'
            )
            : null;


    /* =========================================================
       CHILD WAS JUST CLICKED
       CLOSE DROPDOWN
       BUT KEEP PARENT ACTIVE
    ========================================================== */

    if (
        closeAfterChildClick &&
        parentSubmenu
    ) {

        /*
         * IMPORTANT:
         *
         * Do NOT use:
         *
         * parentSubmenu.classList.add('active')
         *
         * because Dreams CSS will make
         * child items active too.
         */


        /*
         * Custom parent active class
         */

        parentSubmenu.classList.add(
            'parent-active'
        );


        /*
         * Parent link
         */

        const parentLink =
            parentSubmenu.querySelector(
                ':scope > a'
            );


        if (parentLink) {

            /*
             * Remove dropdown-open state
             */

            parentLink.classList.remove(
                'subdrop'
            );

        }


        /*
         * Close submenu
         */

        parentSubmenu.classList.remove(
            'submenu-open'
        );


        /*
         * Hide submenu
         */

        const submenu =
            parentSubmenu.querySelector(
                ':scope > ul'
            );


        if (submenu) {

            submenu.style.display =
                'none';

        }


        /*
         * STOP HERE
         *
         * Do not execute normal
         * page-load open logic.
         */

        return;
    }


    /* =========================================================
       NORMAL PAGE LOAD
       OPEN PARENT
    ========================================================== */

    while (parentSubmenu) {

        /*
         * Parent should NOT get
         * normal "active" class.
         */

        parentSubmenu.classList.remove(
            'active'
        );


        /*
         * Parent gets subdrop
         */

        const parentLink =
            parentSubmenu.querySelector(
                ':scope > a'
            );


        if (parentLink) {

            parentLink.classList.add(
                'subdrop'
            );

        }


        /*
         * Open parent
         */

        parentSubmenu.classList.add(
            'submenu-open'
        );


        /*
         * Show submenu
         */

        const submenu =
            parentSubmenu.querySelector(
                ':scope > ul'
            );


        if (submenu) {

            submenu.style.display =
                'block';

        }


        /*
         * Check nested parent
         */

        parentSubmenu =
            parentSubmenu.parentElement
                ? parentSubmenu.parentElement.closest(
                    'li.submenu'
                )
                : null;

    }


    /* =========================================================
       PARENT DROPDOWN CLICK
    ========================================================== */

    const submenuParents =
        sidebar.querySelectorAll(
            'li.submenu > a'
        );


    submenuParents.forEach(function (parentLink) {

        parentLink.addEventListener(
            'click',
            function (event) {

                event.preventDefault();

                event.stopPropagation();

                event.stopImmediatePropagation();


                const parentLi =
                    parentLink.closest(
                        'li.submenu'
                    );


                if (!parentLi) {
                    return;
                }


                const submenu =
                    parentLi.querySelector(
                        ':scope > ul'
                    );


                if (!submenu) {
                    return;
                }


                /* =================================================
                   CURRENT STATE
                ================================================== */

                const isOpen =
                    parentLi.classList.contains(
                        'submenu-open'
                    ) ||
                    parentLink.classList.contains(
                        'subdrop'
                    ) ||
                    submenu.style.display ===
                        'block';


                /* =================================================
                   CLOSE
                ================================================== */

                if (isOpen) {

                    parentLi.classList.remove(
                        'submenu-open'
                    );


                    parentLink.classList.remove(
                        'subdrop'
                    );


                    submenu.style.display =
                        'none';


                    /*
                     * Keep parent active if
                     * it contains current page.
                     */

                    if (
                        submenu.querySelector(
                            'a.active'
                        )
                    ) {

                        parentLi.classList.add(
                            'parent-active'
                        );

                    }

                }


                /* =================================================
                   OPEN
                ================================================== */

                else {

                    /*
                     * Remove parent custom
                     * active only if desired.
                     */

                    parentLi.classList.remove(
                        'parent-active'
                    );


                    parentLi.classList.add(
                        'submenu-open'
                    );


                    parentLink.classList.add(
                        'subdrop'
                    );


                    submenu.style.display =
                        'block';

                }

            },
            true
        );

    });


    /* =========================================================
       CHILD LINK CLICK
    ========================================================== */

    const childLinks =
        sidebar.querySelectorAll(
            'li.submenu > ul a[href]'
        );


    childLinks.forEach(function (childLink) {

        childLink.addEventListener(
            'click',
            function () {

                /*
                 * Next page:
                 *
                 * child active
                 * parent active
                 * dropdown closed
                 */

                sessionStorage.setItem(
                    'sidebar_close_after_child',
                    '1'
                );

            },
            true
        );

    });

});
</script>