<%
    /*
    |--------------------------------------------------------------------------
    | SAFE LOCALS
    |--------------------------------------------------------------------------
    */

    const purchaseFilters =
        typeof filters !== 'undefined' && filters
            ? filters
            : {};

    const purchaseList =
        Array.isArray(purchases)
            ? purchases
            : [];

    const userList =
        Array.isArray(users)
            ? users
            : [];

    const purchaseStats =
        typeof stats !== 'undefined' && stats
            ? stats
            : {};

    const purchasePagination =
        typeof pagination !== 'undefined' && pagination
            ? pagination
            : {
                page: 1,
                totalPages: 1,
                hasPrev: false,
                hasNext: false,
                pages: [1]
            };

    const totalPurchases =
        typeof total !== 'undefined'
            ? Number(total) || 0
            : purchaseList.length;

    const searchValue =
        purchaseFilters.search || '';

    const typeValue =
        purchaseFilters.type || '';

    const statusValue =
        purchaseFilters.status || '';

    const userValue =
        purchaseFilters.user || '';

    const sortValue =
        purchaseFilters.sort || '';


    /*
    |--------------------------------------------------------------------------
    | HELPERS
    |--------------------------------------------------------------------------
    */

    function formatMoney(value) {

        return Number(value || 0).toLocaleString(
            'en-IN',
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }
        );

    }


    function safeDate(value) {

        if (!value) {
            return '-';
        }

        try {

            if (typeof formatDate === 'function') {
                return formatDate(value);
            }

            const date = new Date(value);

            if (isNaN(date.getTime())) {
                return value;
            }

            return date.toLocaleDateString(
                'en-IN',
                {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                }
            );

        } catch (error) {

            return value;

        }

    }


    function queryString(params) {

        const query = [];

        Object.keys(params).forEach(function (key) {

            const value = params[key];

            if (
                value !== undefined &&
                value !== null &&
                value !== ''
            ) {

                query.push(
                    encodeURIComponent(key) +
                    '=' +
                    encodeURIComponent(value)
                );

            }

        });

        return query.join('&');

    }


    function statusClass(status) {

        if (status === 'completed') {
            return 'bg-soft-success text-success';
        }

        if (status === 'failed') {
            return 'bg-soft-danger text-danger';
        }

        if (status === 'refunded') {
            return 'bg-soft-secondary text-secondary';
        }

        return 'bg-soft-warning text-warning';

    }


    function statusIcon(status) {

        if (status === 'completed') {
            return 'ti-circle-check';
        }

        if (status === 'failed') {
            return 'ti-circle-x';
        }

        if (status === 'refunded') {
            return 'ti-arrow-back-up';
        }

        return 'ti-clock';

    }

%>


<%- include('../../adminlayout/header') %>


<style>

    /*
    |--------------------------------------------------------------------------
    | PURCHASE STAT CARDS
    |--------------------------------------------------------------------------
    */

    .purchase-stat-card {
        border: 1px solid #e9edf4;
        transition: all .25s ease;
        overflow: hidden;
        position: relative;
    }

    .purchase-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, .07);
    }

    .purchase-stat-card::after {
        content: "";
        position: absolute;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        right: -45px;
        bottom: -55px;
        background: rgba(0, 0, 0, .025);
        pointer-events: none;
    }

    .purchase-stat-icon {
        width: 54px;
        height: 54px;
        min-width: 54px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }


    /*
    |--------------------------------------------------------------------------
    | PURCHASE TABLE
    |--------------------------------------------------------------------------
    */

    #purchases-table th {
        white-space: nowrap;
    }

    #purchases-table td {
        vertical-align: middle;
    }


    /*
    |--------------------------------------------------------------------------
    | ORDER ID
    |--------------------------------------------------------------------------
    */

    .purchase-order-id {
        font-weight: 700;
        color: #212529;
        font-size: 13px;
    }


    /*
    |--------------------------------------------------------------------------
    | ITEM
    |--------------------------------------------------------------------------
    */

    .purchase-item-title {
        max-width: 280px;
    }

    .purchase-item-title span {
        display: block;
        max-width: 280px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    /*
    |--------------------------------------------------------------------------
    | USER
    |--------------------------------------------------------------------------
    */

    .purchase-user-name {
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .purchase-user-email {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    /*
    |--------------------------------------------------------------------------
    | STATUS SELECT
    |--------------------------------------------------------------------------
    */

    .purchase-status-select {
        min-width: 118px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        padding: 5px 28px 5px 9px;
        cursor: pointer;
    }


    /*
    |--------------------------------------------------------------------------
    | EMPTY STATE
    |--------------------------------------------------------------------------
    */

    .purchase-empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .purchase-empty-icon {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin-bottom: 16px;
    }


    /*
    |--------------------------------------------------------------------------
    | FILTER DROPDOWN
    |--------------------------------------------------------------------------
    */

    .purchase-filter-menu {
        min-width: 280px;
    }


    /*
    |--------------------------------------------------------------------------
    | RESPONSIVE
    |--------------------------------------------------------------------------
    */

    @media (max-width: 767px) {

        .purchase-item-title {
            max-width: 200px;
        }

        .purchase-item-title span {
            max-width: 200px;
        }

        .purchase-filter-menu {
            min-width: 260px;
        }

    }

</style>


<div class="page-wrapper">

    <div class="content pb-0">


        <!-- =========================================================
             ALERTS
        ========================================================== -->

        <% if (typeof success !== 'undefined' && success) { %>

            <div
                class="alert alert-success alert-dismissible fade show mb-4"
                role="alert"
            >

                <i class="ti ti-circle-check me-2"></i>

                <%= success %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>

            </div>

        <% } %>


        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>

            <div
                class="alert alert-danger alert-dismissible fade show mb-4"
                role="alert"
            >

                <ul class="mb-0 ps-3">

                    <% errors.forEach(function(error) { %>

                        <li>
                            <%= error %>
                        </li>

                    <% }) %>

                </ul>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>

            </div>

        <% } %>


        <!-- =========================================================
             PAGE HEADER
        ========================================================== -->

        <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">

            <div>

                <h4 class="mb-1">
                    Purchases
                </h4>

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb mb-0 p-0">

                        <li class="breadcrumb-item">

                            <a href="/admin">
                                Home
                            </a>

                        </li>

                        <li
                            class="breadcrumb-item active"
                            aria-current="page"
                        >
                            Purchases
                        </li>

                    </ol>

                </nav>

            </div>


            <div class="gap-2 d-flex align-items-center flex-wrap">


                <!-- Refresh -->

                <a
                    href="javascript:location.reload();"
                    class="btn btn-icon btn-outline-light shadow"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    aria-label="Refresh"
                    data-bs-original-title="Refresh"
                >

                    <i class="ti ti-refresh"></i>

                </a>


                <!-- Collapse -->

                <a
                    href="javascript:void(0);"
                    class="btn btn-icon btn-outline-light shadow"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    aria-label="Collapse"
                    data-bs-original-title="Collapse"
                    id="collapse-header"
                >

                    <i class="ti ti-transition-top"></i>

                </a>

            </div>

        </div>


        <!-- =========================================================
             STATISTICS
        ========================================================== -->

        <div class="row mb-4">


            <!-- TOTAL REVENUE -->

            <div class="col-xl-3 col-md-6 mb-3">

                <div class="card purchase-stat-card h-100 mb-0">

                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">

                            <div>

                                <p class="text-muted mb-1">
                                    Total Revenue
                                </p>

                                <h4 class="mb-1 fw-bold text-success">

                                    ₹<%= formatMoney(
                                        purchaseStats.totalRevenue
                                    ) %>

                                </h4>

                                <small class="text-muted">
                                    Revenue from purchases
                                </small>

                            </div>


                            <span class="purchase-stat-icon bg-soft-success text-success">

                                <i class="ti ti-currency-rupee"></i>

                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- TOTAL ORDERS -->

            <div class="col-xl-3 col-md-6 mb-3">

                <div class="card purchase-stat-card h-100 mb-0">

                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">

                            <div>

                                <p class="text-muted mb-1">
                                    Total Orders
                                </p>

                                <h4 class="mb-1 fw-bold text-primary">

                                    <%= Number(
                                        purchaseStats.totalOrders || 0
                                    ).toLocaleString('en-IN') %>

                                </h4>

                                <small class="text-muted">
                                    All purchase orders
                                </small>

                            </div>


                            <span class="purchase-stat-icon bg-soft-primary text-primary">

                                <i class="ti ti-receipt"></i>

                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- COMPLETED -->

            <div class="col-xl-3 col-md-6 mb-3">

                <div class="card purchase-stat-card h-100 mb-0">

                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">

                            <div>

                                <p class="text-muted mb-1">
                                    Completed
                                </p>

                                <h4 class="mb-1 fw-bold text-info">

                                    <%= Number(
                                        purchaseStats.completedOrders || 0
                                    ).toLocaleString('en-IN') %>

                                </h4>

                                <small class="text-muted">
                                    Successfully completed
                                </small>

                            </div>


                            <span class="purchase-stat-icon bg-soft-info text-info">

                                <i class="ti ti-circle-check"></i>

                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- REFUNDED -->

            <div class="col-xl-3 col-md-6 mb-3">

                <div class="card purchase-stat-card h-100 mb-0">

                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">

                            <div>

                                <p class="text-muted mb-1">
                                    Refunded
                                </p>

                                <h4 class="mb-1 fw-bold text-danger">

                                    <%= Number(
                                        purchaseStats.refundedOrders || 0
                                    ).toLocaleString('en-IN') %>

                                </h4>

                                <small class="text-muted">
                                    Refunded orders
                                </small>

                            </div>


                            <span class="purchase-stat-icon bg-soft-danger text-danger">

                                <i class="ti ti-arrow-back-up"></i>

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             PURCHASE CARD
        ========================================================== -->

        <div class="card border-0 rounded-0">


            <!-- =====================================================
                 CARD HEADER
            ====================================================== -->

            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">


                <!-- SEARCH -->

                <form
                    method="GET"
                    action="/admin/purchases"
                    class="mb-0 d-flex align-items-center gap-2 flex-wrap"
                >

                    <div class="input-icon input-icon-start position-relative">

                        <span class="input-icon-addon text-dark">

                            <i class="ti ti-search"></i>

                        </span>


                        <input
                            type="text"
                            name="search"
                            value="<%= searchValue %>"
                            class="form-control"
                            placeholder="Search order ID..."
                        >

                    </div>


                    <!-- PRESERVE FILTERS -->

                    <input
                        type="hidden"
                        name="type"
                        value="<%= typeValue %>"
                    >

                    <input
                        type="hidden"
                        name="status"
                        value="<%= statusValue %>"
                    >

                    <input
                        type="hidden"
                        name="user"
                        value="<%= userValue %>"
                    >


                    <button
                        type="submit"
                        class="btn btn-primary"
                    >

                        <i class="ti ti-search me-1"></i>

                        Search

                    </button>


                    <% if (
                        searchValue ||
                        typeValue ||
                        statusValue ||
                        userValue
                    ) { %>

                        <a
                            href="/admin/purchases"
                            class="btn btn-link text-decoration-none text-muted"
                        >

                            Clear

                        </a>

                    <% } %>

                </form>


                <!-- RIGHT SIDE -->

                <div class="d-flex align-items-center gap-2 flex-wrap">

                    <span class="text-muted small">

                        <%= totalPurchases %>
