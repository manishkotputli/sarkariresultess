                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">


                    <!-- SORT -->

                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <div class="dropdown">

                            <a
                                href="javascript:void(0);"
                                class="dropdown-toggle btn btn-outline-light shadow"
                                data-bs-toggle="dropdown"
                            >

                                <i class="ti ti-sort-ascending-2 me-2"></i>

                                Sort By

                            </a>


                            <div class="dropdown-menu">

                                <ul>

                                    <li>

                                        <a
                                            href="/admin/purchases?<%= queryString({
                                                search: searchValue,
                                                type: typeValue,
                                                status: statusValue,
                                                user: userValue,
                                                sort: 'newest'
                                            }) %>"
                                            class="dropdown-item"
                                        >

                                            <i class="ti ti-calendar-up me-2"></i>

                                            Newest First

                                        </a>

                                    </li>


                                    <li>

                                        <a
                                            href="/admin/purchases?<%= queryString({
                                                search: searchValue,
                                                type: typeValue,
                                                status: statusValue,
                                                user: userValue,
                                                sort: 'oldest'
                                            }) %>"
                                            class="dropdown-item"
                                        >

                                            <i class="ti ti-calendar-down me-2"></i>

                                            Oldest First

                                        </a>

                                    </li>


                                    <li>

                                        <a
                                            href="/admin/purchases?<%= queryString({
                                                search: searchValue,
                                                type: typeValue,
                                                status: statusValue,
                                                user: userValue,
                                                sort: 'amount_desc'
                                            }) %>"
                                            class="dropdown-item"
                                        >

                                            <i class="ti ti-sort-descending-2 me-2"></i>

                                            Highest Amount

                                        </a>

                                    </li>


                                    <li>

                                        <a
                                            href="/admin/purchases?<%= queryString({
                                                search: searchValue,
                                                type: typeValue,
                                                status: statusValue,
                                                user: userValue,
                                                sort: 'amount_asc'
                                            }) %>"
                                            class="dropdown-item"
                                        >

                                            <i class="ti ti-sort-ascending-2 me-2"></i>

                                            Lowest Amount

                                        </a>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>


                    <!-- RIGHT TOOLS -->

                    <div class="d-flex align-items-center gap-2 flex-wrap">


                        <!-- FILTER -->

                        <div class="dropdown">

                            <a
                                href="javascript:void(0);"
                                class="btn btn-outline-light shadow dropdown-toggle"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                            >

                                <i class="ti ti-filter me-2"></i>

                                Filter

                                <% if (
                                    typeValue ||
                                    statusValue ||
                                    userValue
                                ) { %>

                                    <span class="badge bg-primary ms-1">
                                        <%= [
                                            typeValue,
                                            statusValue,
                                            userValue
                                        ].filter(Boolean).length %>
                                    </span>

                                <% } %>

                            </a>


                            <div class="dropdown-menu dropdown-menu-end p-3 purchase-filter-menu">


                                <form
                                    method="GET"
                                    action="/admin/purchases"
                                >


                                    <!-- SEARCH -->

                                    <div class="mb-3">

                                        <label class="form-label">
                                            Search
                                        </label>

                                        <input
                                            type="text"
                                            name="search"
                                            value="<%= searchValue %>"
                                            class="form-control"
                                            placeholder="Order ID..."
                                        >

                                    </div>


                                    <!-- ITEM TYPE -->

                                    <div class="mb-3">

                                        <label class="form-label">
                                            Item Type
                                        </label>

                                        <select
                                            name="type"
                                            class="form-select"
                                        >

                                            <option value="">
                                                All Items
                                            </option>

                                            <option
                                                value="course"
                                                <%= typeValue === 'course' ? 'selected' : '' %>
                                            >
                                                Courses
                                            </option>

                                            <option
                                                value="test_series"
                                                <%= typeValue === 'test_series' ? 'selected' : '' %>
                                            >
                                                Test Series
                                            </option>

                                        </select>

                                    </div>


                                    <!-- STATUS -->

                                    <div class="mb-3">

                                        <label class="form-label">
                                            Payment Status
                                        </label>

                                        <select
                                            name="status"
                                            class="form-select"
                                        >

                                            <option value="">
                                                All Status
                                            </option>

                                            <option
                                                value="pending"
                                                <%= statusValue === 'pending' ? 'selected' : '' %>
                                            >
                                                Pending
                                            </option>

                                            <option
                                                value="completed"
                                                <%= statusValue === 'completed' ? 'selected' : '' %>
                                            >
                                                Completed
                                            </option>

                                            <option
                                                value="failed"
                                                <%= statusValue === 'failed' ? 'selected' : '' %>
                                            >
                                                Failed
                                            </option>

                                            <option
                                                value="refunded"
                                                <%= statusValue === 'refunded' ? 'selected' : '' %>
                                            >
                                                Refunded
                                            </option>

                                        </select>

                                    </div>


                                    <!-- USER -->

                                    <div class="mb-3">

                                        <label class="form-label">
                                            User
                                        </label>

                                        <select
                                            name="user"
                                            class="form-select"
                                        >

                                            <option value="">
                                                All Users
                                            </option>


                                            <% userList.forEach(function(u) { %>

                                                <option
                                                    value="<%= u.id %>"
                                                    <%= String(userValue) === String(u.id) ? 'selected' : '' %>
                                                >

                                                    <%= u.name %>

                                                </option>

                                            <% }) %>

                                        </select>

                                    </div>


                                    <!-- SORT PRESERVE -->

                                    <input
                                        type="hidden"
                                        name="sort"
                                        value="<%= sortValue %>"
                                    >


                                    <div class="d-flex gap-2">

                                        <button
                                            type="submit"
                                            class="btn btn-primary flex-fill"
                                        >

                                            Apply

                                        </button>


                                        <a
                                            href="/admin/purchases"
                                            class="btn btn-light flex-fill"
                                        >

                                            Clear

                                        </a>

                                    </div>

                                </form>

                            </div>

                        </div>


                        <!-- MANAGE COLUMNS -->

                        <div class="dropdown">

                            <a
                                href="javascript:void(0);"
                                class="btn bg-soft-indigo border-0"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                            >

                                <i class="ti ti-columns-3 me-2"></i>

                                Manage Columns

                            </a>


                            <div class="dropdown-menu dropdown-menu-md dropdown-menu-end p-3">

                                <ul class="list-unstyled mb-0">


                                    <!-- ORDER ID -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-hash me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Order ID</span>

                                                <input
                                                    class="form-check-input purchase-column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="0"
                                                    data-key="order"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- ITEM -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-book me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Item</span>

                                                <input
                                                    class="form-check-input purchase-column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="1"
                                                    data-key="item"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- USER -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-user me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>User</span>

                                                <input
                                                    class="form-check-input purchase-column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="2"
                                                    data-key="user"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- AMOUNT -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-currency-rupee me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Amount</span>

                                                <input
                                                    class="form-check-input purchase-column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="3"
                                                    data-key="amount"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- STATUS -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-circle-check me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Status</span>

                                                <input
                                                    class="form-check-input purchase-column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="4"
                                                    data-key="status"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- DATE -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-calendar me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Date</span>

                                                <input
                                                    class="form-check-input purchase-column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="5"
                                                    data-key="date"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- ACTION -->

                                    <li class="gap-1 d-flex align-items-center">

                                        <i class="ti ti-settings me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Action</span>

                                                <input
                                                    class="form-check-input ms-auto"
                                                    type="checkbox"
                                                    checked
                                                    disabled
                                                >

                                            </label>

                                        </div>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 PURCHASE TABLE
            ====================================================== -->

            <div class="card-body pt-0">

                <div class="table-responsive custom-table">

                    <table
                        class="table table-nowrap"
                        id="purchases-table"
                    >

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Order ID
                                </th>

                                <th>
                                    Item
                                </th>

                                <th>
                                    User
                                </th>

                                <th class="text-end">
                                    Amount
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Date
                                </th>

                                <th class="text-end no-sort">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <% if (purchaseList.length) { %>


                                <% purchaseList.forEach(function(p) { %>

                                    <tr>


                                        <!-- ORDER ID -->

                                        <td>

                                            <span class="purchase-order-id">

                                                <%= p.order_id || ('#' + p.id) %>

                                            </span>

                                        </td>


                                        <!-- ITEM -->

                                        <td>

                                            <div class="d-flex align-items-center gap-3 purchase-item-title">


                                                <span
                                                    class="avatar avatar-sm rounded-circle
                                                    <%= p.purchasable_type === 'course'
                                                        ? 'bg-soft-primary text-primary'
                                                        : 'bg-soft-indigo text-indigo'
                                                    %>"
                                                >

                                                    <i
                                                        class="ti
                                                        <%= p.purchasable_type === 'course'
                                                            ? 'ti-book'
                                                            : 'ti-clipboard-list'
                                                        %>"
                                                    ></i>

                                                </span>


                                                <div class="min-w-0">

                                                    <h6 class="mb-0 fw-semibold">

                                                        <span
                                                            title="<%= p.itemTitle || 'Untitled Item' %>"
                                                        >

                                                            <%= p.itemTitle || 'Untitled Item' %>

                                                        </span>

                                                    </h6>


                                                    <% if (p.purchasable_type === 'course') { %>

                                                        <small class="text-muted">

                                                            <i class="ti ti-book-2 me-1"></i>

                                                            Course

                                                        </small>

                                                    <% } else { %>

                                                        <small class="text-muted">

                                                            <i class="ti ti-clipboard-list me-1"></i>

                                                            Test Series

                                                        </small>

                                                    <% } %>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- USER -->

                                        <td>

                                            <% if (p.User) { %>

                                                <div>

                                                    <h6
                                                        class="mb-0 fw-semibold purchase-user-name"
                                                        title="<%= p.User.name %>"
                                                    >

                                                        <%= p.User.name %>

                                                    </h6>


                                                    <% if (p.User.email) { %>

                                                        <small
                                                            class="text-muted d-block purchase-user-email"
                                                            title="<%= p.User.email %>"
                                                        >

                                                            <%= p.User.email %>

                                                        </small>

                                                    <% } %>

                                                </div>

                                            <% } else { %>

                                                <span class="text-muted">
                                                    —
                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- AMOUNT -->

                                        <td class="text-end">

                                            <span class="fw-bold text-dark">

                                                ₹<%= formatMoney(p.amount) %>

                                            </span>

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            <form
                                                method="POST"
                                                action="/admin/purchases/<%= p.id %>/status"
                                                class="d-inline"
                                            >

                                                <select
                                                    name="payment_status"
                                                    onchange="this.form.submit()"
                                                    class="form-select purchase-status-select <%= statusClass(p.payment_status) %>"
                                                    title="Change payment status"
                                                >

                                                    <option
                                                        value="pending"
                                                        <%= p.payment_status === 'pending' ? 'selected' : '' %>
                                                    >
                                                        Pending
                                                    </option>

                                                    <option
                                                        value="completed"
                                                        <%= p.payment_status === 'completed' ? 'selected' : '' %>
                                                    >
                                                        Completed
                                                    </option>

                                                    <option
                                                        value="failed"
                                                        <%= p.payment_status === 'failed' ? 'selected' : '' %>
                                                    >
                                                        Failed
                                                    </option>

                                                    <option
                                                        value="refunded"
                                                        <%= p.payment_status === 'refunded' ? 'selected' : '' %>
                                                    >
                                                        Refunded
                                                    </option>

                                                </select>

                                            </form>

                                        </td>


                                        <!-- DATE -->

                                        <td>

                                            <span class="text-muted">

                                                <i class="ti ti-calendar-event me-1"></i>

                                                <%= safeDate(p.created_at) %>

                                            </span>

                                        </td>


                                        <!-- ACTION -->

                                        <td class="text-end">

                                            <div class="dropdown">

                                                <a
                                                    href="javascript:void(0);"
                                                    class="btn btn-icon btn-sm"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false"
                                                    title="Actions"
                                                >

                                                    <i class="ti ti-dots-vertical"></i>

                                                </a>


                                                <ul class="dropdown-menu dropdown-menu-end">


                                                    <!-- RECEIPT -->

                                                    <li>

                                                        <a
                                                            href="/admin/purchases/<%= p.id %>/receipt"
                                                            target="_blank"
                                                            class="dropdown-item"
                                                        >

                                                            <i class="ti ti-receipt me-2"></i>

                                                            View Receipt

                                                        </a>

                                                    </li>


                                                    <!-- COPY ORDER ID -->

                                                    <li>

                                                        <a
                                                            href="javascript:void(0);"
                                                            class="dropdown-item copy-order-id"
                                                            data-order-id="<%= p.order_id || ('#' + p.id) %>"
                                                        >

                                                            <i class="ti ti-copy me-2"></i>

                                                            Copy Order ID

                                                        </a>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>


                            <% } else { %>


                                <!-- EMPTY -->

                                <tr>

                                    <td
                                        colspan="7"
                                        class="text-center"
                                    >

                                        <div class="purchase-empty-state">

                                            <div class="purchase-empty-icon bg-soft-primary text-primary">

                                                <i class="ti ti-shopping-cart-off"></i>

                                            </div>


                                            <h5 class="mb-1">
                                                No Purchases Found
                                            </h5>


                                            <p class="text-muted mb-3">

                                                No purchase orders match your
                                                current search or filters.

                                            </p>


                                            <% if (
                                                searchValue ||
                                                typeValue ||
                                                statusValue ||
                                                userValue
                                            ) { %>

                                                <a
                                                    href="/admin/purchases"
                                                    class="btn btn-light btn-sm"
                                                >

                                                    <i class="ti ti-filter-off me-1"></i>

                                                    Clear Filters

                                                </a>

                                            <% } %>

                                        </div>

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     PAGINATION
                ================================================== -->

                <% if (
                    purchasePagination &&
                    purchasePagination.totalPages > 1
                ) { %>


                    <div class="row align-items-center mt-3">


                        <!-- PAGINATION INFO -->

                        <div class="col-md-6">

                            <div class="text-muted">

                                Page
                                <%= purchasePagination.page %>
                                of
                                <%= purchasePagination.totalPages %>

                                &nbsp;·&nbsp;

                                <%= totalPurchases %>
                                total purchases

                            </div>

                        </div>


                        <!-- PAGINATION -->

                        <div class="col-md-6">

                            <div class="d-flex justify-content-end">

                                <ul class="pagination mb-0">


                                    <!-- PREVIOUS -->

                                    <% if (purchasePagination.hasPrev) { %>

                                        <li class="page-item">

                                            <a
                                                class="page-link"
                                                href="/admin/purchases?<%= queryString({
                                                    page: purchasePagination.page - 1,
                                                    search: searchValue,
                                                    type: typeValue,
                                                    status: statusValue,
                                                    user: userValue,
                                                    sort: sortValue
                                                }) %>"
                                            >

                                                <i class="ti ti-chevron-left"></i>

                                            </a>

                                        </li>

                                    <% } %>


                                    <!-- PAGES -->

                                    <% if (
                                        purchasePagination.pages &&
                                        purchasePagination.pages.length
                                    ) { %>


                                        <% purchasePagination.pages.forEach(function(pg) { %>

                                            <li
                                                class="page-item <%= Number(pg) === Number(purchasePagination.page) ? 'active' : '' %>"
                                            >

                                                <a
                                                    class="page-link"
                                                    href="/admin/purchases?<%= queryString({
                                                        page: pg,
                                                        search: searchValue,
                                                        type: typeValue,
                                                        status: statusValue,
                                                        user: userValue,
                                                        sort: sortValue
                                                    }) %>"
                                                >

                                                    <%= pg %>

                                                </a>

                                            </li>

                                        <% }) %>


                                    <% } %>


                                    <!-- NEXT -->

                                    <% if (purchasePagination.hasNext) { %>

                                        <li class="page-item">

                                            <a
                                                class="page-link"
                                                href="/admin/purchases?<%= queryString({
                                                    page: purchasePagination.page + 1,
                                                    search: searchValue,
                                                    type: typeValue,
                                                    status: statusValue,
                                                    user: userValue,
                                                    sort: sortValue
                                                }) %>"
                                            >

                                                <i class="ti ti-chevron-right"></i>

                                            </a>

                                        </li>

                                    <% } %>

                                </ul>

                            </div>

                        </div>

                    </div>


                <% } %>

            </div>

        </div>

    </div>

</div>


<!-- ================================================================
     JAVASCRIPT
================================================================ -->

<script>

document.addEventListener(
    'DOMContentLoaded',
    function () {


        /*
        |--------------------------------------------------------------------------
        | Manage Columns
        |--------------------------------------------------------------------------
        */

        const table =
            document.getElementById(
                'purchases-table'
            );


        const columnToggles =
            document.querySelectorAll(
                '.purchase-column-toggle[data-column]'
            );


        function applyColumn(
            columnIndex,
            visible
        ) {

            if (!table) {
                return;
            }


            table
                .querySelectorAll('tr')
                .forEach(
                    function (row) {

                        const cell =
                            row.children[
                                columnIndex
                            ];


                        if (!cell) {
                            return;
                        }


                        if (visible) {

                            cell.style.removeProperty(
                                'display'
                            );

                        } else {

                            cell.style.setProperty(
                                'display',
                                'none',
                                'important'
                            );

                        }

                    }
                );

        }


        columnToggles.forEach(
            function (toggle) {


                const column =
                    parseInt(
                        toggle.dataset.column,
                        10
                    );


                const key =
                    toggle.dataset.key ||
                    column;


                const storageKey =
                    'purchases_column_' +
                    key;


                /*
                |--------------------------------------------------------------------------
                | Restore Saved State
                |--------------------------------------------------------------------------
                */

                const saved =
                    localStorage.getItem(
                        storageKey
                    );


                if (saved === '0') {

                    toggle.checked =
                        false;

                    applyColumn(
                        column,
                        false
                    );

                }


                /*
                |--------------------------------------------------------------------------
                | Toggle
                |--------------------------------------------------------------------------
                */

                toggle.addEventListener(
                    'change',
                    function () {

                        const visible =
                            this.checked;


                        localStorage.setItem(
                            storageKey,
                            visible
                                ? '1'
                                : '0'
                        );


                        applyColumn(
                            column,
                            visible
                        );

                    }
                );

            }
        );


        /*
        |--------------------------------------------------------------------------
        | Copy Order ID
        |--------------------------------------------------------------------------
        */

        document
            .querySelectorAll(
                '.copy-order-id'
            )
            .forEach(
                function (button) {

                    button.addEventListener(
                        'click',
                        async function () {

                            const orderId =
                                this.dataset.orderId ||
                                '';


                            try {

                                await navigator.clipboard.writeText(
                                    orderId
                                );


                                const original =
                                    this.innerHTML;


                                this.innerHTML =
                                    '<i class="ti ti-check me-2"></i> Copied';


                                setTimeout(
                                    function () {

                                        button.innerHTML =
                                            original;

                                    },
                                    1200
                                );


                            } catch (error) {

                                /*
                                | Clipboard unavailable.
                                | Silently ignore.
                                */

                            }

                        }
                    );

                }
            );


        /*
        |--------------------------------------------------------------------------
        | Prevent Accidental Double Submit
        |--------------------------------------------------------------------------
        */

        document
            .querySelectorAll(
                '#purchases-table form'
            )
            .forEach(
                function (form) {

                    form.addEventListener(
                        'submit',
                        function () {

                            const select =
                                form.querySelector(
                                    'select[name="payment_status"]'
                                );


                            if (select) {

                                select.disabled =
                                    true;

                            }

                        }
                    );

                }
            );

    }
);

</script>


<%- include('../../adminlayout/footer') %>