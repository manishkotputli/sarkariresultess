<%
    /*
    |--------------------------------------------------------------------------
    | SAFE DATA
    |--------------------------------------------------------------------------
    */

    const siteSettings =
        typeof site_setting !== 'undefined' && site_setting
            ? site_setting
            : {};

    const purchaseData =
        typeof purchase !== 'undefined' && purchase
            ? purchase
            : {};

    const customer =
        purchaseData.User || null;

    const receiptTitle =
        typeof title !== 'undefined' && title
            ? title
            : 'Payment Receipt';

    const orderNumber =
        purchaseData.order_id ||
        ('#' + (purchaseData.id || ''));

    const itemTitle =
        purchaseData.itemTitle ||
        (
            purchaseData.purchasable_type === 'course'
                ? 'Course'
                : 'Test Series'
        );

    const itemType =
        purchaseData.purchasable_type === 'course'
            ? 'Course'
            : 'Test Series';

    const amount =
        Number(purchaseData.amount || 0);

    const paymentStatus =
        String(
            purchaseData.payment_status || 'pending'
        ).toLowerCase();

    const paymentMethod =
        purchaseData.payment_method ||
        '—';

    const transactionId =
        purchaseData.transaction_id ||
        '—';

    const purchaseDate =
        purchaseData.purchased_at ||
        purchaseData.created_at ||
        null;


    /*
    |--------------------------------------------------------------------------
    | DATE HELPER
    |--------------------------------------------------------------------------
    */

    function receiptDate(value) {

        if (!value) {
            return '—';
        }

        try {

            if (typeof formatDate === 'function') {
                return formatDate(value);
            }

            const date = new Date(value);

            if (isNaN(date.getTime())) {
                return value;
            }

            return date.toLocaleDateString(
                'en-IN',
                {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                }
            );

        } catch (error) {

            return value;

        }

    }


    /*
    |--------------------------------------------------------------------------
    | DATE + TIME
    |--------------------------------------------------------------------------
    */

    function receiptDateTime(value) {

        if (!value) {
            return '—';
        }

        try {

            const date = new Date(value);

            if (isNaN(date.getTime())) {
                return receiptDate(value);
            }

            return date.toLocaleString(
                'en-IN',
                {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                }
            );

        } catch (error) {

            return receiptDate(value);

        }

    }


    /*
    |--------------------------------------------------------------------------
    | MONEY
    |--------------------------------------------------------------------------
    */

    function formatMoney(value) {

        return Number(value || 0).toLocaleString(
            'en-IN',
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }
        );

    }


    /*
    |--------------------------------------------------------------------------
    | STATUS
    |--------------------------------------------------------------------------
    */

    const statusConfig = {

        completed: {
            label: 'Payment Successful',
            shortLabel: 'PAID',
            className: 'completed',
            icon: '✓'
        },

        pending: {
            label: 'Payment Pending',
            shortLabel: 'PENDING',
            className: 'pending',
            icon: '!'
        },

        failed: {
            label: 'Payment Failed',
            shortLabel: 'FAILED',
            className: 'failed',
            icon: '×'
        },

        refunded: {
            label: 'Payment Refunded',
            shortLabel: 'REFUNDED',
            className: 'refunded',
            icon: '↩'
        }

    };

    const currentStatus =
        statusConfig[paymentStatus] ||
        statusConfig.pending;


    /*
    |--------------------------------------------------------------------------
    | LOGO
    |--------------------------------------------------------------------------
    */

    const logoPath =
        '/admin_assets/img/logo.png';


    /*
    |--------------------------------------------------------------------------
    | COMPANY INFORMATION
    |--------------------------------------------------------------------------
    */

    const companyName =
        siteSettings.site_title ||
        'Sarkari Resultess';

    const companyEmail =
        siteSettings.contact_email ||
        '';

    const companyPhone =
        siteSettings.contact_phone ||
        siteSettings.phone ||
        '';

    const companyAddress =
        siteSettings.address ||
        '';


%>


<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8">

    <title>
        <%= receiptTitle %>
    </title>

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="robots"
        content="noindex,nofollow"
    >


    <style>

        /* =========================================================
           GLOBAL
        ========================================================= */

        * {
            box-sizing: border-box;
        }


        html,
        body {
            margin: 0;
            padding: 0;
        }


        body {

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;

            background:
                #eef1f6;

            color:
                #172033;

            padding:
                35px 16px 50px;

            -webkit-font-smoothing:
                antialiased;

        }


        /* =========================================================
           PAGE
        ========================================================= */

        .receipt-page {

            width: 100%;
            max-width: 820px;

            margin: 0 auto;

        }


        /* =========================================================
           RECEIPT SHEET
        ========================================================= */

        .receipt {

            position: relative;

            background:
                #ffffff;

            border:
                1px solid #e4e8ef;

            border-radius:
                14px;

            overflow:
                hidden;

            box-shadow:
                0 18px 55px rgba(16, 24, 40, .10);

        }


        /* =========================================================
           FADED LOGO WATERMARK / BACKDROP
        ========================================================= */

        .receipt-watermark {

            position: absolute;

            right: -65px;
            top: 205px;

            width: 390px;
            height: 390px;

            background-image:
                url('/admin_assets/img/logo.png');

            background-repeat:
                no-repeat;

            background-position:
                center;

            background-size:
                contain;

            opacity:
                .035;

            filter:
                grayscale(100%);

            pointer-events:
                none;

            z-index:
                0;

        }


        .receipt-watermark-two {

            position: absolute;

            left: -125px;
            bottom: 60px;

            width: 300px;
            height: 300px;

            background-image:
                url('/admin_assets/img/logo.png');

            background-repeat:
                no-repeat;

            background-position:
                center;

            background-size:
                contain;

            opacity:
                .018;

            filter:
                grayscale(100%);

            pointer-events:
                none;

            z-index:
                0;

        }


        .receipt-content {

            position: relative;

            z-index:
                2;

        }


        /* =========================================================
           TOP BRAND BAR
        ========================================================= */

        .brand-strip {

            height:
                5px;

            background:
                linear-gradient(
                    90deg,
                    #d71920 0%,
                    #e23a3f 28%,
                    #1c315b 60%,
                    #70bf4c 100%
                );

        }


        /* =========================================================
           HEADER
        ========================================================= */

        .receipt-header {

            padding:
                30px 38px 28px;

            border-bottom:
                1px solid #e9edf3;

            display:
                flex;

            align-items:
                flex-start;

            justify-content:
                space-between;

            gap:
                30px;

        }


        .company {

            display:
                flex;

            align-items:
                center;

            gap:
                15px;

        }


        .company-logo {

            width:
                62px;

            height:
                62px;

            object-fit:
                contain;

            display:
                block;

        }


        .company-details {

            min-width:
                0;

        }


        .company-name {

            margin:
                0;

            font-size:
                21px;

            line-height:
                1.25;

            font-weight:
                800;

            color:
                #14213d;

            letter-spacing:
                -.3px;

        }


        .company-tagline {

            margin:
                5px 0 0;

            font-size:
                12px;

            color:
                #7a8495;

        }


        .company-contact {

            margin:
                7px 0 0;

            font-size:
                11px;

            color:
                #929aaa;

            line-height:
                1.6;

        }


        /* =========================================================
           RECEIPT TITLE
        ========================================================= */

        .receipt-heading {

            text-align:
                right;

            flex-shrink:
                0;

        }


        .receipt-label {

            margin:
                0;

            font-size:
                27px;

            line-height:
                1;

            font-weight:
                800;

            letter-spacing:
                1.3px;

            color:
                #14213d;

        }


        .receipt-sub-label {

            margin:
                7px 0 0;

            color:
                #8b94a5;

            font-size:
                11px;

            text-transform:
                uppercase;

            letter-spacing:
                1px;

        }


        /* =========================================================
           STATUS
        ========================================================= */

        .status-badge {

            margin-top:
                13px;

            display:
                inline-flex;

            align-items:
                center;

            gap:
                7px;

            padding:
                7px 12px;

            border-radius:
                7px;

            font-size:
                10px;

            font-weight:
                800;

            letter-spacing:
                .7px;

            text-transform:
                uppercase;

        }


        .status-icon {

            width:
                17px;

            height:
                17px;

            border-radius:
                50%;

            display:
                inline-flex;

            align-items:
                center;

            justify-content:
                center;

            font-size:
                10px;

            font-weight:
                900;

        }


        .status-badge.completed {

            color:
                #147a42;

            background:
                #eaf8ef;

        }


        .status-badge.completed .status-icon {

            background:
                #1e9d58;

            color:
                #fff;

        }


        .status-badge.pending {

            color:
                #986b00;

            background:
                #fff7dc;

        }


        .status-badge.pending .status-icon {

            background:
                #e5aa19;

            color:
                #fff;

        }


        .status-badge.failed {

            color:
                #b42318;

            background:
                #fff0ef;

        }


        .status-badge.failed .status-icon {

            background:
                #d92d20;

            color:
                #fff;

        }


        .status-badge.refunded {

            color:
                #596273;

            background:
                #f0f2f5;

        }


        .status-badge.refunded .status-icon {

            background:
                #7c8798;

            color:
                #fff;

        }


        /* =========================================================
           BODY
        ========================================================= */

        .receipt-body {

            padding:
                34px 38px 36px;

        }


        /* =========================================================
           ORDER META
        ========================================================= */

        .order-meta {

            display:
                grid;

            grid-template-columns:
                1.3fr 1fr 1fr;

            gap:
                1px;

            background:
                #e7ebf1;

            border:
                1px solid #e7ebf1;

            border-radius:
                10px;

            overflow:
                hidden;

            margin-bottom:
                30px;

        }


        .meta-item {

            background:
                #fafbfc;

            padding:
                15px 17px;

        }


        .meta-label {

            display:
                block;

            margin-bottom:
                5px;

            font-size:
                9px;

            font-weight:
                800;

            text-transform:
                uppercase;

            letter-spacing:
                .8px;

            color:
                #9199a8;

        }


        .meta-value {

            display:
                block;

            font-size:
                13px;

            font-weight:
                700;

            color:
                #202a3a;

            word-break:
                break-word;

        }


        /* =========================================================
           BILLING SECTION
        ========================================================= */

        .section-title {

            display:
                flex;

            align-items:
                center;

            gap:
                9px;

            margin:
                0 0 13px;

            font-size:
                12px;

            font-weight:
                800;

            text-transform:
                uppercase;

            letter-spacing:
                .7px;

            color:
                #4d586a;

        }


        .section-title::before {

            content:
                "";

            width:
                4px;

            height:
                17px;

            border-radius:
                5px;

            background:
                #d71920;

        }


        .billing-box {

            display:
                grid;

            grid-template-columns:
                1.2fr 1fr 1fr;

            gap:
                25px;

            margin-bottom:
                32px;

        }


        .billing-column {

            min-width:
                0;

        }


        .field-label {

            font-size:
                10px;

            font-weight:
                800;

            text-transform:
                uppercase;

            letter-spacing:
                .65px;

            color:
                #9aa2b1;

            margin-bottom:
                5px;

        }


        .field-value {

            font-size:
                13px;

            font-weight:
                600;

            color:
                #202a3a;

            line-height:
                1.55;

            word-break:
                break-word;

        }


        .field-value.muted {

            color:
                #737d8e;

            font-weight:
                500;

        }


        /* =========================================================
           ITEMS TABLE
        ========================================================= */

        .items-section {

            margin-top:
                3px;

        }


        .items-table {

            width:
                100%;

            border-collapse:
                collapse;

            margin-top:
                5px;

        }


        .items-table thead th {

            background:
                #f5f7fa;

            border-top:
                1px solid #e4e8ef;

            border-bottom:
                1px solid #e4e8ef;

            padding:
                12px 14px;

            font-size:
                9px;

            font-weight:
                800;

            text-transform:
                uppercase;

            letter-spacing:
                .75px;

            color:
                #788294;

            text-align:
                left;

        }


        .items-table thead th:first-child {

            border-radius:
                7px 0 0 7px;

        }


        .items-table thead th:last-child {

            border-radius:
                0 7px 7px 0;

        }


        .items-table tbody td {

            padding:
                17px 14px;

            border-bottom:
                1px solid #edf0f4;

            font-size:
                13px;

            color:
                #303a4c;

            vertical-align:
                middle;

        }


        .items-table .amount {

            text-align:
                right;

            font-weight:
                800;

            color:
                #182235;

            white-space:
                nowrap;

        }


        .item-main {

            display:
                flex;

            align-items:
                center;

            gap:
                12px;

        }


        .item-icon {

            width:
                39px;

            height:
                39px;

            min-width:
                39px;

            border-radius:
                8px;

            display:
                inline-flex;

            align-items:
                center;

            justify-content:
                center;

            color:
                #fff;

            font-size:
                17px;

            font-weight:
                800;

            background:
                #20365f;

        }


        .item-icon.course {

            background:
                #eaf1ff;

            color:
                #315ea8;

        }


        .item-icon.series {

            background:
                #eaf8ef;

            color:
                #278052;

        }


        .item-name {

            font-weight:
                700;

            color:
                #1e293b;

            line-height:
                1.4;

        }


        .item-subtitle {

            margin-top:
                3px;

            color:
                #8a93a3;

            font-size:
                10px;

        }


        /* =========================================================
           SUMMARY
        ========================================================= */

        .summary-wrapper {

            display:
                flex;

            justify-content:
                flex-end;

            margin-top:
                18px;

        }


        .summary {

            width:
                315px;

            max-width:
                100%;

        }


        .summary-row {

            display:
                flex;

            align-items:
                center;

            justify-content:
                space-between;

            gap:
                20px;

            padding:
                8px 0;

            color:
                #687386;

            font-size:
                12px;

        }


        .summary-row strong {

            color:
                #273143;

            font-weight:
                700;

        }


        .summary-divider {

            height:
                1px;

            background:
                #dfe4eb;

            margin:
                8px 0;

        }


        .summary-total {

            display:
                flex;

            align-items:
                center;

            justify-content:
                space-between;

            gap:
                20px;

            padding:
                14px 16px;

            margin-top:
                8px;

            border-radius:
                9px;

            background:
                #14213d;

            color:
                #fff;

        }


        .summary-total-label {

            font-size:
                11px;

            font-weight:
                700;

            text-transform:
                uppercase;

            letter-spacing:
                .6px;

            opacity:
                .78;

        }


        .summary-total-value {

            font-size:
                19px;

            font-weight:
                800;

            white-space:
                nowrap;

        }


        /* =========================================================
           PAYMENT INFORMATION
        ========================================================= */

        .payment-information {

            margin-top:
                34px;

            padding:
                18px;

            border:
                1px solid #e5e9ef;

            border-radius:
                10px;

            background:
                #fbfcfd;

        }


        .payment-grid {

            display:
                grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap:
                18px;

        }


        .payment-item {

            min-width:
                0;

        }


        /* =========================================================
           SUCCESS MESSAGE
        ========================================================= */

        .success-note {

            margin-top:
                25px;

            padding:
                13px 15px;

            border-radius:
                8px;

            background:
                #effaf3;

            border:
                1px solid #d7f0df;

            color:
                #22643c;

            font-size:
                11px;

            line-height:
                1.6;

        }


        .success-note strong {

            font-weight:
                800;

        }


        /* =========================================================
           FOOTER
        ========================================================= */

        .receipt-footer {

            position:
                relative;

            padding:
                22px 38px 26px;

            background:
                #f8f9fb;

            border-top:
                1px solid #e6eaf0;

            text-align:
                center;

        }


        .footer-title {

            margin:
                0 0 5px;

            font-size:
                12px;

            font-weight:
                800;

            color:
                #303b4e;

        }


        .footer-text {

            margin:
                0 auto;

            max-width:
                620px;

            font-size:
                10px;

            line-height:
                1.7;

            color:
                #8b94a3;

        }


        .footer-contact {

            margin-top:
                8px;

            font-size:
                10px;

            color:
                #667085;

        }


        .generated-note {

            margin-top:
                10px;

            font-size:
                8px;

            text-transform:
                uppercase;

            letter-spacing:
                1px;

            color:
                #b0b6c0;

        }


        /* =========================================================
           ACTIONS
        ========================================================= */

        .receipt-actions {

            display:
                flex;

            justify-content:
                flex-end;

            align-items:
                center;

            gap:
                9px;

            margin-top:
                16px;

        }


        .action-btn {

            appearance:
                none;

            border:
                1px solid #dfe4eb;

            background:
                #fff;

            color:
                #303a4c;

            border-radius:
                8px;

            padding:
                10px 17px;

            font-size:
                12px;

            font-weight:
                700;

            text-decoration:
                none;

            cursor:
                pointer;

            display:
                inline-flex;

            align-items:
                center;

            justify-content:
                center;

            gap:
                7px;

            transition:
                .2s ease;

        }


        .action-btn:hover {

            background:
                #f7f8fa;

            border-color:
                #cfd5de;

        }


        .action-btn.primary {

            background:
                #14213d;

            border-color:
                #14213d;

            color:
                #fff;

        }


        .action-btn.primary:hover {

            background:
                #20345d;

            border-color:
                #20345d;

        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @media (max-width: 700px) {

            body {
                padding: 15px 8px 30px;
            }


            .receipt-header {

                padding:
                    23px 20px;

                flex-direction:
                    column;

            }


            .receipt-heading {

                text-align:
                    left;

            }


            .receipt-body {

                padding:
                    24px 20px 28px;

            }


            .receipt-footer {

                padding:
                    20px;

            }


            .order-meta {

                grid-template-columns:
                    1fr;

            }


            .billing-box {

                grid-template-columns:
                    1fr 1fr;

            }


            .payment-grid {

                grid-template-columns:
                    1fr;

            }


            .receipt-watermark {

                width:
                    280px;

                height:
                    280px;

                right:
                    -100px;

            }

        }


        @media (max-width: 480px) {

            .company-name {
                font-size: 18px;
            }


            .company-logo {
                width: 52px;
                height: 52px;
            }


            .receipt-label {
                font-size: 23px;
            }


            .billing-box {

                grid-template-columns:
                    1fr;

                gap:
                    17px;

            }


            .items-table {

                min-width:
                    570px;

            }


            .items-table-wrapper {

                overflow-x:
                    auto;

            }


            .summary {

                width:
                    100%;

            }


            .receipt-actions {

                justify-content:
                    stretch;

            }


            .action-btn {

                flex:
                    1;

            }

        }


        /* =========================================================
           PRINT
        ========================================================= */

        @media print {

            @page {

                size:
                    A4;

                margin:
                    12mm;

            }


            html,
            body {

                background:
                    #fff !important;

            }


            body {

                padding:
                    0 !important;

                margin:
                    0 !important;

            }


            .receipt-page {

                max-width:
                    none;

                width:
                    100%;

            }


            .receipt {

                border:
                    none;

                border-radius:
                    0;

                box-shadow:
                    none;

                width:
                    100%;

            }


            .receipt-actions {

                display:
                    none !important;

            }


            .receipt-watermark,
            .receipt-watermark-two {

                -webkit-print-color-adjust:
                    exact;

                print-color-adjust:
                    exact;

            }


            .brand-strip {

                -webkit-print-color-adjust:
                    exact;

                print-color-adjust:
                    exact;

            }


            .status-badge,
            .summary-total,
            .item-icon,
            .items-table thead th,
            .receipt-footer {

                -webkit-print-color-adjust:
                    exact;

                print-color-adjust:
                    exact;

            }


            .receipt-header {

                padding-top:
                    20px;

            }


            .receipt-body {

                padding-top:
                    25px;

            }

        }

    </style>

</head>


<body>


<div class="receipt-page">


    <!-- =========================================================
         RECEIPT
    ========================================================== -->

    <div class="receipt">


        <!-- PREMIUM TOP STRIP -->

        <div class="brand-strip"></div>


        <!-- WATERMARK -->

        <div class="receipt-watermark"></div>

        <div class="receipt-watermark-two"></div>


        <div class="receipt-content">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <header class="receipt-header">


                <!-- COMPANY -->

                <div class="company">

                    <img
                        src="<%= logoPath %>"
                        alt="<%= companyName %>"
                        class="company-logo"
                    >


                    <div class="company-details">

                        <h1 class="company-name">

                            <%= companyName %>

                        </h1>


                        <p class="company-tagline">

                            Government Jobs • Results • Courses • Test Series

                        </p>


                        <% if (companyEmail || companyPhone) { %>

                            <p class="company-contact">

                                <% if (companyEmail) { %>
                                    <%= companyEmail %>
                                <% } %>

                                <% if (companyEmail && companyPhone) { %>
                                    &nbsp; • &nbsp;
                                <% } %>

                                <% if (companyPhone) { %>
                                    <%= companyPhone %>
                                <% } %>

                            </p>

                        <% } %>

                    </div>

                </div>


                <!-- RECEIPT TITLE -->

                <div class="receipt-heading">

                    <p class="receipt-label">
                        RECEIPT
                    </p>

                    <p class="receipt-sub-label">
                        Payment Confirmation
                    </p>


                    <span
                        class="status-badge <%= currentStatus.className %>"
                    >

                        <span class="status-icon">
                            <%= currentStatus.icon %>
                        </span>

                        <%= currentStatus.label %>

                    </span>

                </div>

            </header>


            <!-- =================================================
                 BODY
            ================================================== -->

            <main class="receipt-body">


                <!-- =================================================
                     ORDER INFORMATION
                ================================================== -->

                <div class="order-meta">


                    <div class="meta-item">

                        <span class="meta-label">
                            Order ID
                        </span>

                        <span class="meta-value">
                            <%= orderNumber %>
                        </span>

                    </div>


                    <div class="meta-item">

                        <span class="meta-label">
                            Receipt Date
                        </span>

                        <span class="meta-value">
                            <%= receiptDate(purchaseDate) %>
                        </span>

                    </div>


                    <div class="meta-item">

                        <span class="meta-label">
                            Payment Status
                        </span>

                        <span class="meta-value">

                            <%= currentStatus.shortLabel %>

                        </span>

                    </div>

                </div>


                <!-- =================================================
                     BILLING INFORMATION
                ================================================== -->

                <h2 class="section-title">
                    Customer &amp; Payment Details
                </h2>


                <div class="billing-box">


                    <!-- CUSTOMER -->

                    <div class="billing-column">

                        <div class="field-label">
                            Billed To
                        </div>


                        <div class="field-value">

                            <%= customer
                                ? customer.name
                                : 'Customer'
                            %>

                        </div>


                        <% if (customer && customer.email) { %>

                            <div class="field-value muted">

                                <%= customer.email %>

                            </div>

                        <% } %>

                    </div>


                    <!-- PAYMENT METHOD -->

                    <div class="billing-column">

                        <div class="field-label">
                            Payment Method
                        </div>

                        <div class="field-value">

                            <%= paymentMethod !== '—'
                                ? String(paymentMethod)
                                    .replace(/_/g, ' ')
                                    .replace(/\b\w/g, function(c) {
                                        return c.toUpperCase();
                                    })
                                : '—'
                            %>

                        </div>

                    </div>


                    <!-- TRANSACTION -->

                    <div class="billing-column">

                        <div class="field-label">
                            Transaction ID
                        </div>

                        <div class="field-value">

                            <%= transactionId %>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     PURCHASED ITEM
                ================================================== -->

                <section class="items-section">


                    <h2 class="section-title">
                        Purchase Details
                    </h2>


                    <div class="items-table-wrapper">

                        <table class="items-table">


                            <thead>

                                <tr>

                                    <th style="width: 52%;">
                                        Item Description
                                    </th>

                                    <th style="width: 18%;">
                                        Type
                                    </th>

                                    <th
                                        style="width: 30%; text-align:right;"
                                    >
                                        Amount
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <tr>


                                    <td>

                                        <div class="item-main">


                                            <div
                                                class="item-icon <%= itemType === 'Course' ? 'course' : 'series' %>"
                                            >

                                                <%= itemType === 'Course'
                                                    ? 'C'
                                                    : 'T'
                                                %>

                                            </div>


                                            <div>

                                                <div class="item-name">

                                                    <%= itemTitle %>

                                                </div>


                                                <div class="item-subtitle">

                                                    <%= itemType === 'Course'
                                                        ? 'Online Course'
                                                        : 'Online Test Series'
                                                    %>

                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <td>

                                        <strong>
                                            <%= itemType %>
                                        </strong>

                                    </td>


                                    <td class="amount">

                                        ₹<%= formatMoney(amount) %>

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </section>


                <!-- =================================================
                     AMOUNT SUMMARY
                ================================================== -->

                <div class="summary-wrapper">

                    <div class="summary">


                        <div class="summary-row">

                            <span>
                                Item Amount
                            </span>

                            <strong>
                                ₹<%= formatMoney(amount) %>
                            </strong>

                        </div>


                        <div class="summary-row">

                            <span>
                                Discount
                            </span>

                            <strong>
                                ₹0.00
                            </strong>

                        </div>


                        <div class="summary-row">

                            <span>
                                Tax / Additional Charges
                            </span>

                            <strong>
                                ₹0.00
                            </strong>

                        </div>


                        <div class="summary-divider"></div>


                        <div class="summary-total">

                            <span class="summary-total-label">

                                <%= paymentStatus === 'completed'
                                    ? 'Total Paid'
                                    : 'Total Amount'
                                %>

                            </span>


                            <span class="summary-total-value">

                                ₹<%= formatMoney(amount) %>

                            </span>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     PAYMENT INFORMATION
                ================================================== -->

                <div class="payment-information">


                    <h2 class="section-title">
                        Payment Information
                    </h2>


                    <div class="payment-grid">


                        <div class="payment-item">

                            <div class="field-label">
                                Payment Status
                            </div>

                            <div class="field-value">

                                <%= currentStatus.label %>

                            </div>

                        </div>


                        <div class="payment-item">

                            <div class="field-label">
                                Payment Date
                            </div>

                            <div class="field-value">

                                <%= receiptDateTime(purchaseDate) %>

                            </div>

                        </div>


                        <div class="payment-item">

                            <div class="field-label">
                                Transaction Reference
                            </div>

                            <div class="field-value">

                                <%= transactionId %>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     SUCCESS NOTE
                ================================================== -->

                <% if (paymentStatus === 'completed') { %>

                    <div class="success-note">

                        <strong>
                            Payment received successfully.
                        </strong>

                        Your purchase has been recorded successfully.
                        Please keep this receipt for your records.

                    </div>

                <% } else if (paymentStatus === 'pending') { %>

                    <div class="success-note">

                        <strong>
                            Payment is currently pending.
                        </strong>

                        This receipt confirms the order details.
                        The payment status may be updated after confirmation.

                    </div>

                <% } else if (paymentStatus === 'refunded') { %>

                    <div class="success-note">

                        <strong>
                            This payment has been refunded.
                        </strong>

                        Please retain this receipt as a record of the original
                        transaction and refund status.

                    </div>

                <% } else { %>

                    <div class="success-note">

                        <strong>
                            Payment was not completed.
                        </strong>

                        Please refer to your account or contact support if
                        you believe this status is incorrect.

                    </div>

                <% } %>


            </main>


            <!-- =====================================================
                 FOOTER
            ====================================================== -->

            <footer class="receipt-footer">


                <p class="footer-title">

                    Thank you for choosing
                    <%= companyName %>

                </p>


                <p class="footer-text">

                    This receipt is generated electronically and is valid
                    without a physical signature. Please retain this document
                    as proof of your transaction.

                </p>


                <% if (companyEmail || companyPhone || companyAddress) { %>

                    <div class="footer-contact">

                        <% if (companyEmail) { %>

                            Email:
                            <%= companyEmail %>

                        <% } %>


                        <% if (companyEmail && companyPhone) { %>

                            &nbsp; • &nbsp;

                        <% } %>


                        <% if (companyPhone) { %>

                            Phone:
                            <%= companyPhone %>

                        <% } %>


                        <% if (
                            (companyEmail || companyPhone) &&
                            companyAddress
                        ) { %>

                            &nbsp; • &nbsp;

                        <% } %>


                        <% if (companyAddress) { %>

                            <%= companyAddress %>

                        <% } %>

                    </div>

                <% } %>


                <div class="generated-note">

                    Computer Generated Receipt

                </div>

            </footer>


        </div>

    </div>


    <!-- =========================================================
         ACTION BUTTONS
    ========================================================== -->

    <div class="receipt-actions">


        <button
            type="button"
            class="action-btn"
            onclick="window.close();"
        >

            ← Close

        </button>


        <button
            type="button"
            class="action-btn primary"
            onclick="window.print();"
        >

            Print / Save PDF

        </button>

    </div>


</div>


</body>

</html>