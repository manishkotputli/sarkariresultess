<%- include('../../adminlayout/header') %>

<style>
    /*
    |--------------------------------------------------------------------------
    | CKEDITOR
    |--------------------------------------------------------------------------
    */

    .ck-editor__editable_inline {
        min-height: 450px;
    }

    .ck-content {
        min-height: 450px;
    }

    /*
    |--------------------------------------------------------------------------
    | Selected Image Visual Feedback
    |--------------------------------------------------------------------------
    */

    .ck-content .ck-widget.ck-widget_selected {
        outline: 3px solid #0d6efd !important;
        outline-offset: 2px;
    }

    /*
    |--------------------------------------------------------------------------
    | Image Width Classes
    |--------------------------------------------------------------------------
    */

    .ck-content figure.image {
        transition: width 0.2s ease-in-out;
        margin: 1rem auto;
    }

    .ck-content figure.image.img-25 {
        width: 25% !important;
    }

    .ck-content figure.image.img-50 {
        width: 50% !important;
    }

    .ck-content figure.image.img-75 {
        width: 75% !important;
    }

    .ck-content figure.image.img-100 {
        width: 100% !important;
    }

    .ck-content figure.image img {
        width: 100% !important;
        height: auto !important;
    }

    /*
    |--------------------------------------------------------------------------
    | CKEditor Content
    |--------------------------------------------------------------------------
    */

    .ck-editor__editable {
        min-height: 450px;
    }

    .ck-editor__editable_inline {
        padding: 20px !important;
    }

    /*
    |--------------------------------------------------------------------------
    | Editor Error State
    |--------------------------------------------------------------------------
    */

    .ckeditor-error {
        display: none;
        margin-top: 8px;
        color: #dc3545;
        font-size: 13px;
    }
</style>


<!-- =========================================================
     PAGE WRAPPER
========================================================= -->

<div class="page-wrapper">

    <div class="content pb-0">


        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">

            <div>

                <h4 class="mb-1">
                    <%= mode === 'edit' ? 'Edit Post' : 'Add Post' %>
                </h4>

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb mb-0 p-0">

                        <li class="breadcrumb-item">

                            <a href="/admin">
                                Home
                            </a>

                        </li>

                        <li class="breadcrumb-item">

                            <a href="/admin/posts">
                                Posts
                            </a>

                        </li>

                        <li class="breadcrumb-item active"
                            aria-current="page">

                            <%= mode === 'edit' ? 'Edit' : 'Add' %>

                        </li>

                    </ol>

                </nav>

            </div>


            <div>

                <a href="/admin/posts"
                   class="btn btn-outline-light">

                    <i class="ti ti-arrow-left me-1"></i>

                    Back to Posts

                </a>

            </div>

        </div>


        <!-- =====================================================
             ALERTS
        ====================================================== -->

        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>

            <div class="alert alert-danger alert-dismissible fade show mb-4">

                <ul class="mb-0">

                    <% errors.forEach(function(error) { %>

                        <li>
                            <%= error %>
                        </li>

                    <% }) %>

                </ul>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>

        <% } %>


        <% if (typeof success !== 'undefined' && success) { %>

            <div class="alert alert-success alert-dismissible fade show mb-4">

                <%= success %>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>

        <% } %>


        <!-- =====================================================
             POST FORM
        ====================================================== -->

        <form method="POST"
              action="<%= formAction %>"
              enctype="multipart/form-data"
              id="postForm">


            <div class="row">


                <!-- =================================================
                     LEFT COLUMN
                ================================================== -->

                <div class="col-xl-8">


                    <!-- =================================================
                         BASIC INFORMATION
                    ================================================== -->

                    <div class="card border-0 rounded-0 mb-4">

                        <div class="card-header">

                            <h5 class="card-title mb-0">
                                Basic Information
                            </h5>

                        </div>


                        <div class="card-body">


                            <!-- TITLE -->

                            <div class="mb-4">

                                <label class="form-label">

                                    Post Title

                                    <span class="text-danger">
                                        *
                                    </span>

                                </label>

                                <input type="text"
                                       name="title"
                                       required
                                       value="<%= post ? post.title : '' %>"
                                       placeholder="e.g. SSC CGL 2026 Notification Out"
                                       class="form-control">

                            </div>


                            <!-- CATEGORY + SLUG -->

                            <div class="row">


                                <!-- CATEGORY -->

                                <div class="col-md-6 mb-4">

                                    <label class="form-label">

                                        Category

                                        <span class="text-danger">
                                            *
                                        </span>

                                    </label>

                                    <select name="category_id"
                                            required
                                            class="form-select">

                                        <option value="">
                                            Select Category
                                        </option>


                                        <% if (categories && categories.length) { %>

                                            <% categories.forEach(function(cat) { %>

                                                <option
                                                    value="<%= cat.id %>"
                                                    <%= post && Number(post.category_id) === Number(cat.id) ? 'selected' : '' %>>

                                                    <%= cat.name %>

                                                </option>

                                            <% }) %>

                                        <% } %>

                                    </select>

                                </div>


                                <!-- SLUG -->

                                <div class="col-md-6 mb-4">

                                    <label class="form-label">

                                        Slug

                                        <span class="text-muted">
                                            (leave blank to auto-generate)
                                        </span>

                                    </label>

                                    <input type="text"
                                           name="slug"
                                           value="<%= post ? (post.slug || '') : '' %>"
                                           placeholder="auto-generated-from-title"
                                           class="form-control">

                                </div>

                            </div>


                            <!-- SHORT DESCRIPTION -->

                            <div class="mb-4">

                                <label class="form-label">

                                    Short Description

                                </label>

                                <textarea name="short_description"
                                          rows="3"
                                          placeholder="One-line summary shown in listings"
                                          class="form-control"><%= post ? (post.short_description || '') : '' %></textarea>

                            </div>


                            <!-- =================================================
                                 FULL DESCRIPTION / CKEDITOR
                            ================================================== -->

                            <div class="mb-4">


                                <div class="d-flex align-items-center justify-content-between mb-2">

                                    <label class="form-label mb-0">

                                        Full Description

                                    </label>


                                    <span class="badge bg-light text-dark border">

                                        <i class="ti ti-edit me-1"></i>

                                        Rich Text Editor

                                    </span>

                                </div>


                                <!-- CKEDITOR TEXTAREA -->

                                <textarea
                                    name="full_description"
                                    id="editor"
                                    class="form-control"
                                    rows="15"><%= post ? (post.full_description || '') : '' %></textarea>


                                <div id="ckeditorError"
                                     class="ckeditor-error">

                                    Editor could not be loaded. Please refresh the page.

                                </div>


                            </div>


                        </div>

                    </div>



                    <!-- =================================================
                         IMPORTANT LINKS
                    ================================================== -->

                    <div class="card border-0 rounded-0 mb-4">

                        <div class="card-header d-flex align-items-center justify-content-between">

                            <div>

                                <h5 class="card-title mb-1">
                                    Important Links
                                </h5>

                                <p class="text-muted mb-0">
                                    e.g. Apply Online, Download Notification, Official Website
                                </p>

                            </div>


                            <button type="button"
                                    id="addLinkRowBtn"
                                    class="btn btn-outline-light">

                                <i class="ti ti-plus me-1"></i>

                                Add Link

                            </button>

                        </div>


                        <div class="card-body">


                            <div class="table-responsive">

                                <table class="table table-nowrap"
                                       id="linksTable">

                                    <thead>

                                        <tr>

                                            <th>
                                                Label
                                            </th>

                                            <th>
                                                URL
                                            </th>

                                            <th class="text-end">
                                                Action
                                            </th>

                                        </tr>

                                    </thead>


                                    <tbody id="linksTableBody">


                                        <% if (post && post.links && post.links.length) { %>

                                            <% post.links.forEach(function(link) { %>

                                                <tr>

                                                    <td>

                                                        <input type="text"
                                                               name="links_label[]"
                                                               value="<%= link.label || '' %>"
                                                               placeholder="e.g. Apply Online"
                                                               class="form-control">

                                                    </td>


                                                    <td>

                                                        <input type="url"
                                                               name="links_url[]"
                                                               value="<%= link.url || '' %>"
                                                               placeholder="https://..."
                                                               class="form-control">

                                                    </td>


                                                    <td class="text-end">

                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger removeRowBtn">

                                                            <i class="ti ti-trash"></i>

                                                        </button>

                                                    </td>

                                                </tr>

                                            <% }) %>

                                        <% } %>


                                    </tbody>

                                </table>


                                <p class="text-muted mb-0"
                                   id="noLinksMsg"
                                   style="<%= (post && post.links && post.links.length) ? 'display:none;' : '' %>">

                                    No links added yet.

                                </p>

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         DYNAMIC FIELDS
                    ================================================== -->

                    <div class="card border-0 rounded-0 mb-4">

                        <div class="card-header d-flex align-items-center justify-content-between">

                            <div>

                                <h5 class="card-title mb-1">
                                    Dynamic Fields
                                </h5>

                                <p class="text-muted mb-0">

                                    Custom fields grouped into sections e.g.
                                    Important Dates, Application Fee, Age Limit

                                </p>

                            </div>


                            <button type="button"
                                    data-hs-overlay="#addFieldModal"
                                    class="btn btn-primary">

                                <i class="ti ti-plus me-1"></i>

                                Add Field

                            </button>

                        </div>


                        <div class="card-body">


                            <div class="table-responsive">

                                <table class="table table-nowrap"
                                       id="fieldsTable">

                                    <thead>

                                        <tr>

                                            <th>
                                                Group
                                            </th>

                                            <th>
                                                Label
                                            </th>

                                            <th>
                                                Type
                                            </th>

                                            <th>
                                                Value
                                            </th>

                                            <th class="text-end">
                                                Action
                                            </th>

                                        </tr>

                                    </thead>


                                    <tbody id="fieldsTableBody">


                                        <% if (typeof fieldGroups !== 'undefined' && fieldGroups && fieldGroups.length) { %>


                                            <% fieldGroups.forEach(function(group) { %>


                                                <% group.fields.forEach(function(f) { %>

                                                    <tr>


                                                        <td>

                                                            <input type="text"
                                                                   name="fields_group[]"
                                                                   value="<%= f.group_name || '' %>"
                                                                   class="form-control">

                                                        </td>


                                                        <td>

                                                            <input type="text"
                                                                   name="fields_label[]"
                                                                   value="<%= f.field_label || '' %>"
                                                                   class="form-control">

                                                        </td>


                                                        <td>

                                                            <select name="fields_type[]"
                                                                    class="form-select">

                                                                <% ['text','number','date','textarea','richtext','url'].forEach(function(t) { %>

                                                                    <option value="<%= t %>"
                                                                        <%= f.field_type === t ? 'selected' : '' %>>

                                                                        <%= t %>

                                                                    </option>

                                                                <% }) %>

                                                            </select>

                                                        </td>


                                                        <td>

                                                            <input type="text"
                                                                   name="fields_value[]"
                                                                   value="<%= f.field_value || '' %>"
                                                                   class="form-control">

                                                        </td>


                                                        <td class="text-end">

                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-danger removeRowBtn">

                                                                <i class="ti ti-trash"></i>

                                                            </button>

                                                        </td>


                                                    </tr>

                                                <% }) %>


                                            <% }) %>


                                        <% } %>


                                    </tbody>

                                </table>


                                <p class="text-muted mb-0"
                                   id="noFieldsMsg"
                                   style="<%= (typeof fieldGroups !== 'undefined' && fieldGroups && fieldGroups.length) ? 'display:none;' : '' %>">

                                    No dynamic fields added yet.
                                    Click "Add Field" to create one.

                                </p>

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         SEO
                    ================================================== -->

                    <div class="card border-0 rounded-0 mb-4">

                        <div class="card-header">

                            <h5 class="card-title mb-0">
                                SEO Meta
                            </h5>

                        </div>


                        <div class="card-body">


                            <!-- META TITLE -->

                            <div class="mb-4">

                                <label class="form-label">
                                    Meta Title
                                </label>

                                <input type="text"
                                       name="meta_title"
                                       value="<%= post ? (post.meta_title || '') : '' %>"
                                       class="form-control">

                            </div>


                            <!-- META KEYWORDS -->

                            <div class="mb-4">

                                <label class="form-label">
                                    Meta Keywords
                                </label>

                                <input type="text"
                                       name="meta_keywords"
                                       value="<%= post ? (post.meta_keywords || '') : '' %>"
                                       placeholder="comma, separated, keywords"
                                       class="form-control">

                            </div>


                            <!-- META DESCRIPTION -->

                            <div>

                                <label class="form-label">
                                    Meta Description
                                </label>

                                <textarea name="meta_description"
                                          rows="3"
                                          class="form-control"><%= post ? (post.meta_description || '') : '' %></textarea>

                            </div>


                        </div>

                    </div>


                </div>



                <!-- =================================================
                     RIGHT COLUMN
                ================================================== -->

                <div class="col-xl-4">


                    <!-- =================================================
                         PUBLISH
                    ================================================== -->

                    <div class="card border-0 rounded-0 mb-4">

                        <div class="card-header">

                            <h5 class="card-title mb-0">
                                Publish
                            </h5>

                        </div>


                        <div class="card-body">


                            <!-- POST DATE -->

                            <div class="mb-4">

                                <label class="form-label">
                                    Post Date
                                </label>

                                <input type="date"
                                       name="post_date"
                                       value="<%= post && post.post_date ? post.post_date : '' %>"
                                       class="form-control">

                            </div>


                            <!-- UPDATED DATE -->

                            <div class="mb-4">

                                <label class="form-label">
                                    Updated Date
                                </label>

                                <input type="date"
                                       name="updated_date"
                                       value="<%= post && post.updated_date ? post.updated_date : '' %>"
                                       class="form-control">

                            </div>


                            <!-- STATUS -->

                            <div class="d-flex align-items-center justify-content-between mb-3 pt-3 border-top">

                                <label for="statusCheck"
                                       class="form-label mb-0">

                                    Published (Active)

                                </label>


                                <div class="form-check form-switch">

                                    <input type="checkbox"
                                           id="statusCheck"
                                           name="status"
                                           value="true"
                                           <%= (!post || post.status) ? 'checked' : '' %>
                                           class="form-check-input">

                                </div>

                            </div>


                            <!-- MARQUEE -->

                            <div class="d-flex align-items-center justify-content-between mb-3">

                                <label for="marqueeCheck"
                                       class="form-label mb-0">

                                    Show in Marquee

                                </label>


                                <div class="form-check form-switch">

                                    <input type="checkbox"
                                           id="marqueeCheck"
                                           name="is_marquee"
                                           value="true"
                                           <%= post && post.is_marquee ? 'checked' : '' %>
                                           class="form-check-input">

                                </div>

                            </div>


                            <!-- TOP BOX -->

                            <div class="d-flex align-items-center justify-content-between mb-4">

                                <label for="topCheck"
                                       class="form-label mb-0">

                                    Show in Top Box

                                </label>


                                <div class="form-check form-switch">

                                    <input type="checkbox"
                                           id="topCheck"
                                           name="is_top"
                                           value="true"
                                           <%= post && post.is_top ? 'checked' : '' %>
                                           class="form-check-input">

                                </div>

                            </div>


                            <!-- HIGHLIGHT COLOR -->

                            <div class="mb-4">

                                <label class="form-label">

                                    Highlight Colour

                                </label>

                                <input type="text"
                                       name="highlight_color"
                                       value="<%= post ? (post.highlight_color || '') : '' %>"
                                       placeholder="e.g. #ff0000 or red"
                                       class="form-control">

                            </div>


                            <!-- SUBMIT -->

                            <button type="submit"
                                    class="btn btn-primary w-100">

                                <i class="ti ti-device-floppy me-1"></i>

                                <%= mode === 'edit' ? 'Update Post' : 'Save Post' %>

                            </button>


                        </div>

                    </div>



                    <!-- =================================================
                         RECORD INFO
                    ================================================== -->

                    <% if (mode === 'edit' && post) { %>

                        <div class="card border-0 rounded-0 mb-4">

                            <div class="card-header">

                                <h5 class="card-title mb-0">
                                    Record Info
                                </h5>

                            </div>


                            <div class="card-body">

                                <div class="text-muted">

                                    <p class="mb-2">

                                        Created:

                                        <%= typeof formatDate !== 'undefined'
                                            ? formatDate(post.created_at)
                                            : post.created_at %>

                                    </p>


                                    <p class="mb-2">

                                        Last Updated:

                                        <%= typeof formatDate !== 'undefined'
                                            ? formatDate(post.updated_at)
                                            : post.updated_at %>

                                    </p>


                                    <p class="mb-0">

                                        Views:
                                        <%= post.views_count || 0 %>

                                        &middot;

                                        Clicks:
                                        <%= post.clicks_count || 0 %>

                                    </p>

                                </div>

                            </div>

                        </div>

                    <% } %>


                </div>

            </div>


        </form>


    </div>

</div>



<!-- =========================================================
     ADD FIELD MODAL
========================================================= -->

<div id="addFieldModal"
     class="hs-overlay hidden w-full h-full fixed top-0 start-0 z-[80] bg-gray-900/50 overflow-x-hidden overflow-y-auto">


    <div>

        <div class="p-3 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full sm:mx-auto min-h-screen flex items-center justify-center">


            <div class="bg-white border border-border-color rounded-lg shadow-sm w-full focus:outline-none">


                <!-- HEADER -->

                <div class="flex items-center justify-between p-4 border-b border-border-color">

                    <h3 class="text-lg font-bold text-gray-900">

                        Add Dynamic Field

                    </h3>


                    <button type="button"
                            class="size-8 inline-flex justify-center items-center gap-x-2 rounded-full border border-transparent bg-gray-100 text-gray-800 hover:bg-gray-200"
                            aria-label="Close"
                            data-hs-overlay="#addFieldModal">

                        <i class="icon-x"></i>

                    </button>

                </div>


                <!-- BODY -->

                <div class="p-4">


                    <!-- GROUP -->

                    <div class="mb-4">

                        <label class="block text-sm font-medium text-gray-900 mb-2">

                            Group Name

                        </label>


                        <input type="text"
                               id="modalFieldGroup"
                               placeholder="e.g. Important Dates"
                               list="fieldGroupSuggestions"
                               class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3">


                        <datalist id="fieldGroupSuggestions">

                            <option value="Important Dates">
                            <option value="Application Fee">
                            <option value="Age Limit">
                            <option value="Vacancy Details">
                            <option value="Details">

                        </datalist>

                    </div>


                    <!-- LABEL -->

                    <div class="mb-4">

                        <label class="block text-sm font-medium text-gray-900 mb-2">

                            Field Label

                            <span class="text-danger">
                                *
                            </span>

                        </label>


                        <input type="text"
                               id="modalFieldLabel"
                               placeholder="e.g. Last Date to Apply"
                               class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3">

                    </div>


                    <!-- TYPE -->

                    <div class="mb-4">

                        <label class="block text-sm font-medium text-gray-900 mb-2">

                            Field Type

                        </label>


                        <select id="modalFieldType"
                                class="form-select w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3">

                            <option value="text">
                                Text
                            </option>

                            <option value="number">
                                Number
                            </option>

                            <option value="date">
                                Date
                            </option>

                            <option value="textarea">
                                Textarea
                            </option>

                            <option value="richtext">
                                Rich Text
                            </option>

                            <option value="url">
                                URL
                            </option>

                        </select>

                    </div>


                    <!-- VALUE -->

                    <div>

                        <label class="block text-sm font-medium text-gray-900 mb-2">

                            Field Value

                        </label>


                        <input type="text"
                               id="modalFieldValue"
                               placeholder="e.g. 30 Sept 2026"
                               class="form-input w-full bg-white border border-border-color text-sm text-gray-900 rounded-lg py-2 px-3">

                    </div>


                </div>


                <!-- FOOTER -->

                <div class="flex justify-end gap-2 p-4 border-t border-border-color">

                    <button type="button"
                            class="py-2 px-4 text-sm font-medium text-gray-900 bg-white border border-border-color rounded-lg hover:bg-gray-50"
                            data-hs-overlay="#addFieldModal">

                        Cancel

                    </button>


                    <button type="button"
                            id="modalAddFieldBtn"
                            class="py-2 px-4 text-sm font-medium text-white bg-primary rounded-lg">

                        Add Field

                    </button>

                </div>


            </div>

        </div>

    </div>

</div>



<!-- =========================================================
     CKEDITOR 5
========================================================= -->

<script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>


<script>

/*
|--------------------------------------------------------------------------
| CKEDITOR CUSTOM UPLOAD ADAPTER
|--------------------------------------------------------------------------
*/

function CustomUploadAdapterPlugin(editor) {

    editor.plugins.get('FileRepository').createUploadAdapter = (loader) => {

        return {

            upload() {

                return loader.file.then(file => {

                    return new Promise((resolve, reject) => {


                        const data =
                            new FormData();


                        data.append(
                            'upload',
                            file
                        );


                        /*
                        |--------------------------------------------------------------------------
                        | CSRF
                        |--------------------------------------------------------------------------
                        */

                        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>

                            data.append(
                                '_csrf',
                                '<%= csrfToken %>'
                            );

                        <% } %>


                        /*
                        |--------------------------------------------------------------------------
                        | POST IMAGE UPLOAD
                        |--------------------------------------------------------------------------
                        */

                        fetch(
                            '/admin/posts/upload-image',
                            {
                                method: 'POST',
                                body: data
                            }
                        )

                        .then(response => {

                            if (!response.ok) {

                                throw new Error(
                                    'Image upload failed'
                                );

                            }

                            return response.json();

                        })

                        .then(result => {


                            if (result.url) {

                                resolve({
                                    default: result.url
                                });

                            }

                            else if (
                                result.default
                            ) {

                                resolve({
                                    default: result.default
                                });

                            }

                            else {

                                reject(
                                    result.error
                                    ? (
                                        result.error.message
                                        || result.error
                                    )
                                    : 'Image upload failed'
                                );

                            }

                        })

                        .catch(error => {

                            console.error(
                                'CKEditor Upload Error:',
                                error
                            );

                            reject(error);

                        });


                    });

                });

            },


            abort() {

                /*
                |--------------------------------------------------------------------------
                | Optional abort handler
                |--------------------------------------------------------------------------
                */

            }

        };

    };

}



/*
|--------------------------------------------------------------------------
| INITIALIZE CKEDITOR
|--------------------------------------------------------------------------
*/

let postEditor = null;


const editorElement =
    document.querySelector('#editor');


if (editorElement) {


    ClassicEditor
        .create(
            editorElement,
            {

                /*
                |--------------------------------------------------------------------------
                | CUSTOM IMAGE UPLOAD
                |--------------------------------------------------------------------------
                */

                extraPlugins: [
                    CustomUploadAdapterPlugin
                ],


                /*
                |--------------------------------------------------------------------------
                | TOOLBAR
                |--------------------------------------------------------------------------
                */

                toolbar: {

                    items: [

                        'heading',

                        '|',

                        'bold',
                        'italic',
                        'underline',
                        'strikethrough',

                        '|',

                        'link',

                        'bulletedList',
                        'numberedList',

                        '|',

                        'uploadImage',

                        'insertTable',

                        'blockQuote',

                        '|',

                        'undo',
                        'redo'

                    ]

                },


                /*
                |--------------------------------------------------------------------------
                | IMAGE TOOLBAR
                |--------------------------------------------------------------------------
                */

                image: {

                    toolbar: [

                        'imageStyle:inline',
                        'imageStyle:block',
                        'imageStyle:side',

                        '|',

                        'toggleImageCaption',

                        'imageTextAlternative'

                    ]

                },


                /*
                |--------------------------------------------------------------------------
                | LINK
                |--------------------------------------------------------------------------
                */

                link: {

                    addTargetToExternalLinks: true,

                    defaultProtocol: 'https://'

                }


            }
        )


        .then(editor => {


            postEditor =
                editor;


            console.log(
                'CKEditor initialized successfully'
            );


            /*
            |--------------------------------------------------------------------------
            | Image selection feedback
            |--------------------------------------------------------------------------
            */

            editor.model.document.on(
                'change:data',
                function () {

                    /*
                    | CKEditor automatically updates
                    | the original textarea.
                    */

                }
            );


        })


        .catch(error => {


            console.error(
                'CKEditor initialization error:',
                error
            );


            const errorElement =
                document.getElementById(
                    'ckeditorError'
                );


            if (errorElement) {

                errorElement.style.display =
                    'block';

            }

        });

}



/*
|--------------------------------------------------------------------------
| FORM SUBMIT
|--------------------------------------------------------------------------
*/

const postForm =
    document.getElementById(
        'postForm'
    );


if (postForm) {


    postForm.addEventListener(
        'submit',
        function () {


            /*
            |--------------------------------------------------------------------------
            | Force CKEditor data into textarea
            |--------------------------------------------------------------------------
            */

            if (postEditor) {

                editorElement.value =
                    postEditor.getData();

            }


        }
    );

}

</script>



<!-- =========================================================
     LINKS + DYNAMIC FIELDS JAVASCRIPT
========================================================= -->

<script>

(function () {


    /*
    |--------------------------------------------------------------------------
    | ADD LINK ROW
    |--------------------------------------------------------------------------
    */

    function addLinkRow() {


        const tbody =
            document.getElementById(
                'linksTableBody'
            );


        if (!tbody) {
            return;
        }


        const tr =
            document.createElement(
                'tr'
            );


        tr.innerHTML = `

            <td>

                <input
                    type="text"
                    name="links_label[]"
                    placeholder="e.g. Apply Online"
                    class="form-control">

            </td>


            <td>

                <input
                    type="url"
                    name="links_url[]"
                    placeholder="https://..."
                    class="form-control">

            </td>


            <td class="text-end">

                <button
                    type="button"
                    class="btn btn-sm btn-outline-danger removeRowBtn">

                    <i class="ti ti-trash"></i>

                </button>

            </td>

        `;


        tbody.appendChild(tr);


        const noLinksMsg =
            document.getElementById(
                'noLinksMsg'
            );


        if (noLinksMsg) {

            noLinksMsg.style.display =
                'none';

        }


        const labelInput =
            tr.querySelector(
                'input[name="links_label[]"]'
            );


        if (labelInput) {

            labelInput.focus();

        }

    }



    /*
    |--------------------------------------------------------------------------
    | ADD DYNAMIC FIELD
    |--------------------------------------------------------------------------
    */

    function addFieldRow() {


        const groupEl =
            document.getElementById(
                'modalFieldGroup'
            );


        const labelEl =
            document.getElementById(
                'modalFieldLabel'
            );


        const typeEl =
            document.getElementById(
                'modalFieldType'
            );


        const valueEl =
            document.getElementById(
                'modalFieldValue'
            );


        const tbody =
            document.getElementById(
                'fieldsTableBody'
            );


        if (!tbody || !labelEl) {

            return;

        }


        const label =
            labelEl.value.trim();


        if (!label) {

            alert(
                'Field Label is required.'
            );

            labelEl.focus();

            return;

        }


        const group =
            groupEl &&
            groupEl.value.trim()
                ? groupEl.value.trim()
                : 'Details';


        const type =
            typeEl
                ? typeEl.value
                : 'text';


        const value =
            valueEl
                ? valueEl.value.trim()
                : '';


        const tr =
            document.createElement(
                'tr'
            );


        tr.innerHTML = `

            <td>

                <input
                    type="text"
                    name="fields_group[]"
                    value="${escapeHtml(group)}"
                    class="form-control">

            </td>


            <td>

                <input
                    type="text"
                    name="fields_label[]"
                    value="${escapeHtml(label)}"
                    class="form-control">

            </td>


            <td>

                <select
                    name="fields_type[]"
                    class="form-select">

                    <option
                        value="text"
                        ${type === 'text' ? 'selected' : ''}>

                        Text

                    </option>

                    <option
                        value="number"
                        ${type === 'number' ? 'selected' : ''}>

                        Number

                    </option>

                    <option
                        value="date"
                        ${type === 'date' ? 'selected' : ''}>

                        Date

                    </option>

                    <option
                        value="textarea"
                        ${type === 'textarea' ? 'selected' : ''}>

                        Textarea

                    </option>

                    <option
                        value="richtext"
                        ${type === 'richtext' ? 'selected' : ''}>

                        Rich Text

                    </option>

                    <option
                        value="url"
                        ${type === 'url' ? 'selected' : ''}>

                        URL

                    </option>

                </select>

            </td>


            <td>

                <input
                    type="text"
                    name="fields_value[]"
                    value="${escapeHtml(value)}"
                    class="form-control">

            </td>


            <td class="text-end">

                <button
                    type="button"
                    class="btn btn-sm btn-outline-danger removeRowBtn">

                    <i class="ti ti-trash"></i>

                </button>

            </td>

        `;


        tbody.appendChild(tr);


        const noFieldsMsg =
            document.getElementById(
                'noFieldsMsg'
            );


        if (noFieldsMsg) {

            noFieldsMsg.style.display =
                'none';

        }


        /*
        |--------------------------------------------------------------------------
        | RESET MODAL
        |--------------------------------------------------------------------------
        */

        if (groupEl) {

            groupEl.value = '';

        }


        labelEl.value = '';


        if (valueEl) {

            valueEl.value = '';

        }


        if (typeEl) {

            typeEl.value = 'text';

        }


        /*
        |--------------------------------------------------------------------------
        | CLOSE HS OVERLAY
        |--------------------------------------------------------------------------
        */

        const modalEl =
            document.getElementById(
                'addFieldModal'
            );


        if (
            window.HSOverlay &&
            modalEl
        ) {

            try {

                window.HSOverlay.close(
                    modalEl
                );

            }

            catch (error) {

                modalEl.classList.add(
                    'hidden'
                );

            }

        }

        else if (modalEl) {

            modalEl.classList.add(
                'hidden'
            );

        }

    }



    /*
    |--------------------------------------------------------------------------
    | ESCAPE HTML
    |--------------------------------------------------------------------------
    */

    function escapeHtml(value) {

        return String(value)

            .replace(
                /&/g,
                '&amp;'
            )

            .replace(
                /</g,
                '&lt;'
            )

            .replace(
                />/g,
                '&gt;'
            )

            .replace(
                /"/g,
                '&quot;'
            )

            .replace(
                /'/g,
                '&#039;'
            );

    }



    /*
    |--------------------------------------------------------------------------
    | EVENT DELEGATION
    |--------------------------------------------------------------------------
    */

    document.addEventListener(
        'click',
        function (e) {


            /*
            |--------------------------------------------------------------------------
            | ADD LINK
            |--------------------------------------------------------------------------
            */

            if (
                e.target.closest(
                    '#addLinkRowBtn'
                )
            ) {

                e.preventDefault();

                addLinkRow();

                return;

            }


            /*
            |--------------------------------------------------------------------------
            | ADD FIELD
            |--------------------------------------------------------------------------
            */

            if (
                e.target.closest(
                    '#modalAddFieldBtn'
                )
            ) {

                e.preventDefault();

                addFieldRow();

                return;

            }


            /*
            |--------------------------------------------------------------------------
            | REMOVE ROW
            |--------------------------------------------------------------------------
            */

            const removeBtn =
                e.target.closest(
                    '.removeRowBtn'
                );


            if (!removeBtn) {

                return;

            }


            e.preventDefault();


            const row =
                removeBtn.closest(
                    'tr'
                );


            if (!row) {

                return;

            }


            const tbody =
                row.parentElement;


            row.remove();


            /*
            |--------------------------------------------------------------------------
            | LINKS MESSAGE
            |--------------------------------------------------------------------------
            */

            if (
                tbody &&
                tbody.id ===
                    'linksTableBody'
            ) {

                const msg =
                    document.getElementById(
                        'noLinksMsg'
                    );


                if (msg) {

                    msg.style.display =
                        tbody.children.length > 0
                            ? 'none'
                            : '';

                }

            }


            /*
            |--------------------------------------------------------------------------
            | FIELDS MESSAGE
            |--------------------------------------------------------------------------
            */

            if (
                tbody &&
                tbody.id ===
                    'fieldsTableBody'
            ) {

                const msg =
                    document.getElementById(
                        'noFieldsMsg'
                    );


                if (msg) {

                    msg.style.display =
                        tbody.children.length > 0
                            ? 'none'
                            : '';

                }

            }

        }
    );


})();

</script>


