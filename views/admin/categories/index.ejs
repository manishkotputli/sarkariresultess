<%- include('../../adminlayout/header') %>

<div class="page-wrapper">

    <!-- Start Content -->
    <div class="content pb-0">

        <!-- =====================================================
             ALERTS
        ====================================================== -->

        <% if (typeof success !== 'undefined' && success) { %>

            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">

                <%= success %>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>

        <% } %>


        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>

            <div class="alert alert-danger alert-dismissible fade show mb-4"
                 role="alert">

                <ul class="mb-0">

                    <% errors.forEach(function(error) { %>

                        <li>
                            <%= error %>
                        </li>

                    <% }) %>

                </ul>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>

        <% } %>


        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">

            <div>

                <h4 class="mb-1">
                    Categories
                </h4>

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb mb-0 p-0">

                        <li class="breadcrumb-item">

                            <a href="/admin">
                                Home
                            </a>

                        </li>

                        <li class="breadcrumb-item active"
                            aria-current="page">

                            Categories

                        </li>

                    </ol>

                </nav>

            </div>


            <div class="gap-2 d-flex align-items-center flex-wrap">

                <!-- Export -->
                <div class="dropdown">

                    <a href="javascript:void(0);"
                       class="dropdown-toggle btn btn-outline-light px-2 shadow"
                       data-bs-toggle="dropdown">

                        <i class="ti ti-package-export me-2"></i>
                        Export

                    </a>


                    <div class="dropdown-menu dropdown-menu-end">

                        <ul>

                            <li>

                                <a href="/admin/categories/export/pdf"
                                   class="dropdown-item">

                                    <i class="ti ti-file-type-pdf me-1"></i>
                                    Export as PDF

                                </a>

                            </li>


                            <li>

                                <a href="/admin/categories/export/excel"
                                   class="dropdown-item">

                                    <i class="ti ti-file-type-xls me-1"></i>
                                    Export as Excel

                                </a>

                            </li>

                        </ul>

                    </div>

                </div>


                <!-- Refresh -->
                <a href="javascript:location.reload();"
                   class="btn btn-icon btn-outline-light shadow"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   aria-label="Refresh"
                   data-bs-original-title="Refresh">

                    <i class="ti ti-refresh"></i>

                </a>


                <!-- Collapse -->
                <a href="javascript:void(0);"
                   class="btn btn-icon btn-outline-light shadow"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   aria-label="Collapse"
                   data-bs-original-title="Collapse"
                   id="collapse-header">

                    <i class="ti ti-transition-top"></i>

                </a>

            </div>

        </div>


        <!-- =====================================================
             CATEGORIES CARD
        ====================================================== -->

        <div class="card border-0 rounded-0">


            <!-- =================================================
                 CARD HEADER
            ================================================== -->

            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">


                <!-- Search -->
                <form method="GET"
                      action="/admin/categories"
                      class="mb-0">

                    <div class="input-icon input-icon-start position-relative">

                        <span class="input-icon-addon text-dark">

                            <i class="ti ti-search"></i>

                        </span>

                        <input type="text"
                               name="search"
                               value="<%= typeof search !== 'undefined' ? search : '' %>"
                               class="form-control"
                               id="categorySearch"
                               placeholder="Search Categories...">

                    </div>

                </form>


                <!-- Add Category -->
                <div class="d-inline-flex align-items-center gap-3">

                    <button type="button"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#add_category">

                        <i class="ti ti-square-rounded-plus-filled me-1"></i>

                        Add Category

                    </button>

                </div>

            </div>


            <!-- =================================================
                 CARD BODY
            ================================================== -->

            <div class="card-body">


                <!-- =================================================
                     TABLE HEADER
                ================================================== -->

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">


                    <!-- SORT -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <div class="dropdown">

                            <a href="javascript:void(0);"
                               class="dropdown-toggle btn btn-outline-light shadow"
                               data-bs-toggle="dropdown">

                                <i class="ti ti-sort-ascending-2 me-2"></i>

                                Sort By

                            </a>


                            <div class="dropdown-menu">

                                <ul>

                                    <li>

                                        <a href="/admin/categories?sort=name_asc&search=<%= encodeURIComponent(typeof search !== 'undefined' ? search : '') %>"
                                           class="dropdown-item">

                                            Name (A-Z)

                                        </a>

                                    </li>


                                    <li>

                                        <a href="/admin/categories?sort=name_desc&search=<%= encodeURIComponent(typeof search !== 'undefined' ? search : '') %>"
                                           class="dropdown-item">

                                            Name (Z-A)

                                        </a>

                                    </li>


                                    <li>

                                        <a href="/admin/categories?sort=newest&search=<%= encodeURIComponent(typeof search !== 'undefined' ? search : '') %>"
                                           class="dropdown-item">

                                            Newest First

                                        </a>

                                    </li>


                                    <li>

                                        <a href="/admin/categories?sort=oldest&search=<%= encodeURIComponent(typeof search !== 'undefined' ? search : '') %>"
                                           class="dropdown-item">

                                            Oldest First

                                        </a>

                                    </li>


                                    <li>

                                        <a href="/admin/categories?sort=order_asc&search=<%= encodeURIComponent(typeof search !== 'undefined' ? search : '') %>"
                                           class="dropdown-item">

                                            Display Order

                                        </a>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>


                    <!-- FILTERS -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">


                        <!-- Filter -->
                        <div class="dropdown">

                            <a href="javascript:void(0);"
                               class="btn btn-outline-light shadow px-2"
                               data-bs-toggle="dropdown"
                               data-bs-auto-close="outside">

                                <i class="ti ti-filter me-2"></i>

                                Filter

                                <i class="ti ti-chevron-down ms-2"></i>

                            </a>


                            <div class="filter-dropdown-menu dropdown-menu dropdown-menu-lg p-0">


                                <!-- Filter Header -->
                                <div class="filter-header d-flex align-items-center justify-content-between border-bottom p-3">

                                    <h4 class="mb-0 fs-16">

                                        <i class="ti ti-filter me-1"></i>

                                        Filter

                                    </h4>


                                    <button type="button"
                                            class="btn-close close-filter-btn"
                                            data-bs-dismiss="dropdown"
                                            aria-label="Close">
                                    </button>

                                </div>


                                <!-- Filter Form -->
                                <form method="GET"
                                      action="/admin/categories">

                                    <div class="filter-set-view p-3">


                                        <!-- Search -->
                                        <div class="mb-3">

                                            <label class="form-label">
                                                Search
                                            </label>

                                            <input type="text"
                                                   name="search"
                                                   class="form-control"
                                                   value="<%= typeof search !== 'undefined' ? search : '' %>"
                                                   placeholder="Search category...">

                                        </div>


                                        <!-- Status -->
                                        <div class="mb-3">

                                            <label class="form-label">
                                                Status
                                            </label>

                                            <select name="status"
                                                    class="form-select">

                                                <option value="">
                                                    All Status
                                                </option>

                                                <option value="active"
                                                    <%= typeof status !== 'undefined' && status === 'active' ? 'selected' : '' %>>

                                                    Active

                                                </option>

                                                <option value="inactive"
                                                    <%= typeof status !== 'undefined' && status === 'inactive' ? 'selected' : '' %>>

                                                    Inactive

                                                </option>

                                            </select>

                                        </div>


                                        <!-- Buttons -->
                                        <div class="d-flex align-items-center gap-2">

                                            <a href="/admin/categories"
                                               class="btn btn-outline-light w-100">

                                                Reset

                                            </a>


                                            <button type="submit"
                                                    class="btn btn-primary w-100">

                                                Filter

                                            </button>

                                        </div>

                                    </div>

                                </form>

                            </div>

                        </div>


                        <!-- Manage Columns -->
                        <div class="dropdown">

                            <a href="javascript:void(0);"
                               class="btn bg-soft-indigo border-0"
                               data-bs-toggle="dropdown"
                               data-bs-auto-close="outside">

                                <i class="ti ti-columns-3 me-2"></i>

                                Manage Columns

                            </a>


                            <div class="dropdown-menu dropdown-menu-md dropdown-md p-3">

                                <ul>


                                    <!-- Category -->
                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Category
                                                </span>

                                                <input class="form-check-input ms-auto"
                                                       type="checkbox"
                                                       data-column="1"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>


                                    <!-- Slug -->
                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Slug
                                                </span>

                                                <input class="form-check-input ms-auto"
                                                       type="checkbox"
                                                       data-column="2"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>


                                    <!-- Posts -->
                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Posts
                                                </span>

                                                <input class="form-check-input ms-auto"
                                                       type="checkbox"
                                                       data-column="3"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>


                                    <!-- Order -->
                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Display Order
                                                </span>

                                                <input class="form-check-input ms-auto"
                                                       type="checkbox"
                                                       data-column="4"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>


                                    <!-- Status -->
                                    <li class="gap-1 d-flex align-items-center mb-0">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Status
                                                </span>

                                                <input class="form-check-input ms-auto"
                                                       type="checkbox"
                                                       data-column="5"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     CATEGORIES TABLE
                ================================================== -->

                <div class="table-responsive custom-table">

                    <table class="table table-nowrap"
                           id="categories-table">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Slug
                                </th>

                                <th>
                                    Posts
                                </th>

                                <th>
                                    Order
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end no-sort">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody id="categoriesTableBody">


                            <% if (categories && categories.length) { %>


                                <% categories.forEach(function(cat, index) { %>

                                    <tr data-status="<%= cat.status ? 'active' : 'inactive' %>">


                                        <!-- ID -->
                                        <td>

                                            <%= cat.id %>

                                        </td>


                                        <!-- CATEGORY -->
                                        <td>

                                            <h6 class="mb-0 fw-semibold">

                                                <%= cat.name %>

                                            </h6>

                                        </td>


                                        <!-- SLUG -->
                                        <td>

                                            <span class="text-muted">

                                                /<%= cat.slug %>

                                            </span>

                                        </td>


                                        <!-- POSTS -->
                                        <td>

                                            <span class="badge bg-soft-primary text-primary">

                                                <i class="ti ti-file-text me-1"></i>

                                                <%= cat.get('postCount') || 0 %>

                                            </span>

                                        </td>


                                        <!-- ORDER -->
                                        <td>

                                            <span class="text-muted">

                                                <%= cat.display_order || 0 %>

                                            </span>

                                        </td>


                                        <!-- STATUS -->
                                        <td>

                                            <form method="POST"
                                                  action="/admin/categories/<%= cat.id %>/toggle-status"
                                                  class="d-inline">

                                                <button type="submit"
                                                        class="btn p-0 border-0 bg-transparent">

                                                    <% if (cat.status) { %>

                                                        <span class="badge bg-soft-success text-success">

                                                            <i class="ti ti-circle-filled fs-7 me-1"></i>

                                                            Active

                                                        </span>

                                                    <% } else { %>

                                                        <span class="badge bg-soft-danger text-danger">

                                                            <i class="ti ti-circle-filled fs-7 me-1"></i>

                                                            Inactive

                                                        </span>

                                                    <% } %>

                                                </button>

                                            </form>

                                        </td>


                                        <!-- ACTION -->
                                        <td class="text-end">

                                            <div class="dropdown">

                                                <a href="javascript:void(0);"
                                                   class="btn btn-icon btn-sm"
                                                   data-bs-toggle="dropdown"
                                                   aria-expanded="false">

                                                    <i class="ti ti-dots-vertical"></i>

                                                </a>


                                                <ul class="dropdown-menu dropdown-menu-end">


                                                    <!-- Edit -->
                                                    <li>

                                                        <a href="javascript:void(0);"
                                                           class="dropdown-item editCategoryBtn"
                                                           data-bs-toggle="modal"
                                                           data-bs-target="#edit_category"

                                                           data-id="<%= cat.id %>"
                                                           data-name="<%= cat.name %>"
                                                           data-slug="<%= cat.slug %>"
                                                           data-order="<%= cat.display_order || 0 %>"
                                                           data-status="<%= cat.status ? '1' : '0' %>">

                                                            <i class="ti ti-edit me-1"></i>

                                                            Edit

                                                        </a>

                                                    </li>


                                                    <!-- View Posts -->
                                                    <li>

                                                        <a href="/admin/posts?category=<%= encodeURIComponent(cat.slug) %>"
                                                           class="dropdown-item">

                                                            <i class="ti ti-file-text me-1"></i>

                                                            View Posts

                                                        </a>

                                                    </li>


                                                    <!-- Delete -->
                                                    <li>

                                                        <a href="javascript:void(0);"
                                                           class="dropdown-item text-danger deleteCategoryBtn"

                                                           data-bs-toggle="modal"
                                                           data-bs-target="#delete_category"

                                                           data-id="<%= cat.id %>"
                                                           data-name="<%= cat.name %>">

                                                            <i class="ti ti-trash me-1"></i>

                                                            Delete

                                                        </a>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>


                            <% } else { %>


                                <!-- EMPTY -->
                                <tr>

                                    <td colspan="7"
                                        class="text-center py-5">

                                        <div class="text-muted">

                                            <i class="ti ti-category fs-40 d-block mb-2"></i>

                                            <h5>
                                                No Categories Found
                                            </h5>

                                            <p class="mb-2">
                                                There are no categories available.
                                            </p>

                                            <button type="button"
                                                    class="btn btn-primary btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#add_category">

                                                <i class="ti ti-plus me-1"></i>

                                                Add Your First Category

                                            </button>

                                        </div>

                                    </td>

                                </tr>


                            <% } %>

                        </tbody>

                    </table>

                </div>

<!-- =================================================
     CATEGORY COUNT
================================================= -->

<div class="row align-items-center mt-3">

    <div class="col-md-6">

        <div class="text-muted">

            Showing
            <%= categories ? categories.length : 0 %>
            Category(s)

        </div>

    </div>

</div>
            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     ADD CATEGORY MODAL
========================================================= -->

<div class="modal fade"
     id="add_category"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="POST"
                  action="/admin/categories">

                <div class="modal-header">

                    <h5 class="modal-title">

                        Add Category

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">


                    <!-- Name -->
                    <div class="mb-3">

                        <label class="form-label">

                            Category Name
                            <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               name="name"
                               class="form-control"
                               placeholder="e.g. Admit Card"
                               required>

                    </div>


                    <!-- Slug -->
                    <div class="mb-3">

                        <label class="form-label">

                            Slug

                            <span class="text-muted">
                                (optional)
                            </span>

                        </label>

                        <input type="text"
                               name="slug"
                               class="form-control"
                               placeholder="admit-card">

                    </div>


                    <!-- Order -->
                    <div class="mb-3">

                        <label class="form-label">

                            Display Order

                        </label>

                        <input type="number"
                               name="display_order"
                               class="form-control"
                               value="0">

                    </div>


                    <!-- Status -->
                    <div class="form-check form-switch">

                        <input class="form-check-input"
                               type="checkbox"
                               name="status"
                               id="addCategoryStatus"
                               checked>

                        <label class="form-check-label"
                               for="addCategoryStatus">

                            Active

                        </label>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="ti ti-plus me-1"></i>

                        Add Category

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     EDIT CATEGORY MODAL
========================================================= -->

<div class="modal fade"
     id="edit_category"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="POST"
                  id="editCategoryForm"
                  action="">


                <div class="modal-header">

                    <h5 class="modal-title">

                        Edit Category

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">


                    <!-- Name -->
                    <div class="mb-3">

                        <label class="form-label">

                            Category Name
                            <span class="text-danger">*</span>

                        </label>

                        <input type="text"
                               name="name"
                               id="editCategoryName"
                               class="form-control"
                               required>

                    </div>


                    <!-- Slug -->
                    <div class="mb-3">

                        <label class="form-label">

                            Slug

                        </label>

                        <input type="text"
                               name="slug"
                               id="editCategorySlug"
                               class="form-control">

                    </div>


                    <!-- Order -->
                    <div class="mb-3">

                        <label class="form-label">

                            Display Order

                        </label>

                        <input type="number"
                               name="display_order"
                               id="editCategoryOrder"
                               class="form-control">

                    </div>


                    <!-- Status -->
                    <div class="form-check form-switch">

                        <input class="form-check-input"
                               type="checkbox"
                               name="status"
                               id="editCategoryStatus">

                        <label class="form-check-label"
                               for="editCategoryStatus">

                            Active

                        </label>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="ti ti-device-floppy me-1"></i>

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     DELETE CATEGORY MODAL
========================================================= -->

<div class="modal fade"
     id="delete_category"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-sm">

        <div class="modal-content">

            <form method="POST"
                  id="deleteCategoryForm"
                  action="">


                <div class="modal-body text-center p-4">


                    <div class="mb-3">

                        <span class="avatar avatar-lg bg-soft-danger text-danger rounded-circle">

                            <i class="ti ti-trash fs-24"></i>

                        </span>

                    </div>


                    <h5 class="mb-2">

                        Delete Category?

                    </h5>


                    <p class="text-muted mb-3">

                        Are you sure you want to delete

                        <strong id="deleteCategoryName"></strong>?

                        This action cannot be undone.

                    </p>


                    <div class="d-flex justify-content-center gap-2">


                        <button type="button"
                                class="btn btn-outline-light"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>


                        <button type="submit"
                                class="btn btn-danger">

                            <i class="ti ti-trash me-1"></i>

                            Delete

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     CATEGORY SCRIPT
========================================================= -->

<script>

document.addEventListener('DOMContentLoaded', function () {


    /* =====================================================
       EDIT CATEGORY
    ===================================================== */

    document
        .querySelectorAll('.editCategoryBtn')
        .forEach(function (btn) {

            btn.addEventListener('click', function () {

                const id =
                    btn.dataset.id;

                const name =
                    btn.dataset.name || '';

                const slug =
                    btn.dataset.slug || '';

                const order =
                    btn.dataset.order || 0;

                const status =
                    btn.dataset.status === '1';


                document
                    .getElementById('editCategoryForm')
                    .action =
                    '/admin/categories/' +
                    id +
                    '/update';


                document
                    .getElementById('editCategoryName')
                    .value =
                    name;


                document
                    .getElementById('editCategorySlug')
                    .value =
                    slug;


                document
                    .getElementById('editCategoryOrder')
                    .value =
                    order;


                document
                    .getElementById('editCategoryStatus')
                    .checked =
                    status;

            });

        });


    /* =====================================================
       DELETE CATEGORY
    ===================================================== */

    document
        .querySelectorAll('.deleteCategoryBtn')
        .forEach(function (btn) {

            btn.addEventListener('click', function () {

                const id =
                    btn.dataset.id;

                const name =
                    btn.dataset.name || '';


                document
                    .getElementById('deleteCategoryForm')
                    .action =
                    '/admin/categories/' +
                    id +
                    '/delete';


                document
                    .getElementById('deleteCategoryName')
                    .textContent =
                    '"' + name + '"';

            });

        });


    /* =====================================================
       MANAGE COLUMNS
    ===================================================== */

    document
        .querySelectorAll('#categories-table [data-column]')
        .forEach(function (checkbox) {

            checkbox.addEventListener('change', function () {

                const columnIndex =
                    parseInt(this.dataset.column);


                const display =
                    this.checked
                        ? ''
                        : 'none';


                document
                    .querySelectorAll('#categories-table tr')
                    .forEach(function (row) {

                        if (row.children[columnIndex]) {

                            row.children[columnIndex]
                                .style.display =
                                display;

                        }

                    });

            });

        });


    /* =====================================================
       SEARCH - ENTER
    ===================================================== */

    const searchInput =
        document.getElementById('categorySearch');


    if (searchInput) {

        searchInput.addEventListener('keyup', function (event) {

            if (event.key === 'Enter') {

                const form =
                    searchInput.closest('form');

                if (form) {

                    form.submit();

                }

            }

        });

    }

});

</script>


