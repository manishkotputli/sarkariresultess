<!DOCTYPE html>

<html lang="en">

<head>


<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<title>
    Admin Login - <%= (typeof site_setting !== 'undefined' && site_setting && site_setting.site_title) || 'Sarkari Result' %>
</title>

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Admin Login Panel">
<meta name="robots" content="noindex, nofollow">

<!-- Favicon -->
<link rel="shortcut icon" type="image/x-icon" href="/admin-assets/favicon.png">

<!-- Theme Script -->
<script src="/admin-assets/js/theme-script.js"></script>

<!-- Main CSS -->
<link rel="stylesheet" crossorigin href="/admin-assets/css/main.css">

<!-- Main JS -->
<script type="module" crossorigin src="/admin-assets/js/main.js"></script>

<style>
    /* =====================================================
       CRMS STYLE LOGIN PAGE
    ===================================================== */

    html,
    body {
        min-height: 100%;
    }

    body {
        margin: 0;
        background: #ffffff;
    }

    .login-page {
        min-height: 100vh;
        background: #ffffff;
    }

    .login-wrapper {
        min-height: 100vh;
        padding: 16px;
    }

    .login-row {
        min-height: calc(100vh - 32px);
        border-radius: 18px;
        overflow: hidden;
        background: #ffffff;
    }

    /* =====================================================
       LEFT LOGIN SECTION
    ===================================================== */

    .login-form-section {
        min-height: calc(100vh - 32px);
        overflow-y: auto;
        background: #ffffff;
    }

    .login-form-inner {
        width: 100%;
        max-width: 500px;
        min-height: calc(100vh - 32px);
        margin: auto;
        padding: 35px 40px 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .login-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 30px;
    }

    .login-logo img {
        max-width: 190px;
        max-height: 55px;
        object-fit: contain;
    }

    .login-heading h1 {
        font-size: 30px;
        line-height: 1.3;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 8px;
    }

    .login-heading p {
        color: #6b7280;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 28px;
    }

    /* =====================================================
       FORM
    ===================================================== */

    .login-label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
    }

    .login-input-wrapper {
        position: relative;
    }

    .login-input {
        width: 100%;
        height: 48px;
        padding: 10px 48px 10px 15px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #ffffff;
        color: #111827;
        font-size: 14px;
        outline: none;
        transition: all .2s ease;
        box-sizing: border-box;
    }

    .login-input::placeholder {
        color: #9ca3af;
    }

    .login-input:focus {
        border-color: #70bf4c;
        box-shadow: 0 0 0 3px rgba(112, 191, 76, .10);
    }

    .login-input-icon {
        position: absolute;
        top: 50%;
        right: 15px;
        transform: translateY(-50%);
        color: #9ca3af;
        font-size: 18px;
        pointer-events: none;
    }

    .password-toggle {
        position: absolute;
        top: 0;
        right: 0;
        width: 48px;
        height: 48px;
        border: 0;
        background: transparent;
        color: #9ca3af;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color .2s ease;
    }

    .password-toggle:hover {
        color: #374151;
    }

    .password-toggle:focus {
        outline: none;
    }

    /* =====================================================
       REMEMBER / FORGOT
    ===================================================== */

    .login-options {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-top: 14px;
        margin-bottom: 25px;
    }

    .remember-wrapper {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .remember-checkbox {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: #70bf4c;
    }

    .remember-label {
        color: #374151;
        font-size: 13px;
        cursor: pointer;
        user-select: none;
    }

    .forgot-text {
        font-size: 13px;
        color: #9ca3af;
        text-align: right;
    }

    /* =====================================================
       LOGIN BUTTON
    ===================================================== */

    .login-button {
        width: 100%;
        min-height: 48px;
        border: 0;
        border-radius: 8px;
        padding: 12px 20px;
        background: linear-gradient(135deg, #70bf4c, #5ca83c);
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all .25s ease;
        box-shadow: 0 6px 18px rgba(112, 191, 76, .20);
    }

    .login-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 22px rgba(112, 191, 76, .28);
    }

    .login-button:active {
        transform: translateY(0);
    }

    /* =====================================================
       ERROR
    ===================================================== */

    .login-error {
        margin-bottom: 22px;
        padding: 12px 14px;
        border-radius: 8px;
        background: rgba(220, 53, 69, .08);
        border: 1px solid rgba(220, 53, 69, .18);
        color: #dc3545;
        font-size: 13px;
        font-weight: 500;
    }

    /* =====================================================
       FOOTER
    ===================================================== */

    .login-footer {
        padding-top: 30px;
        text-align: center;
    }

    .login-footer p {
        margin: 0;
        color: #6b7280;
        font-size: 12px;
    }

    /* =====================================================
       RIGHT VISUAL PANEL
    ===================================================== */

    .login-visual-section {
        position: relative;
        min-height: calc(100vh - 32px);
        overflow: hidden;
        background:
            radial-gradient(circle at 20% 20%, rgba(112, 191, 76, .30), transparent 30%),
            radial-gradient(circle at 85% 80%, rgba(255, 255, 255, .15), transparent 30%),
            linear-gradient(145deg, #084e7f 0%, #063c62 55%, #052f4d 100%);
    }

    .login-visual-section::before {
        content: "";
        position: absolute;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, .10);
        top: -160px;
        right: -130px;
    }

    .login-visual-section::after {
        content: "";
        position: absolute;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        border: 1px solid rgba(112, 191, 76, .25);
        bottom: -130px;
        left: -120px;
    }

    .visual-content {
        position: relative;
        z-index: 2;
        height: 100%;
        min-height: calc(100vh - 32px);
        padding: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .visual-inner {
        width: 100%;
        max-width: 560px;
    }

    .visual-logo {
        margin-bottom: 35px;
    }

    .visual-logo img {
        max-width: 220px;
        max-height: 65px;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }

    .visual-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 50px;
        background: rgba(255, 255, 255, .10);
        border: 1px solid rgba(255, 255, 255, .15);
        color: rgba(255, 255, 255, .90);
        font-size: 12px;
        font-weight: 500;
        margin-bottom: 22px;
        backdrop-filter: blur(10px);
    }

    .visual-badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #70bf4c;
        box-shadow: 0 0 0 5px rgba(112, 191, 76, .12);
    }

    .visual-heading {
        color: #ffffff;
        font-size: 38px;
        line-height: 1.2;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .visual-heading span {
        color: #70bf4c;
    }

    .visual-description {
        max-width: 480px;
        margin: 0 auto 35px;
        color: rgba(255, 255, 255, .70);
        font-size: 15px;
        line-height: 1.7;
    }

    /* =====================================================
       DASHBOARD MOCKUP
    ===================================================== */

    .dashboard-preview {
        position: relative;
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
        padding: 12px;
        border-radius: 14px;
        background: rgba(255, 255, 255, .08);
        border: 1px solid rgba(255, 255, 255, .14);
        box-shadow: 0 25px 60px rgba(0, 0, 0, .25);
        backdrop-filter: blur(12px);
    }

    .dashboard-window {
        overflow: hidden;
        border-radius: 9px;
        background: #ffffff;
        text-align: left;
    }

    .dashboard-top {
        height: 38px;
        padding: 0 13px;
        display: flex;
        align-items: center;
        gap: 6px;
        background: #f8fafc;
        border-bottom: 1px solid #edf0f3;
    }

    .window-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #d1d5db;
    }

    .dashboard-body {
        display: flex;
        min-height: 220px;
    }

    .dashboard-sidebar {
        width: 95px;
        padding: 14px 9px;
        background: #f8fafc;
        border-right: 1px solid #edf0f3;
    }

    .side-item {
        height: 10px;
        margin-bottom: 13px;
        border-radius: 4px;
        background: #e5e7eb;
    }

    .side-item.active {
        background: #70bf4c;
    }

    .dashboard-main {
        flex: 1;
        padding: 15px;
    }

    .dashboard-title {
        width: 100px;
        height: 12px;
        border-radius: 4px;
        background: #1f2937;
        margin-bottom: 16px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 9px;
        margin-bottom: 14px;
    }

    .stat-card {
        height: 58px;
        border: 1px solid #edf0f3;
        border-radius: 6px;
        padding: 9px;
    }

    .stat-line {
        width: 45%;
        height: 6px;
        background: #d1d5db;
        border-radius: 3px;
        margin-bottom: 8px;
    }

    .stat-value {
        width: 65%;
        height: 9px;
        background: #70bf4c;
        border-radius: 3px;
    }

    .chart {
        height: 90px;
        border: 1px solid #edf0f3;
        border-radius: 6px;
        position: relative;
        overflow: hidden;
        background:
            linear-gradient(
                to bottom,
                transparent 24%,
                #f1f5f9 25%,
                transparent 26%,
                transparent 49%,
                #f1f5f9 50%,
                transparent 51%,
                transparent 74%,
                #f1f5f9 75%,
                transparent 76%
            );
    }

    .chart-line {
        position: absolute;
        left: 12px;
        right: 12px;
        bottom: 18px;
        height: 40px;
        border-top: 3px solid #70bf4c;
        transform: skewY(-12deg);
    }

    /* =====================================================
       SECURITY NOTE
    ===================================================== */

    .security-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 28px;
        color: rgba(255, 255, 255, .55);
        font-size: 12px;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 991px) {

        .login-wrapper {
            padding: 0;
        }

        .login-row {
            min-height: 100vh;
            border-radius: 0;
        }

        .login-form-section {
            min-height: 100vh;
        }

        .login-form-inner {
            min-height: 100vh;
            padding: 30px 25px 18px;
            max-width: 520px;
        }

        .login-visual-section {
            display: none;
        }

        .login-heading h1 {
            font-size: 28px;
        }
    }

    @media (max-width: 575px) {

        .login-form-inner {
            padding: 25px 20px 15px;
        }

        .login-logo {
            margin-bottom: 25px;
        }

        .login-logo img {
            max-width: 160px;
            max-height: 48px;
        }

        .login-heading h1 {
            font-size: 25px;
        }

        .login-heading p {
            font-size: 13px;
            margin-bottom: 24px;
        }

        .login-options {
            align-items: flex-start;
        }

        .forgot-text {
            max-width: 170px;
        }
    }

</style>


</head>

<body class="login-page">


<!-- Begin Wrapper -->
<div class="main-wrapper">

    <div class="login-wrapper">

        <div class="row g-0 login-row">

            <!-- =====================================================
                 LEFT SIDE - LOGIN FORM
            ====================================================== -->

            <div class="col-lg-6 login-form-section">

                <div class="login-form-inner">

                    <!-- Logo -->
                    <div>

                        <div class="login-logo">
                            <a href="/">
                                <img
                                    src="/admin-assets/logo.png"
                                    alt="<%= (typeof site_setting !== 'undefined' && site_setting && site_setting.site_title) || 'Sarkari Result' %>">
                            </a>
                        </div>

                        <!-- Login Content -->
                        <div class="login-heading">

                            <h1>Welcome Back!</h1>

                            <p>
                                Sign in to access your
                                <strong>
                                    <%= (typeof site_setting !== 'undefined' && site_setting && site_setting.site_title) || 'Sarkari Result' %>
                                </strong>
                                admin panel.
                            </p>

                        </div>

                        <!-- Error Message -->
                        <% if (typeof messages !== 'undefined' && messages.error && messages.error.length) { %>

                            <div class="login-error">
                                <%= messages.error[0] %>
                            </div>

                        <% } %>

                        <!-- Login Form -->
                        <form action="/admin/login" method="POST">

                            <!-- Email -->
                            <div class="mb-5">

                                <label for="email" class="login-label">
                                    Email Address
                                </label>

                                <div class="login-input-wrapper">

                                    <input
                                        type="email"
                                        name="email"
                                        id="email"
                                        class="login-input"
                                        placeholder="admin@example.com"
                                        autocomplete="email"
                                        required>

                                    <span class="login-input-icon">
                                        <i class="icon-mail"></i>
                                    </span>

                                </div>

                            </div>

                            <!-- Password -->
                            <div class="mb-3">

                                <label for="password" class="login-label">
                                    Password
                                </label>

                                <div class="login-input-wrapper">

                                    <input
                                        type="password"
                                        name="password"
                                        id="password"
                                        class="login-input"
                                        placeholder="Enter your password"
                                        autocomplete="current-password"
                                        required>

                                    <button
                                        type="button"
                                        id="togglePassword"
                                        class="password-toggle"
                                        aria-label="Show password">

                                        <i id="passwordIcon" class="icon-eye-off"></i>

                                    </button>

                                </div>

                            </div>

                            <!-- Remember / Forgot -->
                            <div class="login-options">

                                <div class="remember-wrapper">

                                    <input
                                        type="checkbox"
                                        name="remember"
                                        value="1"
                                        id="remember"
                                        class="remember-checkbox">

                                    <label
                                        for="remember"
                                        class="remember-label">

                                        Remember Me

                                    </label>

                                </div>

                                <div class="forgot-text">
                                    Forgot password? Contact super admin.
                                </div>

                            </div>

                            <!-- Submit -->
                            <div>

                                <button
                                    type="submit"
                                    class="login-button">

                                    Sign In

                                </button>

                            </div>

                        </form>

                    </div>

                    <!-- Footer -->
                    <div class="login-footer">

                        <p>
                            Copyright &copy;
                            <%= new Date().getFullYear() %>
                            -
                            <%= (typeof site_setting !== 'undefined' && site_setting && site_setting.site_title) || 'Sarkari Result' %>
                            . All Rights Reserved.
                        </p>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 RIGHT SIDE - CRM VISUAL
            ====================================================== -->

            <div class="col-lg-6 login-visual-section">

                <div class="visual-content">

                    <div class="visual-inner">

                        <!-- Logo -->
                        <div class="visual-logo">

                            <img
                                src="/admin-assets/logo.png"
                                alt="Logo">

                        </div>

                        <!-- Badge -->
                        <div class="visual-badge">

                            <span class="visual-badge-dot"></span>

                            Secure Admin Dashboard

                        </div>

                        <!-- Heading -->
                        <h2 class="visual-heading">

                            Manage Everything
                            <br>

                            <span>From One Place.</span>

                        </h2>

                        <!-- Description -->
                        <p class="visual-description">

                            Powerful tools to manage your website,
                            users, posts, results, tests, courses,
                            reports and all your administrative
                            operations from one secure dashboard.

                        </p>

                        <!-- Dashboard Preview -->
                        <div class="dashboard-preview">

                            <div class="dashboard-window">

                                <!-- Window Header -->
                                <div class="dashboard-top">

                                    <span class="window-dot"></span>
                                    <span class="window-dot"></span>
                                    <span class="window-dot"></span>

                                </div>

                                <!-- Dashboard -->
                                <div class="dashboard-body">

                                    <div class="dashboard-sidebar">

                                        <div class="side-item active"></div>
                                        <div class="side-item"></div>
                                        <div class="side-item"></div>
                                        <div class="side-item"></div>
                                        <div class="side-item"></div>
                                        <div class="side-item"></div>

                                    </div>

                                    <div class="dashboard-main">

                                        <div class="dashboard-title"></div>

                                        <div class="stats-grid">

                                            <div class="stat-card">
                                                <div class="stat-line"></div>
                                                <div class="stat-value"></div>
                                            </div>

                                            <div class="stat-card">
                                                <div class="stat-line"></div>
                                                <div class="stat-value"></div>
                                            </div>

                                            <div class="stat-card">
                                                <div class="stat-line"></div>
                                                <div class="stat-value"></div>
                                            </div>

                                        </div>

                                        <div class="chart">

                                            <div class="chart-line"></div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Security -->
                        <div class="security-note">

                            <i class="icon-lock"></i>

                            Your login information is protected
                            with secure authentication.

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- End Wrapper -->


<!-- Password Toggle -->
<script>

    document.addEventListener('DOMContentLoaded', function () {

        const passwordInput = document.getElementById('password');
        const togglePassword = document.getElementById('togglePassword');
        const passwordIcon = document.getElementById('passwordIcon');

        if (passwordInput && togglePassword) {

            togglePassword.addEventListener('click', function () {

                const isPassword =
                    passwordInput.getAttribute('type') === 'password';

                passwordInput.setAttribute(
                    'type',
                    isPassword ? 'text' : 'password'
                );

                if (passwordIcon) {

                    passwordIcon.className =
                        isPassword
                            ? 'icon-eye'
                            : 'icon-eye-off';

                }

                togglePassword.setAttribute(
                    'aria-label',
                    isPassword
                        ? 'Hide password'
                        : 'Show password'
                );

            });

        }

    });

</script>


</body>

</html>
