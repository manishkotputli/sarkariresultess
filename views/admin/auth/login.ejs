<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="robots"
        content="noindex,nofollow"
    >

    <title>Admin Login</title>

    <style>

        :root {
            --primary: #004252;
            --primary-dark: #075E70;
            --blue: #3B7BD5;

            --bg: #F4F7F8;
            --white: #FFFFFF;

            --text: #0F172A;
            --muted: #64748B;

            --border: #E2E8F0;

            --danger: #DC2626;
        }


        * {
            box-sizing: border-box;
        }


        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
        }


        body {
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;

            background: var(--bg);

            color: var(--text);

            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 24px;
        }


        /* =========================================================
           LOGIN PAGE
        ========================================================== */

        .login-page {
            width: 100%;

            min-height: calc(100vh - 48px);

            display: flex;

            align-items: center;

            justify-content: center;
        }


        /* =========================================================
           LOGIN CARD
        ========================================================== */

        .login-card {
            width: 100%;

            max-width: 420px;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: 16px;

            padding: 34px 32px;

            position: relative;

            overflow: hidden;

            box-shadow:
                0 20px 50px rgba(15, 23, 42, 0.08),
                0 4px 12px rgba(15, 23, 42, 0.04);
        }


        /* Top gradient */

        .login-card::before {
            content: "";

            position: absolute;

            top: 0;
            left: 0;
            right: 0;

            height: 3px;

            background:
                linear-gradient(
                    90deg,
                    var(--primary),
                    var(--blue)
                );
        }


        /* =========================================================
           LOGO
        ========================================================== */

        .login-logo {
            display: flex;

            align-items: center;

            justify-content: center;

            margin-bottom: 26px;
        }


        .login-logo img {
            display: block;

            width: auto;

            max-width: 190px;

            max-height: 70px;

            object-fit: contain;
        }


        /* =========================================================
           HEADING
        ========================================================== */

        .login-heading {
            text-align: center;

            margin-bottom: 28px;
        }


        .login-heading h1 {
            margin: 0 0 8px;

            font-size: 26px;

            line-height: 1.3;

            font-weight: 700;

            color: var(--text);
        }


        .login-heading p {
            margin: 0;

            color: var(--muted);

            font-size: 14px;

            line-height: 1.6;
        }


        /* =========================================================
           ALERT
        ========================================================== */

        .alert {
            padding: 11px 13px;

            margin-bottom: 18px;

            border-radius: 9px;

            font-size: 13px;

            line-height: 1.5;
        }


        .alert-error {
            color: #991B1B;

            background: #FEF2F2;

            border: 1px solid #FECACA;
        }


        .alert-success {
            color: #166534;

            background: #F0FDF4;

            border: 1px solid #BBF7D0;
        }


        /* =========================================================
           FORM
        ========================================================== */

        .login-form {
            width: 100%;
        }


        .form-group {
            margin-bottom: 19px;
        }


        .form-label {
            display: block;

            margin-bottom: 8px;

            color: var(--text);

            font-size: 13px;

            font-weight: 600;
        }


        .input-wrapper {
            position: relative;
        }


        .form-control {
            width: 100%;

            height: 48px;

            padding: 0 14px;

            border: 1px solid var(--border);

            border-radius: 9px;

            outline: none;

            background: #FFFFFF;

            color: var(--text);

            font-size: 14px;

            transition:
                border-color .2s ease,
                box-shadow .2s ease;
        }


        .form-control::placeholder {
            color: #94A3B8;
        }


        .form-control:hover {
            border-color: #CBD5E1;
        }


        .form-control:focus {
            border-color: var(--blue);

            box-shadow:
                0 0 0 3px rgba(
                    59,
                    123,
                    213,
                    0.12
                );
        }


        .password-control {
            padding-right: 48px;
        }


        /* =========================================================
           PASSWORD TOGGLE
        ========================================================== */

        .password-toggle {
            position: absolute;

            right: 0;

            top: 0;

            width: 46px;

            height: 48px;

            border: 0;

            background: transparent;

            color: #64748B;

            display: flex;

            align-items: center;

            justify-content: center;

            cursor: pointer;

            padding: 0;
        }


        .password-toggle:hover {
            color: var(--primary);
        }


        .password-toggle svg {
            width: 19px;

            height: 19px;
        }


        /* =========================================================
           OPTIONS
        ========================================================== */

        .login-options {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 12px;

            margin: 4px 0 22px;
        }


        .remember-wrapper {
            display: inline-flex;

            align-items: center;

            gap: 8px;

            cursor: pointer;

            user-select: none;
        }


        .remember-wrapper input {
            width: 16px;

            height: 16px;

            margin: 0;

            accent-color: var(--blue);

            cursor: pointer;
        }


        .remember-wrapper span {
            color: var(--muted);

            font-size: 13px;
        }


        .forgot-link {
            color: var(--blue);

            font-size: 13px;

            font-weight: 600;

            text-decoration: none;
        }


        .forgot-link:hover {
            text-decoration: underline;
        }


        /* =========================================================
           LOGIN BUTTON
        ========================================================== */

        .login-btn {
            width: 100%;

            height: 48px;

            border: 0;

            border-radius: 9px;

            background:
                linear-gradient(
                    135deg,
                    var(--primary),
                    var(--primary-dark)
                );

            color: #FFFFFF;

            font-size: 14px;

            font-weight: 600;

            cursor: pointer;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 9px;

            box-shadow:
                0 7px 18px rgba(
                    0,
                    66,
                    82,
                    0.18
                );

            transition:
                transform .18s ease,
                box-shadow .18s ease,
                opacity .18s ease;
        }


        .login-btn:hover {
            transform: translateY(-1px);

            box-shadow:
                0 10px 22px rgba(
                    0,
                    66,
                    82,
                    0.22
                );
        }


        .login-btn:active {
            transform: translateY(0);
        }


        .login-btn:disabled {
            opacity: .7;

            cursor: not-allowed;

            transform: none;
        }


        .login-btn svg {
            width: 17px;

            height: 17px;
        }


        /* =========================================================
           SPINNER
        ========================================================== */

        .spinner {
            width: 16px;

            height: 16px;

            border: 2px solid rgba(
                255,
                255,
                255,
                .35
            );

            border-top-color: #FFFFFF;

            border-radius: 50%;

            animation:
                loginSpin .7s linear infinite;
        }


        @keyframes loginSpin {

            to {
                transform: rotate(360deg);
            }

        }


        /* =========================================================
           FOOTER
        ========================================================== */

        .login-footer {
            text-align: center;

            margin-top: 24px;

            padding-top: 20px;

            border-top: 1px solid #F1F5F9;

            color: var(--muted);

            font-size: 12px;

            line-height: 1.6;
        }


        .login-footer strong {
            color: var(--primary);

            font-weight: 600;
        }


        /* =========================================================
           SECURITY
        ========================================================== */

        .security-badge {
            display: flex;

            align-items: center;

            justify-content: center;

            gap: 6px;

            margin-top: 12px;

            color: #94A3B8;

            font-size: 11px;
        }


        .security-badge svg {
            width: 13px;

            height: 13px;
        }


        /* =========================================================
           MOBILE
        ========================================================== */

        @media (max-width: 575px) {

            body {
                padding: 16px;
            }


            .login-page {
                min-height: calc(100vh - 32px);
            }


            .login-card {
                max-width: 100%;

                padding: 28px 22px;

                border-radius: 14px;
            }


            .login-logo img {
                max-width: 165px;
            }


            .login-heading h1 {
                font-size: 23px;
            }

        }


        @media (max-width: 360px) {

            .login-card {
                padding: 24px 18px;
            }


            .login-options {
                flex-direction: column;

                align-items: flex-start;

                gap: 10px;
            }

        }

    </style>

</head>


<body>


<div class="login-page">

    <div class="login-card">


        <!-- =====================================================
             LOGO
        ====================================================== -->

        <div class="login-logo">

            <img
                src="/admin_assets/img/logos.png"
                alt="Sarkari Resultess"
            >

        </div>


        <!-- =====================================================
             HEADING
        ====================================================== -->

        <!-- <div class="login-heading">

            <h1>
                Welcome Back!
            </h1>

            <p>
                Sign in to access your admin dashboard
            </p>

        </div> -->


        <!-- =====================================================
             ERROR
        ====================================================== -->

        <% if (typeof error !== 'undefined' && error) { %>

            <div class="alert alert-error">
                <%= error %>
            </div>

        <% } %>


        <!-- =====================================================
             SUCCESS
        ====================================================== -->

        <% if (typeof success !== 'undefined' && success) { %>

            <div class="alert alert-success">
                <%= success %>
            </div>

        <% } %>


        <!-- =====================================================
             EXPRESS FLASH ERROR
        ====================================================== -->

        <% if (
            typeof messages !== 'undefined' &&
            messages.error &&
            messages.error.length
        ) { %>

            <div class="alert alert-error">

                <% messages.error.forEach(function (message) { %>

                    <div>
                        <%= message %>
                    </div>

                <% }); %>

            </div>

        <% } %>


        <!-- =====================================================
             LOGIN FORM
        ====================================================== -->

        <form
            method="POST"
            action="/admin/login"
            class="login-form"
            id="adminLoginForm"
        >


            <!-- EMAIL -->

            <div class="form-group">

                <label
                    for="email"
                    class="form-label"
                >
                    Email Address
                </label>


                <div class="input-wrapper">

                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-control"
                        placeholder="Enter your email address"
                        value="<%= typeof email !== 'undefined' ? email : '' %>"
                        autocomplete="email"
                        required
                        autofocus
                    >

                </div>

            </div>


            <!-- PASSWORD -->

            <div class="form-group">

                <label
                    for="password"
                    class="form-label"
                >
                    Password
                </label>


                <div class="input-wrapper">

                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="form-control password-control"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                    >


                    <button
                        type="button"
                        class="password-toggle"
                        id="passwordToggle"
                        aria-label="Show password"
                        title="Show password"
                    >

                        <!-- Eye Open -->

                        <svg
                            id="eyeOpen"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >

                            <path
                                d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"
                            />

                            <circle
                                cx="12"
                                cy="12"
                                r="3"
                            />

                        </svg>


                        <!-- Eye Closed -->

                        <svg
                            id="eyeClosed"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            style="display:none;"
                        >

                            <path d="M3 3l18 18"/>

                            <path
                                d="M10.6 10.6a2 2 0 0 0 2.8 2.8"
                            />

                            <path
                                d="M9.9 4.2A10.9 10.9 0 0 1 12 4c6.5 0 10 8 10 8a18.5 18.5 0 0 1-3.1 4.4"
                            />

                            <path
                                d="M6.6 6.6C3.5 8.8 2 12 2 12s3.5 8 10 8a10.8 10.8 0 0 0 4.1-.8"
                            />

                        </svg>

                    </button>

                </div>

            </div>


            <!-- =====================================================
                 OPTIONS
            ====================================================== -->

            <div class="login-options">


                <label class="remember-wrapper">

                    <input
                        type="checkbox"
                        name="remember"
                        id="remember"
                        value="1"
                    >

                    <span>
                        Remember me
                    </span>

                </label>


                <a
                    href="/admin/forgot-password"
                    class="forgot-link"
                >
                    Forgot Password?
                </a>

            </div>


            <!-- =====================================================
                 LOGIN BUTTON
            ====================================================== -->

            <button
                type="submit"
                class="login-btn"
                id="loginButton"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >

                    <path
                        d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"
                    />

                    <polyline
                        points="10 17 15 12 10 7"
                    />

                    <line
                        x1="15"
                        y1="12"
                        x2="3"
                        y2="12"
                    />

                </svg>


                <span id="loginButtonText">
                    Sign In
                </span>

            </button>

        </form>


        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <div class="login-footer">

            <div>
                © <%= new Date().getFullYear() %>
                <strong>
                    Sarkari Resultess
                </strong>
            </div>


            <!-- <div class="security-badge">

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >

                    <rect
                        x="3"
                        y="11"
                        width="18"
                        height="10"
                        rx="2"
                    />

                    <path
                        d="M7 11V7a5 5 0 0 1 10 0v4"
                    />

                </svg>

                Secure Admin Access

            </div> -->

        </div>


    </div>

</div>


<!-- =============================================================
     JAVASCRIPT
============================================================== -->

<script>

document.addEventListener(
    'DOMContentLoaded',
    function () {


        /* =====================================================
           PASSWORD SHOW / HIDE
        ====================================================== */

        const passwordInput =
            document.getElementById('password');


        const passwordToggle =
            document.getElementById('passwordToggle');


        const eyeOpen =
            document.getElementById('eyeOpen');


        const eyeClosed =
            document.getElementById('eyeClosed');


        if (
            passwordInput &&
            passwordToggle
        ) {

            passwordToggle.addEventListener(
                'click',
                function () {

                    const isPassword =
                        passwordInput.type === 'password';


                    passwordInput.type =
                        isPassword
                            ? 'text'
                            : 'password';


                    if (isPassword) {

                        eyeOpen.style.display =
                            'none';

                        eyeClosed.style.display =
                            'block';


                        passwordToggle.setAttribute(
                            'aria-label',
                            'Hide password'
                        );


                        passwordToggle.setAttribute(
                            'title',
                            'Hide password'
                        );

                    } else {

                        eyeOpen.style.display =
                            'block';

                        eyeClosed.style.display =
                            'none';


                        passwordToggle.setAttribute(
                            'aria-label',
                            'Show password'
                        );


                        passwordToggle.setAttribute(
                            'title',
                            'Show password'
                        );

                    }

                }
            );

        }


        /* =====================================================
           LOGIN BUTTON LOADING
        ====================================================== */

        const loginForm =
            document.getElementById(
                'adminLoginForm'
            );


        const loginButton =
            document.getElementById(
                'loginButton'
            );


        if (
            loginForm &&
            loginButton
        ) {

            loginForm.addEventListener(
                'submit',
                function () {

                    /*
                     * IMPORTANT:
                     * Do NOT preventDefault().
                     *
                     * Express will receive:
                     *
                     * POST /admin/login
                     */

                    loginButton.disabled =
                        true;


                    loginButton.innerHTML = `
                        <span class="spinner"></span>
                        <span>Signing In...</span>
                    `;

                }
            );

        }

    }
);

</script>


</body>
</html>