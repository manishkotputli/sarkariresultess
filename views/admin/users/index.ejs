<%- include('../../adminlayout/header') %>

<%
    // Safe locals
    const userList = Array.isArray(users) ? users : [];
    const roleList = Array.isArray(roles) ? roles : [];

    const currentFilters =
        typeof filters !== 'undefined' && filters
            ? filters
            : {};

    const currentSearch =
        typeof currentFilters.search !== 'undefined'
            ? currentFilters.search
            : '';

    const currentRole =
        typeof currentFilters.role !== 'undefined'
            ? currentFilters.role
            : '';

    const currentStatus =
        typeof currentFilters.status !== 'undefined'
            ? currentFilters.status
            : '';

    const currentSort =
        typeof currentFilters.sort !== 'undefined'
            ? currentFilters.sort
            : (
                typeof sort !== 'undefined'
                    ? sort
                    : ''
            );

    const paginationData =
        typeof pagination !== 'undefined' && pagination
            ? pagination
            : null;

    const totalUsers =
        typeof total !== 'undefined'
            ? total
            : userList.length;
%>

<style>
    /*
    |--------------------------------------------------------------------------
    | USERS TABLE
    |--------------------------------------------------------------------------
    */

    #users-table th,
    #users-table td {
        vertical-align: middle;
    }

    #users-table .user-avatar {
        width: 40px;
        height: 40px;
        min-width: 40px;
        object-fit: cover;
        border-radius: 50%;
    }

    #users-table .user-name {
        max-width: 260px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .column-toggle-menu {
        min-width: 230px;
    }

    .column-toggle-menu .form-check {
        margin-bottom: 0;
    }

    .column-toggle-menu .form-switch .form-check-input {
        cursor: pointer;
    }

    .user-code {
        font-family: monospace;
        font-size: 13px;
    }
</style>

<div class="page-wrapper">

    <div class="content pb-0">

        <!-- =========================================================
             ALERTS
        ========================================================== -->

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <%= success %>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        <% } %>

        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">

                <ul class="mb-0">
                    <% errors.forEach(function(error) { %>
                        <li><%= error %></li>
                    <% }); %>
                </ul>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        <% } %>

        <!-- =========================================================
             PAGE HEADER
        ========================================================== -->

        <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">

            <div>
                <h4 class="mb-1">Users</h4>

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 p-0">

                        <li class="breadcrumb-item">
                            <a href="/admin">Home</a>
                        </li>

                        <li class="breadcrumb-item active" aria-current="page">
                            Users
                        </li>

                    </ol>
                </nav>
            </div>

            <div class="gap-2 d-flex align-items-center flex-wrap">

                <!-- Export -->
                <div class="dropdown">

                    <a href="javascript:void(0);"
                       class="dropdown-toggle btn btn-outline-light px-2 shadow"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        <i class="ti ti-package-export me-2"></i>
                        Export
                    </a>

                    <div class="dropdown-menu dropdown-menu-end">

                        <ul>
                            <li>
                                <a href="/admin/users/export/pdf"
                                   class="dropdown-item">

                                    <i class="ti ti-file-type-pdf me-1"></i>
                                    Export as PDF
                                </a>
                            </li>

                            <li>
                                <a href="/admin/users/export/excel"
                                   class="dropdown-item">

                                    <i class="ti ti-file-type-xls me-1"></i>
                                    Export as Excel
                                </a>
                            </li>
                        </ul>

                    </div>
                </div>

                <!-- Refresh -->
                <a href="javascript:location.reload();"
                   class="btn btn-icon btn-outline-light shadow"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   aria-label="Refresh"
                   data-bs-original-title="Refresh">

                    <i class="ti ti-refresh"></i>
                </a>

                <!-- Collapse -->
                <a href="javascript:void(0);"
                   class="btn btn-icon btn-outline-light shadow"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   aria-label="Collapse"
                   data-bs-original-title="Collapse"
                   id="collapse-header">

                    <i class="ti ti-transition-top"></i>
                </a>

            </div>
        </div>

        <!-- =========================================================
             USERS CARD
        ========================================================== -->

        <div class="card border-0 rounded-0">

            <!-- =====================================================
                 CARD HEADER
            ====================================================== -->

            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">

                <!-- SEARCH -->
                <form method="GET"
                      action="/admin/users"
                      class="mb-0">

                    <!-- Preserve filters -->
                    <input type="hidden"
                           name="role"
                           value="<%= currentRole %>">

                    <input type="hidden"
                           name="status"
                           value="<%= currentStatus %>">

                    <input type="hidden"
                           name="sort"
                           value="<%= currentSort %>">

                    <div class="input-icon input-icon-start position-relative">

                        <span class="input-icon-addon text-dark">
                            <i class="ti ti-search"></i>
                        </span>

                        <input type="text"
                               name="search"
                               value="<%= currentSearch %>"
                               class="form-control"
                               id="userSearch"
                               placeholder="Search users...">

                    </div>

                </form>

                <!-- ADD USER -->
                <div class="d-inline-flex align-items-center gap-3">

                    <a href="/admin/users/create"
                       class="btn btn-primary">

                        <i class="ti ti-square-rounded-plus-filled me-1"></i>
                        Add User
                    </a>

                </div>

            </div>

            <!-- =====================================================
                 CARD BODY
            ====================================================== -->

            <div class="card-body">

                <!-- =================================================
                     TOOLBAR
                ================================================== -->

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">

                    <!-- LEFT TOOLS -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <!-- SORT -->
                        <div class="dropdown">

                            <a href="javascript:void(0);"
                               class="dropdown-toggle btn btn-outline-light shadow"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <i class="ti ti-sort-ascending-2 me-2"></i>
                                Sort By
                            </a>

                            <div class="dropdown-menu">

                                <ul>

                                    <li>
                                        <a href="/admin/users?sort=name_asc&search=<%= encodeURIComponent(currentSearch) %>&role=<%= encodeURIComponent(currentRole) %>&status=<%= encodeURIComponent(currentStatus) %>"
                                           class="dropdown-item">

                                            Name (A-Z)
                                        </a>
                                    </li>

                                    <li>
                                        <a href="/admin/users?sort=name_desc&search=<%= encodeURIComponent(currentSearch) %>&role=<%= encodeURIComponent(currentRole) %>&status=<%= encodeURIComponent(currentStatus) %>"
                                           class="dropdown-item">

                                            Name (Z-A)
                                        </a>
                                    </li>

                                    <li>
                                        <a href="/admin/users?sort=newest&search=<%= encodeURIComponent(currentSearch) %>&role=<%= encodeURIComponent(currentRole) %>&status=<%= encodeURIComponent(currentStatus) %>"
                                           class="dropdown-item">

                                            Newest First
                                        </a>
                                    </li>

                                    <li>
                                        <a href="/admin/users?sort=oldest&search=<%= encodeURIComponent(currentSearch) %>&role=<%= encodeURIComponent(currentRole) %>&status=<%= encodeURIComponent(currentStatus) %>"
                                           class="dropdown-item">

                                            Oldest First
                                        </a>
                                    </li>

                                </ul>

                            </div>
                        </div>

                        <!-- FILTER -->
                        <div class="dropdown">

                            <a href="javascript:void(0);"
                               class="dropdown-toggle btn btn-outline-light shadow"
                               data-bs-toggle="dropdown"
                               data-bs-auto-close="outside"
                               aria-expanded="false">

                                <i class="ti ti-filter me-2"></i>
                                Filter
                            </a>

                            <div class="dropdown-menu dropdown-menu-lg dropdown-menu-start p-3">

                                <form method="GET" action="/admin/users">

                                    <input type="hidden"
                                           name="search"
                                           value="<%= currentSearch %>">

                                    <input type="hidden"
                                           name="sort"
                                           value="<%= currentSort %>">

                                    <!-- ROLE -->
                                    <div class="mb-3">

                                        <label class="form-label">
                                            Role
                                        </label>

                                        <select name="role"
                                                class="form-select">

                                            <option value="">
                                                All Roles
                                            </option>

                                            <% roleList.forEach(function(role) { %>

                                                <option value="<%= role.id %>"
                                                    <% if (String(currentRole) === String(role.id)) { %>
                                                        selected
                                                    <% } %>>

                                                    <%= role.name %>

                                                </option>

                                            <% }); %>

                                        </select>

                                    </div>

                                    <!-- STATUS -->
                                    <div class="mb-3">

                                        <label class="form-label">
                                            Status
                                        </label>

                                        <select name="status"
                                                class="form-select">

                                            <option value="">
                                                All Status
                                            </option>

                                            <option value="active"
                                                <% if (currentStatus === 'active') { %>
                                                    selected
                                                <% } %>>

                                                Active
                                            </option>

                                            <option value="inactive"
                                                <% if (currentStatus === 'inactive') { %>
                                                    selected
                                                <% } %>>

                                                Inactive
                                            </option>

                                        </select>

                                    </div>

                                    <div class="d-flex justify-content-end gap-2">

                                        <a href="/admin/users"
                                           class="btn btn-light">

                                            Clear
                                        </a>

                                        <button type="submit"
                                                class="btn btn-primary">

                                            Apply Filter
                                        </button>

                                    </div>

                                </form>

                            </div>
                        </div>

                    </div>

                    <!-- RIGHT TOOLS -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <!-- MANAGE COLUMNS -->
                        <div class="dropdown">

                            <a href="javascript:void(0);"
                               class="btn bg-soft-indigo border-0"
                               data-bs-toggle="dropdown"
                               data-bs-auto-close="outside"
                               aria-expanded="false">

                                <i class="ti ti-columns-3 me-2"></i>
                                Manage Columns
                            </a>

                            <div class="dropdown-menu dropdown-menu-md dropdown-menu-end p-3 column-toggle-menu">

                                <ul class="list-unstyled mb-0">

                                    <!-- # -->
                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>#</span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="0"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>

                                    <!-- USER -->
                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>User</span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="1"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>

                                    <!-- CODE -->
                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Code</span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="2"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>

                                    <!-- ROLE -->
                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Role</span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="3"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>

                                    <!-- STATUS -->
                                    <li class="gap-1 d-flex align-items-center mb-0">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Status</span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="4"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>

                                </ul>

                            </div>
                        </div>

                    </div>

                </div>

                <!-- =================================================
                     ACTIVE FILTERS
                ================================================== -->

                <% if (currentSearch || currentRole || currentStatus) { %>

                    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">

                        <span class="text-muted small">
                            Active filters:
                        </span>

                        <% if (currentSearch) { %>
                            <span class="badge bg-soft-primary text-primary">
                                Search: <%= currentSearch %>
                            </span>
                        <% } %>

                        <% if (currentRole) { %>
                            <span class="badge bg-soft-info text-info">
                                Role: <%= currentRole %>
                            </span>
                        <% } %>

                        <% if (currentStatus) { %>
                            <span class="badge bg-soft-warning text-warning">
                                Status: <%= currentStatus %>
                            </span>
                        <% } %>

                        <a href="/admin/users"
                           class="small text-danger">

                            Clear All
                        </a>

                    </div>

                <% } %>

                <!-- =================================================
                     USERS TABLE
                ================================================== -->

                <div class="table-responsive custom-table">

                    <table class="table table-nowrap"
                           id="users-table">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    User
                                </th>

                                <th>
                                    Code
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end no-sort">
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody id="usersTableBody">

                            <% if (userList.length) { %>

                                <% userList.forEach(function(user, index) { %>

                                    <%
                                        const userName =
                                            user.name || 'Unnamed User';

                                        const userEmail =
                                            user.email || '-';

                                        const userCode =
                                            user.user_code || '-';

                                        const profilePhoto =
                                            user.profile_photo ||
                                            '/admin-assets/avatar-default.jpg';

                                        const roleName =
                                            user.Role && user.Role.name
                                                ? user.Role.name
                                                : '-';

                                        const isActive =
                                            Boolean(user.is_active);

                                        const rowNumber =
                                            paginationData &&
                                            paginationData.page &&
                                            paginationData.limit
                                                ? (
                                                    (
                                                        paginationData.page - 1
                                                    ) *
                                                    paginationData.limit
                                                ) +
                                                index +
                                                1
                                                : index + 1;
                                    %>

                                    <tr>

                                        <!-- # -->
                                        <td>
                                            <%= rowNumber %>
                                        </td>

                                        <!-- USER -->
                                        <td>

                                            <div class="d-flex align-items-center">

                                                <div class="avatar avatar-md me-2 flex-shrink-0">

                                                    <img src="<%= profilePhoto %>"
                                                         class="user-avatar"
                                                         alt="<%= userName %>"
                                                         onerror="this.onerror=null;this.src='/admin-assets/avatar-default.jpg';">

                                                </div>

                                                <div class="min-w-0">

                                                    <h6 class="mb-1 user-name">

                                                        <a href="/admin/users/<%= user.id %>/edit"
                                                           class="text-dark">

                                                            <%= userName %>

                                                        </a>

                                                    </h6>

                                                    <span class="text-muted fs-13">

                                                        <%= userEmail %>

                                                    </span>

                                                </div>

                                            </div>

                                        </td>

                                        <!-- CODE -->
                                        <td>

                                            <span class="text-muted user-code">

                                                <%= userCode %>

                                            </span>

                                        </td>

                                        <!-- ROLE -->
                                        <td>

                                            <% if (roleName !== '-') { %>

                                                <span class="badge bg-soft-primary text-primary">

                                                    <i class="ti ti-shield me-1"></i>

                                                    <%= roleName %>

                                                </span>

                                            <% } else { %>

                                                <span class="text-muted">
                                                    -
                                                </span>
                                            <% } %>

                                        </td>

                                        <!-- STATUS -->
                                        <td>

                                            <form method="POST"
                                                  action="/admin/users/<%= user.id %>/toggle-status"
                                                  class="d-inline">

                                                <button type="submit"
                                                        class="border-0 bg-transparent p-0">

                                                    <% if (isActive) { %>

                                                        <span class="badge bg-soft-success text-success">

                                                            <i class="ti ti-circle-filled fs-7 me-1"></i>
                                                            Active

                                                        </span>

                                                    <% } else { %>

                                                        <span class="badge bg-soft-danger text-danger">

                                                            <i class="ti ti-circle-filled fs-7 me-1"></i>
                                                            Inactive

                                                        </span>

                                                    <% } %>

                                                </button>

                                            </form>

                                        </td>

                                        <!-- ACTION -->
                                        <td class="text-end">

                                            <div class="dropdown">

                                                <a href="javascript:void(0);"
                                                   class="btn btn-icon btn-sm"
                                                   data-bs-toggle="dropdown"
                                                   aria-expanded="false">

                                                    <i class="ti ti-dots-vertical"></i>

                                                </a>

                                                <ul class="dropdown-menu dropdown-menu-end">

                                                    <!-- EDIT -->
                                                    <li>

                                                        <a href="/admin/users/<%= user.id %>/edit"
                                                           class="dropdown-item">

                                                            <i class="ti ti-edit me-1"></i>
                                                            Edit

                                                        </a>

                                                    </li>

                                                    <!-- DELETE -->
                                                    <li>

                                                        <a href="javascript:void(0);"
                                                           class="dropdown-item text-danger"
                                                           data-bs-toggle="modal"
                                                           data-bs-target="#delete_user_<%= user.id %>">

                                                            <i class="ti ti-trash me-1"></i>
                                                            Delete

                                                        </a>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>

                                <% }); %>

                            <% } else { %>

                                <!-- EMPTY -->
                                <tr id="noUsersRow">

                                    <td colspan="6" class="text-center py-5">

                                        <div class="text-muted">

                                            <i class="ti ti-users fs-40 d-block mb-2"></i>

                                            <h5>No Users Found</h5>

                                            <p class="mb-2">
                                                There are no users matching your search or filters.
                                            </p>

                                            <a href="/admin/users/create"
                                               class="btn btn-primary btn-sm">

                                                <i class="ti ti-plus me-1"></i>
                                                Add Your First User

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

                <!-- =================================================
                     PAGINATION
                ================================================== -->

                <% if (
                    paginationData &&
                    paginationData.totalPages &&
                    paginationData.totalPages > 1
                ) { %>

                    <div class="row align-items-center mt-3">

                        <!-- INFO -->
                        <div class="col-md-6">

                            <div class="text-muted">

                                Page
                                <%= paginationData.page %>
                                of
                                <%= paginationData.totalPages %>

                                &nbsp;·&nbsp;

                                <%= totalUsers %>
                                total users

                            </div>

                        </div>

                        <!-- PAGINATION -->
                        <div class="col-md-6">

                            <div class="d-flex justify-content-end">

                                <ul class="pagination mb-0">

                                    <!-- PREVIOUS -->
                                    <% if (paginationData.hasPrev) { %>

                                        <li class="page-item">

                                            <a class="page-link"
                                               href="/admin/users?page=<%= paginationData.page - 1 %>&search=<%= encodeURIComponent(currentSearch) %>&role=<%= encodeURIComponent(currentRole) %>&status=<%= encodeURIComponent(currentStatus) %>&sort=<%= encodeURIComponent(currentSort) %>">

                                                <i class="ti ti-chevron-left"></i>

                                            </a>

                                        </li>

                                    <% } %>

                                    <!-- PAGES -->
                                    <% if (
                                        Array.isArray(paginationData.pages) &&
                                        paginationData.pages.length
                                    ) { %>

                                        <% paginationData.pages.forEach(function(pageNumber) { %>

                                            <li class="page-item <%= Number(pageNumber) === Number(paginationData.page) ? 'active' : '' %>">

                                                <a class="page-link"
                                                   href="/admin/users?page=<%= pageNumber %>&search=<%= encodeURIComponent(currentSearch) %>&role=<%= encodeURIComponent(currentRole) %>&status=<%= encodeURIComponent(currentStatus) %>&sort=<%= encodeURIComponent(currentSort) %>">

                                                    <%= pageNumber %>

                                                </a>

                                            </li>

                                        <% }); %>

                                    <% } %>

                                    <!-- NEXT -->
                                    <% if (paginationData.hasNext) { %>

                                        <li class="page-item">

                                            <a class="page-link"
                                               href="/admin/users?page=<%= paginationData.page + 1 %>&search=<%= encodeURIComponent(currentSearch) %>&role=<%= encodeURIComponent(currentRole) %>&status=<%= encodeURIComponent(currentStatus) %>&sort=<%= encodeURIComponent(currentSort) %>">

                                                <i class="ti ti-chevron-right"></i>

                                            </a>

                                        </li>

                                    <% } %>

                                </ul>

                            </div>

                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

</div>

<!-- =============================================================
     DELETE MODALS
============================================================== -->

<% if (userList.length) { %>

    <% userList.forEach(function(user) { %>

        <div class="modal fade"
             id="delete_user_<%= user.id %>"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Delete User
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>

                    </div>

                    <div class="modal-body">

                        <div class="text-center">

                            <div class="avatar avatar-xl bg-danger-subtle text-danger rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center">

                                <i class="ti ti-trash fs-30"></i>

                            </div>

                            <h5 class="mb-2">
                                Delete this user?
                            </h5>

                            <p class="text-muted mb-0">

                                Are you sure you want to delete
                                <strong><%= user.name || 'this user' %></strong>?

                                This action cannot be undone.

                            </p>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <form method="POST"
                              action="/admin/users/<%= user.id %>/delete"
                              class="d-inline">

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="ti ti-trash me-1"></i>
                                Delete User

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    <% }); %>

<% } %>

<!-- =============================================================
     MANAGE COLUMNS
============================================================== -->

<script>
document.addEventListener('DOMContentLoaded', function () {

    const table = document.getElementById('users-table');

    if (!table) {
        return;
    }

    const toggles =
        table.parentElement.parentElement
            ? document.querySelectorAll('.column-toggle')
            : [];

    const storagePrefix = 'users_table_column_';

    /*
    |--------------------------------------------------------------------------
    | SHOW / HIDE COLUMN
    |--------------------------------------------------------------------------
    */

    function updateColumnVisibility(columnIndex, visible) {

        const rows =
            table.querySelectorAll('tr');

        rows.forEach(function (row) {

            const cell =
                row.children[columnIndex];

            if (!cell) {
                return;
            }

            if (visible) {

                cell.style.removeProperty('display');

            } else {

                cell.style.setProperty(
                    'display',
                    'none',
                    'important'
                );

            }

        });

        /*
        |--------------------------------------------------------------------------
        | Empty row colspan
        |--------------------------------------------------------------------------
        */

        const emptyCell =
            table.querySelector('#noUsersRow td');

        if (emptyCell) {

            const visibleColumns =
                Array.from(
                    table.querySelectorAll('thead tr th')
                ).filter(function (th) {

                    return window.getComputedStyle(th).display !== 'none';

                }).length;

            emptyCell.setAttribute(
                'colspan',
                visibleColumns || 1
            );

        }
    }

    /*
    |--------------------------------------------------------------------------
    | INITIALIZE
    |--------------------------------------------------------------------------
    */

    toggles.forEach(function (toggle) {

        const columnIndex =
            parseInt(
                toggle.getAttribute('data-column'),
                10
            );

        if (Number.isNaN(columnIndex)) {
            return;
        }

        const storageKey =
            storagePrefix + columnIndex;

        const savedState =
            localStorage.getItem(storageKey);

        if (savedState !== null) {

            const isVisible =
                savedState === 'true';

            toggle.checked =
                isVisible;

            updateColumnVisibility(
                columnIndex,
                isVisible
            );
        }

        /*
        |--------------------------------------------------------------------------
        | CHANGE
        |--------------------------------------------------------------------------
        */

        toggle.addEventListener(
            'change',
            function () {

                const isVisible =
                    this.checked;

                updateColumnVisibility(
                    columnIndex,
                    isVisible
                );

                localStorage.setItem(
                    storageKey,
                    String(isVisible)
                );

            }
        );

    });

});
</script>

<!-- =============================================================
     SEARCH ENTER
============================================================== -->

<script>
document.addEventListener('DOMContentLoaded', function () {

    const searchInput =
        document.getElementById('userSearch');

    if (!searchInput) {
        return;
    }

    searchInput.addEventListener(
        'keydown',
        function (event) {

            if (event.key === 'Enter') {

                event.preventDefault();

                const form =
                    searchInput.closest('form');

                if (form) {
                    form.submit();
                }

            }

        }
    );

});
</script>

