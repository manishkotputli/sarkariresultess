/* =========================================================
   HELPERS
========================================================= */

function esc(value) {

    var div =
        document.createElement('div');

    div.textContent =
        value == null
            ? ''
            : String(value);

    return div.innerHTML;

}


function number(value) {

    return Number(value || 0)
        .toLocaleString('en-IN');

}


function money(value) {

    return '₹' +
        Number(value || 0)
            .toLocaleString('en-IN');

}


function dateFormat(value) {

    if (!value) {
        return '-';
    }

    var date =
        new Date(value);

    if (
        isNaN(
            date.getTime()
        )
    ) {
        return value;
    }

    return date.toLocaleDateString(
        'en-IN',
        {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
        }
    );

}


function destroyChart(id) {

    if (
        chartInstances[id]
    ) {

        try {

            chartInstances[id].destroy();

        } catch (e) {

            console.warn(e);

        }

        chartInstances[id] =
            null;

    }

}


function createChart(
    id,
    options
) {

    destroyChart(id);

    var element = document.getElementById(id);

    if (!element) return;

    if (!window.ApexCharts) {
        element.innerHTML = '<div class="text-center text-muted py-5 fs-12">Chart library is loading...</div>';
        return;
    }

    try {
        chartInstances[id] = new ApexCharts(element, options);
        var result = chartInstances[id].render();

        if (result && typeof result.catch === 'function') {
            result.catch(function (error) {
                console.error('Chart render failed:', id, error);
                element.innerHTML = '<div class="text-center text-muted py-5 fs-12">Unable to load this chart.</div>';
                chartInstances[id] = null;
            });
        }
    } catch (error) {
        console.error('Chart initialization failed:', id, error);
        element.innerHTML = '<div class="text-center text-muted py-5 fs-12">Unable to load this chart.</div>';
        chartInstances[id] = null;
    }

}


/* =========================================================
   DAILY DATA
========================================================= */

function getDailyData(d) {

    var rows =
        Array.isArray(
            d.incomeExpense &&
            d.incomeExpense.series
        )
            ? d.incomeExpense.series
            : [];

    var dates = [
        ...new Set(
            rows.map(
                function(row) {
                    return row.date;
                }
            )
        )
    ].sort();

    var incomeMap = {};

    var expenseMap = {};

    rows.forEach(
        function(row) {

            var amount =
                Number(
                    row.total || 0
                );

            if (
                row.type === 'income'
            ) {

                incomeMap[row.date] =
                    amount;

            } else {

                expenseMap[row.date] =
                    amount;

            }

        }
    );

    var income =
        dates.map(
            function(date) {
                return incomeMap[date] || 0;
            }
        );

    var expense =
        dates.map(
            function(date) {
                return expenseMap[date] || 0;
            }
        );

    var net =
        dates.map(
            function(date, index) {

                return (
                    income[index] -
                    expense[index]
                );

            }
        );

    return {
        dates: dates,
        income: income,
        expense: expense,
        net: net
    };

}


