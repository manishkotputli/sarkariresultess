/* =========================================================
   GROWTH OPPORTUNITIES
========================================================= */

function renderGrowthOpportunities(d) {

    d = d || {};

    var stats = d.stats || {};
    var posts = d.posts || {};
    var revenue = d.revenueBreakdown || {};

    var totalUsers = Number(stats.totalUsers || 0);
    var activeUsers = Number(stats.activeUsers || 0);
    var activeRate = totalUsers ? (activeUsers / totalUsers * 100) : 0;

    var ctr = Number(posts.ctr || 0);

    var courseRevenue = Number(revenue.course || 0);
    var testRevenue = Number(revenue.testSeries || 0);
    var otherRevenue = Number(revenue.other || 0);
    var totalRevenue = courseRevenue + testRevenue + otherRevenue;

    var productShare = totalRevenue
        ? ((courseRevenue + testRevenue) / totalRevenue * 100)
        : 0;

    var contentCount =
        Number(stats.totalPosts || 0) +
        Number(stats.totalBlogs || 0);

    var set = function(id, value) {
        var el = document.getElementById(id);
        if (el) el.textContent = value;
    };

    set('opportunity-ctr', ctr.toFixed(1) + '%');
    set('opportunity-active-rate', activeRate.toFixed(1) + '%');
    set('opportunity-revenue-share', productShare.toFixed(1) + '%');
    set('opportunity-content-count', number(contentCount));
}


/* =========================================================
   STATS UPDATE
========================================================= */

function renderStats(d) {

    var s =
        d.stats || {};

    var set =
        function(id, value) {

            var el =
                document.getElementById(id);

            if (el) {
                el.textContent =
                    value;
            }

        };


    set(
        'stat-total-users',
        number(s.totalUsers)
    );

    set(
        'stat-total-categories',
        number(s.totalCategories)
    );

    var activeRateValue =
        Number(s.totalUsers || 0)
            ? (Number(s.activeUsers || 0) / Number(s.totalUsers || 0) * 100)
            : 0;

    set(
        'stat-active-rate',
        activeRateValue.toFixed(1) + '%'
    );

    set(
        'stat-active-users',
        number(s.activeUsers)
    );

    set(
        'stat-total-revenue',
        money(s.totalRevenue)
    );

    set(
        'stat-net-income',
        money(s.netIncome)
    );

    set(
        'stat-total-posts',
        number(s.totalPosts)
    );

    set(
        'stat-total-blogs',
        number(s.totalBlogs)
    );

    set(
        'stat-total-courses',
        number(s.totalCourses)
    );

    set(
        'stat-total-testseries',
        number(s.totalTestSeries)
    );

    set(
        'stat-total-income',
        money(s.totalIncome)
    );

    set(
        'stat-total-expense',
        money(s.totalExpense)
    );

    set(
        'stat-post-ctr',
        (d.posts?.ctr || 0) +
        '%'
    );


    function updateGrowth(
        id,
        value,
        expense
    ) {

        var el =
            document.getElementById(id);

        if (!el) {
            return;
        }

        var n =
            Number(value || 0);

        el.className =
            'tracking-stat-growth ' +
            (
                expense
                    ? (
                        n <= 0
                            ? 'positive'
                            : 'negative'
                    )
                    : (
                        n >= 0
                            ? 'positive'
                            : 'negative'
                    )
            );

        el.innerHTML =

            '<span class="growth-arrow">' +
            (
                n >= 0
                    ? '↗'
                    : '↘'
            ) +
            '</span>' +

            '<span>' +
            (
                n >= 0
                    ? '+'
                    : ''
            ) +
            n +
            '%</span> ' +

            '<small>from last month</small>';

    }


    updateGrowth(
        'stat-user-growth',
        s.userGrowth
    );

    updateGrowth(
        'stat-income-growth',
        s.incomeGrowth
    );

    updateGrowth(
        'stat-expense-growth',
        s.expenseGrowth,
        true
    );

    updateGrowth(
        'stat-net-growth',
        s.netIncomeGrowth
    );

}


