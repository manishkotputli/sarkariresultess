<%- include('../../adminlayout/header') %>

<%
/* =========================================================
   SAFE DATA
========================================================= */

const dashboard =
    typeof data !== 'undefined' && data
        ? data
        : {};

const stats =
    dashboard.stats || {};

const range =
    dashboard.range || {};

const incomeExpense =
    dashboard.incomeExpense || {};

const posts =
    dashboard.posts || {};

const blogs =
    dashboard.blogs || {};

const courses =
    dashboard.courses || {};

const testSeries =
    dashboard.testSeries || {};

const revenueBreakdown =
    dashboard.revenueBreakdown || {};

const totalUsers =
    Number(stats.totalUsers || 0);

const activeUsers =
    Number(stats.activeUsers || 0);

const totalRevenue =
    Number(stats.totalRevenue || 0);

const totalIncome =
    Number(stats.totalIncome || 0);

const totalExpense =
    Number(stats.totalExpense || 0);

const netIncome =
    Number(stats.netIncome || 0);

const activeRate =
    totalUsers
        ? ((activeUsers / totalUsers) * 100).toFixed(1)
        : '0.0';

const netMargin =
    totalIncome
        ? ((netIncome / totalIncome) * 100).toFixed(1)
        : '0.0';

const safeDashboardJSON =
    JSON.stringify(dashboard)
        .replace(/</g, '\\u003c')
        .replace(/>/g, '\\u003e')
        .replace(/&/g, '\\u0026');
%>


<style>

/* =========================================================
   TRACKING REPORT
========================================================= */

.tracking-report-page {
    padding-bottom: 30px;
}


/* =========================================================
   FILTER
========================================================= */

.tracking-filter-wrap {
    display: flex;
    align-items: center;
}

.tracking-filter {
    min-height: 42px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 4px 8px;
    display: flex;
    align-items: center;
    gap: 7px;
    box-shadow: 0 1px 2px rgba(0,0,0,.03);
}

.tracking-filter select,
.tracking-filter input {
    height: 32px;
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    color: #374151;
    font-size: 12px;
}

.tracking-filter select {
    min-width: 125px;
}

.tracking-filter input[type="number"] {
    width: 75px;
}

.tracking-filter input[type="date"] {
    width: 125px;
}

.tracking-filter .filter-extra {
    border-left: 1px solid #e5e7eb !important;
    padding-left: 10px;
}

.tracking-filter-spinner {
    display: none;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    color: var(--primary);
}

.tracking-filter-spinner.show {
    display: inline-flex;
}


/* =========================================================
   STAT CARDS - DREAMS BOOTSTRAP STYLE
========================================================= */

.tracking-stat-card {
    position: relative;
    overflow: hidden;
    transition: all .25s ease;
}

.tracking-stat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0,0,0,.07);
}

.tracking-stat-card .card-body {
    min-height: 145px;
}

.tracking-stat-card .stat-label {
    font-size: 13px;
    font-weight: 500;
    color: #6b7280;
    margin-bottom: 6px;
}

.tracking-stat-card .stat-value {
    font-size: 25px;
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
    margin-bottom: 12px;
}

.tracking-stat-card .stat-description {
    font-size: 11px;
    color: #6b7280;
    margin-bottom: 0;
}

.tracking-stat-card .custom-card-icon {
    position: absolute;
    top: 0;
    right: 0;
}

.tracking-stat-card .avatar {
    box-shadow: 0 5px 15px rgba(0,0,0,.04);
}

.tracking-stat-card .stat-badge {
    font-size: 10px;
    font-weight: 600;
}

.bg-primary-gradient-100 {
    background: linear-gradient(135deg, rgba(59,130,246,.14), rgba(59,130,246,.05)) !important;
}

.bg-success-gradient-100 {
    background: linear-gradient(135deg, rgba(34,197,94,.14), rgba(34,197,94,.05)) !important;
}

.bg-warning-gradient-100 {
    background: linear-gradient(135deg, rgba(245,158,11,.15), rgba(245,158,11,.05)) !important;
}

.bg-danger-gradient-100 {
    background: linear-gradient(135deg, rgba(239,68,68,.14), rgba(239,68,68,.05)) !important;
}

.bg-info-gradient-100 {
    background: linear-gradient(135deg, rgba(6,182,212,.14), rgba(6,182,212,.05)) !important;
}

.bg-purple-gradient-100 {
    background: linear-gradient(135deg, rgba(139,92,246,.14), rgba(139,92,246,.05)) !important;
}

.tracking-stat-trend {
    font-size: 10px;
    font-weight: 500;
}

.tracking-stat-trend.positive { color: #16a34a; }
.tracking-stat-trend.negative { color: #dc2626; }
.tracking-stat-trend.neutral { color: #6b7280; }

@media (max-width: 767px) {
    .tracking-stat-card .stat-value { font-size: 21px; }
}

/* =========================================================
   CHART CARD
========================================================= */

.tracking-chart-card {
    background: #fff;
    border: 1px solid #e7ebf0;
    border-radius: 6px;
    box-shadow: 0 1px 3px rgba(0,0,0,.025);
    height: 100%;
}

.tracking-chart-header {
    padding: 18px 18px 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
}

.tracking-chart-title {
    margin: 0;
    color: #111827;
    font-size: 15px;
    font-weight: 700;
}

.tracking-chart-subtitle {
    margin: 4px 0 0;
    color: #9ca3af;
    font-size: 11px;
}

.tracking-chart-body {
    padding: 10px 18px 18px;
}

.tracking-chart {
    min-height: 310px;
}


/* =========================================================
   TABLE CARD
========================================================= */

.tracking-table-card {
    background: #fff;
    border: 0;
    border-radius: 0;
}

.tracking-table-card .card-header {
    background: #fff;
}

.tracking-table-card .card-body {
    padding-top: 0;
}

.tracking-table-title {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 3px;
}

.tracking-table-subtitle {
    color: #9ca3af;
    font-size: 11px;
    margin: 0;
}

.tracking-table-card .table {
    margin-bottom: 0;
}

.tracking-table-card .table th {
    font-size: 11px;
    font-weight: 600;
    color: #6b7280;
    white-space: nowrap;
}

.tracking-table-card .table td {
    font-size: 12px;
    color: #374151;
    vertical-align: middle;
}

.tracking-table-card .table tbody tr:last-child td {
    border-bottom: 0;
}

.tracking-table-card .table tbody tr:hover {
    background: #fafafa;
}

.tracking-title-cell {
    max-width: 280px;
}

.tracking-title-link {
    color: #111827;
    font-weight: 600;
    display: block;
    max-width: 280px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}


/* =========================================================
   SMALL KPI
========================================================= */

.tracking-kpi {
    padding: 14px 16px;
    background: #fff;
    border: 1px solid #e7ebf0;
    border-radius: 6px;
}

.tracking-kpi-label {
    color: #9ca3af;
    font-size: 10px;
    margin-bottom: 5px;
}

.tracking-kpi-value {
    color: #111827;
    font-size: 17px;
    font-weight: 700;
}


/* =========================================================
   PROGRESS
========================================================= */

.tracking-progress {
    height: 5px;
    background: #eef2f7;
    border-radius: 10px;
    overflow: hidden;
    min-width: 70px;
}

.tracking-progress span {
    display: block;
    height: 100%;
    background: var(--primary);
    border-radius: 10px;
}


/* =========================================================
   STATUS
========================================================= */

.tracking-status {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 600;
}

.tracking-status-success {
    color: #15803d;
    background: #f0fdf4;
}

.tracking-status-danger {
    color: #b91c1c;
    background: #fef2f2;
}

.tracking-status-warning {
    color: #b45309;
    background: #fffbeb;
}

.tracking-status-primary {
    color: #1d4ed8;
    background: #eff6ff;
}


/* =========================================================
   EMPTY TABLE
========================================================= */

.tracking-empty {
    text-align: center;
    padding: 35px 15px !important;
    color: #9ca3af !important;
}

.tracking-empty i {
    font-size: 32px;
    display: block;
    margin-bottom: 7px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (min-width: 992px) {

    .tracking-stat-grid {
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
    }

}

@media (min-width: 1400px) {

    .tracking-stat-grid {
        grid-template-columns:
            repeat(6, minmax(0, 1fr));
    }

}

@media (max-width: 767px) {

    .tracking-filter-wrap {
        width: 100%;
    }

    .tracking-filter {
        width: 100%;
        overflow-x: auto;
    }

    .tracking-stat-value {
        font-size: 20px;
    }

    .tracking-chart {
        min-height: 280px;
    }

}


/* =========================================================
   PRINT
========================================================= */

@media print {

    .tracking-filter-wrap,
    .page-header-actions {
        display: none !important;
    }

    .tracking-stat-card,
    .tracking-chart-card,
    .tracking-table-card {
        box-shadow: none !important;
    }

}

</style>


<div class="page-wrapper">

    <div class="content pb-0 tracking-report-page">


        <!-- =====================================================
             ALERTS
        ====================================================== -->

        <% if (typeof success !== 'undefined' && success) { %>

            <div class="alert alert-success alert-dismissible fade show mb-4">

                <%= success %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
                </button>

            </div>

        <% } %>


        <% if (
            typeof errors !== 'undefined' &&
            errors &&
            errors.length
        ) { %>

            <div class="alert alert-danger alert-dismissible fade show mb-4">

                <ul class="mb-0">

                    <% errors.forEach(function(error) { %>

                        <li>
                            <%= error %>
                        </li>

                    <% }) %>

                </ul>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
                </button>

            </div>

        <% } %>



        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">


            <div>

                <h4 class="mb-1">
                    Tracking Report
                </h4>

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb mb-0 p-0">

                        <li class="breadcrumb-item">

                            <a href="/admin">
                                Home
                            </a>

                        </li>

                        <li class="breadcrumb-item active">

                            Tracking Report

                        </li>

                    </ol>

                </nav>

                <div class="mt-2">

                    <span class="badge badge-soft-primary">

                        <i class="ti ti-calendar me-1"></i>

                        Showing:
                        <span id="rangeLabel">
                            <%= range.label || 'Selected Period' %>
                        </span>

                    </span>

                </div>

            </div>


            <div class="d-flex align-items-center gap-2 flex-wrap page-header-actions">


                <!-- FILTER -->

                <div class="tracking-filter-wrap">

                    <div class="tracking-filter">

                        <i class="ti ti-calendar text-muted"></i>


                        <select
                            id="filterType"
                            class="form-select tracking-select"
                        >

                            <option
                                value="today"
                                <%= range.filter === 'today' ? 'selected' : '' %>
                            >
                                Today
                            </option>

                            <option
                                value="last_7_days"
                                <%= range.filter === 'last_7_days' ? 'selected' : '' %>
                            >
                                Last 7 Days
                            </option>

                            <option
                                value="last_30_days"
                                <%= range.filter === 'last_30_days' ? 'selected' : '' %>
                            >
                                Last 30 Days
                            </option>

                            <option
                                value="this_month"
                                <%= range.filter === 'this_month' ? 'selected' : '' %>
                            >
                                This Month
                            </option>

                            <option
                                value="previous_month"
                                <%= range.filter === 'previous_month' ? 'selected' : '' %>
                            >
                                Previous Month
                            </option>

                            <option
                                value="month"
                                <%= range.filter === 'month' ? 'selected' : '' %>
                            >
                                Month
                            </option>

                            <option
                                value="year"
                                <%= range.filter === 'year' ? 'selected' : '' %>
                            >
                                Year
                            </option>

                            <option
                                value="custom"
                                <%= range.filter === 'custom' ? 'selected' : '' %>
                            >
                                Custom Range
                            </option>

                        </select>


                        <!-- MONTH -->

                        <select
                            id="filterMonth"
                            class="form-select filter-extra d-none"
                        >

                            <%
                            [
                                'January',
                                'February',
                                'March',
                                'April',
                                'May',
                                'June',
                                'July',
                                'August',
                                'September',
                                'October',
                                'November',
                                'December'
                            ].forEach(function(month, index) {
                            %>

                                <option value="<%= index + 1 %>">
                                    <%= month %>
                                </option>

                            <% }) %>

                        </select>


                        <!-- YEAR -->

                        <input
                            type="number"
                            id="filterYear"
                            class="form-control filter-extra d-none"
                            min="2000"
                            max="2100"
                            value="<%= new Date().getFullYear() %>"
                        >


                        <!-- CUSTOM FROM -->

                        <input
                            type="date"
                            id="filterFrom"
                            class="form-control filter-extra d-none"
                        >

                        <span
                            id="filterArrow"
                            class="text-muted d-none"
                        >
                            →
                        </span>

                        <input
                            type="date"
                            id="filterTo"
                            class="form-control filter-extra d-none"
                        >


                        <span
                            id="filterSpinner"
                            class="tracking-filter-spinner"
                        >

                            <i class="ti ti-loader-2"></i>

                        </span>

                    </div>

                </div>


                <!-- REFRESH -->

                <a
                    href="javascript:void(0);"
                    onclick="location.reload();"
                    class="btn btn-icon btn-outline-light shadow"
                    data-bs-toggle="tooltip"
                    title="Refresh"
                >

                    <i class="ti ti-refresh"></i>

                </a>


                <!-- COLLAPSE -->

                <a
                    href="javascript:void(0);"
                    class="btn btn-icon btn-outline-light shadow"
                    id="collapse-header"
                    data-bs-toggle="tooltip"
                    title="Collapse"
                >

                    <i class="ti ti-transition-top"></i>

                </a>

            </div>

        </div>



        <!-- =====================================================
     TRACKING STAT CARDS
====================================================== -->

<div class="row">

    <!-- TOTAL POSTS -->
    <div class="col-xl-3 col-sm-6 d-flex">
        <div class="card flex-fill tracking-stat-card">
            <div class="card-body position-relative">
                <p class="stat-label">Total Posts</p>
                <h4 class="stat-value" id="stat-total-posts"><%= Number(stats.totalPosts || 0).toLocaleString('en-IN') %></h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-primary border-0 stat-badge"><i class="ti ti-file-text me-1"></i>Posts</span>
                    <p class="stat-description">Published content</p>
                </div>
                <div class="custom-card-icon"><div class="avatar avatar-rounded avatar-lg bg-primary-gradient-100 position-absolute top-0 end-0"><i class="ti ti-file-text fs-28 text-primary"></i></div></div>
            </div>
        </div>
    </div>

    <!-- CATEGORIES -->
    <div class="col-xl-3 col-sm-6 d-flex">
        <div class="card flex-fill tracking-stat-card">
            <div class="card-body position-relative">
                <p class="stat-label">Categories</p>
                <h4 class="stat-value" id="stat-total-categories"><%= Number(stats.totalCategories || 0).toLocaleString('en-IN') %></h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-success border-0 stat-badge"><i class="ti ti-category me-1"></i>Categories</span>
                    <p class="stat-description">Content categories</p>
                </div>
                <div class="custom-card-icon"><div class="avatar avatar-rounded avatar-lg bg-info-gradient-100 position-absolute top-0 end-0"><i class="ti ti-category fs-28 text-info"></i></div></div>
            </div>
        </div>
    </div>

    <!-- BLOGS -->
    <div class="col-xl-3 col-sm-6 d-flex">
        <div class="card flex-fill tracking-stat-card">
            <div class="card-body position-relative">
                <p class="stat-label">Blog Posts</p>
                <h4 class="stat-value" id="stat-total-blogs"><%= Number(stats.totalBlogs || 0).toLocaleString('en-IN') %></h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-warning border-0 stat-badge"><i class="ti ti-news me-1"></i>Blogs</span>
                    <p class="stat-description">Published blogs</p>
                </div>
                <div class="custom-card-icon"><div class="avatar avatar-rounded avatar-lg bg-warning-gradient-100 position-absolute top-0 end-0"><i class="ti ti-news fs-28 text-warning"></i></div></div>
            </div>
        </div>
    </div>

    <!-- USERS -->
    <div class="col-xl-3 col-sm-6 d-flex">
        <div class="card flex-fill tracking-stat-card">
            <div class="card-body position-relative">
                <p class="stat-label">Total Users</p>
                <h4 class="stat-value" id="stat-total-users"><%= Number(stats.totalUsers || 0).toLocaleString('en-IN') %></h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-success border-0 stat-badge"><i class="ti ti-users me-1"></i>Users</span>
                    <p class="stat-description">Registered users</p>
                </div>
                <div class="custom-card-icon"><div class="avatar avatar-rounded avatar-lg bg-success-gradient-100 position-absolute top-0 end-0"><i class="ti ti-users fs-28 text-success"></i></div></div>
            </div>
        </div>
    </div>

    <!-- ACTIVE USERS -->
    <div class="col-xl-3 col-sm-6 d-flex">
        <div class="card flex-fill tracking-stat-card">
            <div class="card-body position-relative">
                <p class="stat-label">Active Users</p>
                <h4 class="stat-value" id="stat-active-users"><%= Number(stats.activeUsers || 0).toLocaleString('en-IN') %></h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-success border-0 stat-badge"><i class="ti ti-user-check me-1"></i>Active</span>
                    <p class="stat-description"><span id="stat-active-rate"><%= activeRate %>%</span> active rate</p>
                </div>
                <div class="custom-card-icon"><div class="avatar avatar-rounded avatar-lg bg-success-gradient-100 position-absolute top-0 end-0"><i class="ti ti-user-check fs-28 text-success"></i></div></div>
            </div>
        </div>
    </div>

    <!-- REVENUE -->
    <div class="col-xl-3 col-sm-6 d-flex">
        <div class="card flex-fill tracking-stat-card">
            <div class="card-body position-relative">
                <p class="stat-label">Total Revenue</p>
                <h4 class="stat-value" id="stat-total-revenue">₹<%= Number(stats.totalRevenue || 0).toLocaleString('en-IN') %></h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-primary border-0 stat-badge"><i class="ti ti-currency-rupee me-1"></i>Revenue</span>
                    <p class="stat-description">Total generated revenue</p>
                </div>
                <div class="custom-card-icon"><div class="avatar avatar-rounded avatar-lg bg-primary-gradient-100 position-absolute top-0 end-0"><i class="ti ti-currency-rupee fs-28 text-primary"></i></div></div>
            </div>
        </div>
    </div>

    <!-- INCOME -->
    <div class="col-xl-3 col-sm-6 d-flex">
        <div class="card flex-fill tracking-stat-card">
            <div class="card-body position-relative">
                <p class="stat-label">Total Income</p>
                <h4 class="stat-value" id="stat-total-income">₹<%= Number(stats.totalIncome || 0).toLocaleString('en-IN') %></h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-success border-0 stat-badge"><i class="ti ti-trending-up me-1"></i>Income</span>
                    <p class="stat-description">Total incoming amount</p>
                </div>
                <div class="custom-card-icon"><div class="avatar avatar-rounded avatar-lg bg-success-gradient-100 position-absolute top-0 end-0"><i class="ti ti-wallet fs-28 text-success"></i></div></div>
            </div>
        </div>
    </div>

    <!-- EXPENSE -->
    <div class="col-xl-3 col-sm-6 d-flex">
        <div class="card flex-fill tracking-stat-card">
            <div class="card-body position-relative">
                <p class="stat-label">Total Expense</p>
                <h4 class="stat-value" id="stat-total-expense">₹<%= Number(stats.totalExpense || 0).toLocaleString('en-IN') %></h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-danger border-0 stat-badge"><i class="ti ti-credit-card me-1"></i>Expense</span>
                    <p class="stat-description">Total outgoing amount</p>
                </div>
                <div class="custom-card-icon"><div class="avatar avatar-rounded avatar-lg bg-danger-gradient-100 position-absolute top-0 end-0"><i class="ti ti-credit-card fs-28 text-danger"></i></div></div>
            </div>
        </div>
    </div>

    <!-- NET INCOME -->
    <div class="col-xl-3 col-sm-6 d-flex">
        <div class="card flex-fill tracking-stat-card">
            <div class="card-body position-relative">
                <p class="stat-label">Net Income</p>
                <h4 class="stat-value" id="stat-net-income">₹<%= Number(stats.netIncome || 0).toLocaleString('en-IN') %></h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-primary border-0 stat-badge"><i class="ti ti-chart-line me-1"></i>Net</span>
                    <p class="stat-description">Income minus expense</p>
                </div>
                <div class="custom-card-icon"><div class="avatar avatar-rounded avatar-lg bg-purple-gradient-100 position-absolute top-0 end-0"><i class="ti ti-chart-line fs-28 text-purple"></i></div></div>
            </div>
        </div>
    </div>

    <!-- COURSES -->
    <div class="col-xl-3 col-sm-6 d-flex">
        <div class="card flex-fill tracking-stat-card">
