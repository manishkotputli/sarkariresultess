function renderPostPerformance(d) {

    var map = {};

    var viewsRows =
        Array.isArray(
            d.posts?.topByViews
        )
            ? d.posts.topByViews
            : [];

    var clickRows =
        Array.isArray(
            d.posts?.topByClicks
        )
            ? d.posts.topByClicks
            : [];

    var likeRows =
        Array.isArray(
            d.posts?.topByLikes
        )
            ? d.posts.topByLikes
            : [];


    viewsRows.forEach(
        function(row) {

            var id =
                row.post?.id ||
                row.post?.title;

            if (!id) {
                return;
            }

            map[id] = {

                title:
                    row.post?.title ||
                    'Post',

                views:
                    Number(
                        row.count || 0
                    ),

                clicks: 0,

                likes: 0

            };

        }
    );


    clickRows.forEach(
        function(row) {

            var id =
                row.post?.id ||
                row.post?.title;

            if (!id) {
                return;
            }

            if (!map[id]) {

                map[id] = {

                    title:
                        row.post?.title ||
                        'Post',

                    views: 0,

                    clicks: 0,

                    likes: 0

                };

            }

            map[id].clicks =
                Number(
                    row.count || 0
                );

        }
    );


    likeRows.forEach(
        function(row) {

            var id =
                row.post?.id ||
                row.post?.title;

            if (!id) {
                return;
            }

            if (!map[id]) {

                map[id] = {

                    title:
                        row.post?.title ||
                        'Post',

                    views: 0,

                    clicks: 0,

                    likes: 0

                };

            }

            map[id].likes =
                Number(
                    row.count || 0
                );

        }
    );


    var rows =
        Object.values(map)
            .slice(0, 10);


    var tbody =
        document.getElementById(
            'tbody-post-performance'
        );

    if (!tbody) {
        return;
    }


    if (!rows.length) {

        tbody.innerHTML =
            emptyRow(
                5,
                'ti-file-text',
                'No post analytics available'
            );

        return;

    }


    tbody.innerHTML =
        rows.map(
            function(row) {

                var ctr =
                    row.views
                        ? (
                            row.clicks /
                            row.views *
                            100
                        )
                        : 0;

                return `

                    <tr>

                        <td class="tracking-title-cell">

                            <span class="tracking-title-link">

                                ${esc(
                                    row.title
                                )}

                            </span>

                        </td>

                        <td>
                            ${number(row.views)}
                        </td>

                        <td>
                            ${number(row.clicks)}
                        </td>

                        <td>
                            ${number(row.likes)}
                        </td>

                        <td>

                            <span class="badge badge-soft-primary">

                                ${ctr.toFixed(2)}%

                            </span>

                        </td>

                    </tr>

                `;

            }
        ).join('');

}


