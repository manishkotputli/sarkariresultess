    if (
        rangeLabel &&
        d.range?.label
    ) {

        rangeLabel.textContent =
            d.range.label;

    }

}


/* =========================================================
   FILTER VISIBILITY
========================================================= */

function updateFilterVisibility() {

    var type =
        document.getElementById(
            'filterType'
        ).value;


    var month =
        document.getElementById(
            'filterMonth'
        );

    var year =
        document.getElementById(
            'filterYear'
        );

    var from =
        document.getElementById(
            'filterFrom'
        );

    var to =
        document.getElementById(
            'filterTo'
        );

    var arrow =
        document.getElementById(
            'filterArrow'
        );


    [
        month,
        year,
        from,
        to,
        arrow
    ].forEach(
        function(element) {

            if (element) {

                element.classList.add(
                    'd-none'
                );

            }

        }
    );


    if (
        type === 'month'
    ) {

        month.classList.remove(
            'd-none'
        );

        year.classList.remove(
            'd-none'
        );

    }


    if (
        type === 'year'
    ) {

        year.classList.remove(
            'd-none'
        );

    }


    if (
        type === 'custom'
    ) {

        from.classList.remove(
            'd-none'
        );

        arrow.classList.remove(
            'd-none'
        );

        to.classList.remove(
            'd-none'
        );

    }

}


/* =========================================================
   BUILD QUERY
========================================================= */

function buildQuery() {

    var type =
        document.getElementById(
            'filterType'
        ).value;

    var params =
        new URLSearchParams();


    params.set(
        'filter',
        type
    );


    if (
        type === 'month'
    ) {

        params.set(
            'month',
            document.getElementById(
                'filterMonth'
            ).value
        );

        params.set(
            'year',
            document.getElementById(
                'filterYear'
            ).value
        );

    }


    if (
        type === 'year'
    ) {

        params.set(
            'year',
            document.getElementById(
                'filterYear'
            ).value
        );

    }


    if (
        type === 'custom'
    ) {

        var from =
            document.getElementById(
                'filterFrom'
            ).value;

        var to =
            document.getElementById(
                'filterTo'
            ).value;


        if (from) {

            params.set(
                'from',
                from
            );

        }

        if (to) {

            params.set(
                'to',
                to
            );

        }

    }


    return params.toString();

}


/* =========================================================
   APPLY FILTER
========================================================= */

async function applyFilter() {

    var type =
        document.getElementById(
            'filterType'
        ).value;


    if (
        type === 'custom'
    ) {

        var from =
            document.getElementById(
                'filterFrom'
            ).value;

        var to =
            document.getElementById(
                'filterTo'
            ).value;


        if (
            !from ||
            !to
        ) {

            return;

        }

    }


    if (
        filterController
    ) {

        filterController.abort();

    }


    filterController =
        new AbortController();


    var spinner =
        document.getElementById(
            'filterSpinner'
        );

    spinner.classList.add(
        'show'
    );


    try {

        var query =
            buildQuery();


        var response =
            await fetch(
                '/admin/tracking-report/data?' +
                query,
                {

                    headers: {

                        'X-Requested-With':
                            'XMLHttpRequest',

                        'Accept':
                            'application/json'

                    },

                    signal:
                        filterController.signal

                }
            );


        if (!response.ok) {

            throw new Error(
                'HTTP ' +
                response.status
            );

        }


        var json =
            await response.json();


        if (
            json &&
            json.ok
        ) {

            window.TRACKING_DATA =
                json.data;


            renderDashboard(
                json.data
            );


            try {

                history.replaceState(
                    null,
                    '',
                    '/admin/tracking-report?' +
                    query
                );

            } catch (error) {

                console.warn(
                    error
                );

            }

        }

    } catch (error) {

        if (
            error.name !==
            'AbortError'
        ) {

            console.error(
                'Tracking filter failed:',
                error
            );

        }

    } finally {

        spinner.classList.remove(
            'show'
        );

    }

}


/* =========================================================
   FILTER EVENTS
========================================================= */

document.addEventListener(
    'change',
    function(event) {

        var id =
            event.target.id;


        if (
            id ===
            'filterType'
        ) {

            updateFilterVisibility();

            clearTimeout(
                filterTimer
            );

            filterTimer =
                setTimeout(
                    applyFilter,
                    120
                );

        }


        if (
            id === 'filterMonth' ||
            id === 'filterYear'
        ) {

            clearTimeout(
                filterTimer
            );

            filterTimer =
                setTimeout(
                    applyFilter,
                    120
                );

        }


        if (
            id === 'filterFrom' ||
            id === 'filterTo'
        ) {

            var from =
                document.getElementById(
                    'filterFrom'
                ).value;

            var to =
                document.getElementById(
                    'filterTo'
                ).value;


            if (
                from &&
                to
            ) {

                clearTimeout(
                    filterTimer
                );

                filterTimer =
                    setTimeout(
                        applyFilter,
                        120
                    );

            }

        }

    }
);


/* =========================================================
   INITIALIZE
========================================================= */

function bootTrackingDashboard() {
    updateFilterVisibility();

    if (window.ApexCharts) {
        renderDashboard(window.TRACKING_DATA);
        return;
    }

    var attempts = 0;
    var waitForApex = setInterval(function () {
        attempts++;

        if (window.ApexCharts) {
            clearInterval(waitForApex);
            renderDashboard(window.TRACKING_DATA);
            return;
        }

        if (attempts >= 100) {
            clearInterval(waitForApex);
            console.error('ApexCharts failed to load after waiting.');
        }
    }, 50);
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootTrackingDashboard);
} else {
    bootTrackingDashboard();
}

