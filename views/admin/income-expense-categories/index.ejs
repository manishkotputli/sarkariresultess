<%
    /*
    |--------------------------------------------------------------------------
    | SAFE LOCALS
    |--------------------------------------------------------------------------
    */

    const categoryList =
        Array.isArray(categories)
            ? categories
            : [];

    const categoryFilters =
        typeof filters !== 'undefined' && filters
            ? filters
            : {};

    const searchValue =
        categoryFilters.search || '';

    const typeValue =
        categoryFilters.type || '';


    /*
    |--------------------------------------------------------------------------
    | HELPERS
    |--------------------------------------------------------------------------
    */

    function getTypeLabel(type) {

        return Number(type) === 1
            ? 'Income'
            : 'Expense';

    }


    function getTypeClass(type) {

        return Number(type) === 1
            ? 'bg-soft-success text-success'
            : 'bg-soft-danger text-danger';

    }


    function getTypeIcon(type) {

        return Number(type) === 1
            ? 'ti-trending-up'
            : 'ti-trending-down';

    }


    function getTypeIconClass(type) {

        return Number(type) === 1
            ? 'bg-soft-success text-success'
            : 'bg-soft-danger text-danger';

    }


    function getEntryCount(category) {

        if (
            typeof category.entryCount !== 'undefined'
        ) {

            return Number(category.entryCount) || 0;

        }


        if (
            typeof category.entriesCount !== 'undefined'
        ) {

            return Number(category.entriesCount) || 0;

        }


        if (
            typeof category.transactionCount !== 'undefined'
        ) {

            return Number(category.transactionCount) || 0;

        }


        if (
            typeof category.incomeExpenseCount !== 'undefined'
        ) {

            return Number(category.incomeExpenseCount) || 0;

        }


        return 0;

    }


    function queryString(params) {

        const query = [];


        Object.keys(params).forEach(function(key) {

            const value = params[key];


            if (
                value !== undefined &&
                value !== null &&
                value !== ''
            ) {

                query.push(
                    encodeURIComponent(key) +
                    '=' +
                    encodeURIComponent(value)
                );

            }

        });


        return query.join('&');

    }

%>


<%- include('../../adminlayout/header') %>


<style>

    /* =========================================================
       CATEGORY ICON
    ========================================================= */

    .category-icon {

        width: 42px;
        height: 42px;

        min-width: 42px;

        border-radius: 9px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        font-size: 18px;

    }


    /* =========================================================
       CATEGORY NAME
    ========================================================= */

    .category-name {

        max-width: 280px;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;

    }


    /* =========================================================
       CATEGORY TYPE
    ========================================================= */

    .category-type-badge {

        display: inline-flex;

        align-items: center;

        gap: 5px;

        font-size: 11px;

        font-weight: 700;

        padding: 5px 9px;

        border-radius: 6px;

    }


    /* =========================================================
       COUNT
    ========================================================= */

    .usage-count {

        min-width: 34px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        padding: 4px 8px;

        border-radius: 6px;

        background: #f5f6f8;

        color: #596273;

        font-size: 12px;

        font-weight: 700;

    }


    /* =========================================================
       FILTER MENU
    ========================================================= */

    .category-filter-menu {

        min-width: 280px;

    }


    /* =========================================================
       EMPTY STATE
    ========================================================= */

    .category-empty-state {

        padding: 65px 20px;

        text-align: center;

    }


    .category-empty-icon {

        width: 70px;

        height: 70px;

        border-radius: 50%;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        font-size: 30px;

        margin-bottom: 16px;

    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 767px) {

        .category-name {

            max-width: 180px;

        }

    }

</style>


<div class="page-wrapper">

    <div class="content pb-0">


        <!-- =====================================================
             ALERTS
        ====================================================== -->

        <% if (typeof success !== 'undefined' && success) { %>

            <div
                class="alert alert-success alert-dismissible fade show mb-4"
                role="alert"
            >

                <i class="ti ti-circle-check me-2"></i>

                <%= success %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% } %>


        <% if (typeof error !== 'undefined' && error) { %>

            <div
                class="alert alert-danger alert-dismissible fade show mb-4"
                role="alert"
            >

                <i class="ti ti-alert-circle me-2"></i>

                <%= error %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% } %>


        <% if (
            typeof errors !== 'undefined' &&
            Array.isArray(errors) &&
            errors.length
        ) { %>

            <div
                class="alert alert-danger alert-dismissible fade show mb-4"
                role="alert"
            >

                <ul class="mb-0 ps-3">

                    <% errors.forEach(function(err) { %>

                        <li>

                            <%= typeof err === 'string'
                                ? err
                                : (err.msg || err.message || 'Validation error.')
                            %>

                        </li>

                    <% }) %>

                </ul>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% } %>


        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">


            <div>

                <h4 class="mb-1">
                    Income &amp; Expense Categories
                </h4>


                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb mb-0 p-0">


                        <li class="breadcrumb-item">

                            <a href="/admin">
                                Home
                            </a>

                        </li>


                        <li class="breadcrumb-item">

                            <a href="/admin/income-expense">
                                Income &amp; Expense
                            </a>

                        </li>


                        <li
                            class="breadcrumb-item active"
                            aria-current="page"
                        >

                            Categories

                        </li>

                    </ol>

                </nav>

            </div>


            <!-- HEADER ACTIONS -->

            <div class="d-flex align-items-center gap-2 flex-wrap">


                <!-- REFRESH -->

                <a
                    href="javascript:location.reload();"
                    class="btn btn-icon btn-outline-light shadow"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    title="Refresh"
                >

                    <i class="ti ti-refresh"></i>

                </a>


                <!-- COLLAPSE -->

                <a
                    href="javascript:void(0);"
                    class="btn btn-icon btn-outline-light shadow"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    title="Collapse"
                    id="collapse-header"
                >

                    <i class="ti ti-transition-top"></i>

                </a>


                <!-- ADD CATEGORY -->

                <a
                    href="/admin/income-expense/categories/create"
                    class="btn btn-primary"
                >

                    <i class="ti ti-plus me-1"></i>

                    Add Category

                </a>

            </div>

        </div>


        <!-- =====================================================
             SUMMARY CARDS
        ====================================================== -->

        <div class="row mb-4">


            <!-- TOTAL -->

            <div class="col-xl-4 col-md-6 mb-3">

                <div class="card h-100 mb-0">

                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">


                            <div>

                                <p class="text-muted mb-1">
                                    Total Categories
                                </p>

                                <h4 class="mb-0 fw-bold">

                                    <%= categoryList.length %>

                                </h4>

                            </div>


                            <span class="avatar avatar-lg bg-soft-primary text-primary">

                                <i class="ti ti-category"></i>

                            </span>


                        </div>

                    </div>

                </div>

            </div>


            <!-- INCOME -->

            <div class="col-xl-4 col-md-6 mb-3">

                <div class="card h-100 mb-0">

                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">


                            <div>

                                <p class="text-muted mb-1">
                                    Income Categories
                                </p>

                                <h4 class="mb-0 fw-bold text-success">

                                    <%= categoryList.filter(function(c) {
                                        return Number(c.type) === 1;
                                    }).length %>

                                </h4>

                            </div>


                            <span class="avatar avatar-lg bg-soft-success text-success">

                                <i class="ti ti-trending-up"></i>

                            </span>


                        </div>

                    </div>

                </div>

            </div>


            <!-- EXPENSE -->

            <div class="col-xl-4 col-md-6 mb-3">

                <div class="card h-100 mb-0">

                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">


                            <div>

                                <p class="text-muted mb-1">
                                    Expense Categories
                                </p>

                                <h4 class="mb-0 fw-bold text-danger">

                                    <%= categoryList.filter(function(c) {
                                        return Number(c.type) === 2;
                                    }).length %>

                                </h4>

                            </div>


                            <span class="avatar avatar-lg bg-soft-danger text-danger">

                                <i class="ti ti-trending-down"></i>

                            </span>


                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             MAIN CARD
        ====================================================== -->

        <div class="card border-0 rounded-0">


            <!-- =================================================
                 CARD HEADER
            ================================================== -->

            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">


                <!-- SEARCH -->

                <form
                    method="GET"
                    action="/admin/income-expense/categories"
                    class="d-flex align-items-center gap-2 mb-0"
                >


                    <div class="input-icon input-icon-start position-relative">

                        <span class="input-icon-addon">

                            <i class="ti ti-search"></i>

                        </span>


                        <input
                            type="text"
                            name="search"
                            value="<%= searchValue %>"
                            class="form-control"
                            placeholder="Search category..."
                        >

                    </div>


                    <input
                        type="hidden"
                        name="type"
                        value="<%= typeValue %>"
                    >


                    <button
                        type="submit"
                        class="btn btn-primary"
                    >

                        <i class="ti ti-search me-1"></i>

                        Search

                    </button>


                    <% if (searchValue || typeValue) { %>

                        <a
                            href="/admin/income-expense/categories"
                            class="btn btn-link text-muted text-decoration-none"
                        >

                            Clear

                        </a>

                    <% } %>

                </form>


                <!-- TOTAL -->

                <div class="text-muted small">

                    <%= categoryList.length %>
                    categor<%= categoryList.length === 1 ? 'y' : 'ies' %>

                </div>

            </div>


            <!-- =================================================
                 TOOLBAR
            ================================================== -->

            <div class="card-body border-bottom py-3">

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">


                    <!-- SORT -->

                    <div class="dropdown">

                        <a
                            href="javascript:void(0);"
                            class="dropdown-toggle btn btn-outline-light shadow"
                            data-bs-toggle="dropdown"
                        >

                            <i class="ti ti-sort-ascending-2 me-2"></i>

                            Sort By

                        </a>


                        <div class="dropdown-menu">

                            <ul>


                                <!-- NAME ASC -->

                                <li>

                                    <a
                                        href="/admin/income-expense/categories?<%= queryString({
                                            search: searchValue,
                                            type: typeValue,
                                            sort: 'name_asc'
                                        }) %>"
                                        class="dropdown-item"
                                    >

                                        <i class="ti ti-sort-ascending-letters me-2"></i>

                                        Name A-Z

                                    </a>

                                </li>


                                <!-- NAME DESC -->

                                <li>

                                    <a
                                        href="/admin/income-expense/categories?<%= queryString({
                                            search: searchValue,
                                            type: typeValue,
                                            sort: 'name_desc'
                                        }) %>"
                                        class="dropdown-item"
                                    >

                                        <i class="ti ti-sort-descending-letters me-2"></i>

                                        Name Z-A

                                    </a>

                                </li>


                                <!-- NEWEST -->

                                <li>

                                    <a
                                        href="/admin/income-expense/categories?<%= queryString({
                                            search: searchValue,
                                            type: typeValue,
                                            sort: 'newest'
                                        }) %>"
                                        class="dropdown-item"
                                    >

                                        <i class="ti ti-calendar-up me-2"></i>

                                        Newest

                                    </a>

                                </li>


                                <!-- OLDEST -->

                                <li>

                                    <a
                                        href="/admin/income-expense/categories?<%= queryString({
                                            search: searchValue,
                                            type: typeValue,
                                            sort: 'oldest'
                                        }) %>"
                                        class="dropdown-item"
                                    >

                                        <i class="ti ti-calendar-down me-2"></i>

                                        Oldest

                                    </a>

                                </li>


                            </ul>

                        </div>

                    </div>


                    <!-- RIGHT -->

                    <div class="d-flex align-items-center gap-2 flex-wrap">


                        <!-- FILTER -->

                        <div class="dropdown">

                            <a
                                href="javascript:void(0);"
                                class="btn btn-outline-light shadow dropdown-toggle"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                            >

                                <i class="ti ti-filter me-2"></i>

                                Filter

                                <% if (typeValue) { %>

                                    <span class="badge bg-primary ms-1">
                                        1
                                    </span>

                                <% } %>

                            </a>


                            <div class="dropdown-menu dropdown-menu-end p-3 category-filter-menu">


                                <form
                                    method="GET"
                                    action="/admin/income-expense/categories"
                                >


                                    <!-- SEARCH -->

                                    <div class="mb-3">

                                        <label class="form-label">
                                            Search
                                        </label>

                                        <input
                                            type="text"
                                            name="search"
                                            value="<%= searchValue %>"
                                            class="form-control"
                                            placeholder="Category name..."
                                        >

                                    </div>


                                    <!-- TYPE -->

                                    <div class="mb-3">

                                        <label class="form-label">
                                            Category Type
                                        </label>


                                        <select
                                            name="type"
                                            class="form-select"
                                        >

                                            <option value="">
                                                All Categories
                                            </option>


                                            <option
                                                value="1"
                                                <%= typeValue === '1' || Number(typeValue) === 1 ? 'selected' : '' %>
                                            >

                                                Income

                                            </option>


                                            <option
                                                value="2"
                                                <%= typeValue === '2' || Number(typeValue) === 2 ? 'selected' : '' %>
                                            >

                                                Expense

                                            </option>

                                        </select>

                                    </div>


                                    <!-- APPLY -->

                                    <div class="d-flex gap-2">

                                        <button
                                            type="submit"
                                            class="btn btn-primary flex-fill"
                                        >

                                            Apply

                                        </button>


                                        <a
                                            href="/admin/income-expense/categories"
                                            class="btn btn-light flex-fill"
                                        >

                                            Clear

                                        </a>

                                    </div>

                                </form>

                            </div>

                        </div>


                        <!-- MANAGE COLUMNS -->

                        <div class="dropdown">

                            <a
                                href="javascript:void(0);"
                                class="btn bg-soft-indigo border-0"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                            >

                                <i class="ti ti-columns-3 me-2"></i>

                                Manage Columns

                            </a>


                            <div class="dropdown-menu dropdown-menu-md dropdown-menu-end p-3">


                                <ul class="list-unstyled mb-0">


                                    <!-- CATEGORY -->

                                    <li class="d-flex align-items-center gap-1 mb-2">

                                        <i class="ti ti-category me-1"></i>


                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Category
                                                </span>


                                                <input
                                                    type="checkbox"
                                                    class="form-check-input category-column-toggle ms-auto"
                                                    data-column="0"
                                                    data-key="category"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- TYPE -->

                                    <li class="d-flex align-items-center gap-1 mb-2">

                                        <i class="ti ti-arrows-transfer-up me-1"></i>


                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Type
                                                </span>


                                                <input
                                                    type="checkbox"
                                                    class="form-check-input category-column-toggle ms-auto"
                                                    data-column="1"
                                                    data-key="type"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- TRANSACTIONS -->

                                    <li class="d-flex align-items-center gap-1 mb-2">

                                        <i class="ti ti-receipt me-1"></i>


                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Transactions
                                                </span>


                                                <input
                                                    type="checkbox"
                                                    class="form-check-input category-column-toggle ms-auto"
                                                    data-column="2"
                                                    data-key="transactions"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- CREATED -->

                                    <li class="d-flex align-items-center gap-1 mb-2">

                                        <i class="ti ti-calendar me-1"></i>


                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    ID
                                                </span>


                                                <input
                                                    type="checkbox"
                                                    class="form-check-input category-column-toggle ms-auto"
                                                    data-column="3"
                                                    data-key="id"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- ACTION -->

                                    <li class="d-flex align-items-center gap-1">

                                        <i class="ti ti-settings me-1"></i>


                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Action
                                                </span>


                                                <input
                                                    type="checkbox"
                                                    class="form-check-input ms-auto"
                                                    checked
                                                    disabled
                                                >

                                            </label>

                                        </div>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 TABLE
            ================================================== -->

            <div class="card-body pt-0">

                <div class="table-responsive custom-table">


                    <table
                        class="table table-nowrap"
                        id="income-expense-categories-table"
                    >


                        <thead class="table-light">

                            <tr>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Transactions
                                </th>

                                <th>
                                    ID
                                </th>

                                <th class="text-end no-sort">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <% if (categoryList.length) { %>


                                <% categoryList.forEach(function(category) { %>


                                    <tr>


                                        <!-- CATEGORY -->

                                        <td>

                                            <div class="d-flex align-items-center gap-3">


                                                <span
                                                    class="category-icon <%= getTypeIconClass(category.type) %>"
                                                >

                                                    <i
                                                        class="ti <%= getTypeIcon(category.type) %>"
                                                    ></i>

                                                </span>


                                                <div class="min-w-0">


                                                    <h6
                                                        class="mb-0 fw-semibold category-name"
                                                        title="<%= category.name %>"
                                                    >

                                                        <%= category.name %>

                                                    </h6>


                                                    <small class="text-muted">

                                                        Personal category

                                                    </small>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- TYPE -->

                                        <td>

                                            <span
                                                class="category-type-badge <%= getTypeClass(category.type) %>"
                                            >

                                                <i
                                                    class="ti <%= getTypeIcon(category.type) %>"
                                                ></i>


                                                <%= getTypeLabel(category.type) %>

                                            </span>

                                        </td>


                                        <!-- TRANSACTIONS -->

                                        <td>

                                            <span class="usage-count">

                                                <%= getEntryCount(category) %>

                                            </span>


                                            <span class="text-muted small ms-1">

                                                transaction<%= getEntryCount(category) === 1 ? '' : 's' %>

                                            </span>

                                        </td>


                                        <!-- ID -->

                                        <td>

                                            <span class="text-muted small">

                                                #<%= category.id %>

                                            </span>

                                        </td>


                                        <!-- ACTION -->

                                        <td class="text-end">


                                            <div class="dropdown">


                                                <a
                                                    href="javascript:void(0);"
                                                    class="btn btn-icon btn-sm"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false"
                                                    title="Actions"
                                                >

                                                    <i class="ti ti-dots-vertical"></i>

                                                </a>


                                                <ul class="dropdown-menu dropdown-menu-end">


                                                    <!-- EDIT -->

                                                    <li>

                                                        <a
                                                            href="/admin/income-expense/categories/<%= category.id %>/edit"
                                                            class="dropdown-item"
                                                        >

                                                            <i class="ti ti-edit me-2"></i>

                                                            Edit Category

                                                        </a>

                                                    </li>


                                                    <!-- DELETE -->

                                                    <li>

                                                        <a
                                                            href="javascript:void(0);"
                                                            class="dropdown-item text-danger delete-category-btn"
                                                            data-id="<%= category.id %>"
                                                            data-name="<%= category.name %>"
                                                            data-count="<%= getEntryCount(category) %>"
                                                        >

                                                            <i class="ti ti-trash me-2"></i>

                                                            Delete Category

                                                        </a>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>


                                <% }) %>


                            <% } else { %>


                                <!-- EMPTY -->

                                <tr>

                                    <td
                                        colspan="5"
                                        class="text-center"
                                    >


                                        <div class="category-empty-state">


                                            <div class="category-empty-icon bg-soft-primary text-primary">

                                                <i class="ti ti-category-off"></i>

                                            </div>


                                            <h5 class="mb-1">

                                                No Categories Found

                                            </h5>


                                            <p class="text-muted mb-3">

                                                No income or expense categories
                                                match your current filters.

                                            </p>


                                            <% if (searchValue || typeValue) { %>

                                                <a
                                                    href="/admin/income-expense/categories"
                                                    class="btn btn-light btn-sm"
                                                >

                                                    <i class="ti ti-filter-off me-1"></i>

                                                    Clear Filters

                                                </a>

                                            <% } else { %>

                                                <a
                                                    href="/admin/income-expense/categories/create"
                                                    class="btn btn-primary btn-sm"
                                                >

                                                    <i class="ti ti-plus me-1"></i>

                                                    Add First Category

                                                </a>

                                            <% } %>


                                        </div>


                                    </td>

                                </tr>


                            <% } %>


                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     DELETE MODAL
============================================================== -->

<div
    class="modal fade"
    id="deleteCategoryModal"
    tabindex="-1"
    aria-hidden="true"
>


    <div class="modal-dialog modal-dialog-centered">


        <div class="modal-content">


            <div class="modal-header">

                <h5 class="modal-title">

                    Delete Category

                </h5>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <div class="modal-body">


                <div class="text-center py-2">


                    <div class="avatar avatar-xl bg-soft-danger text-danger mb-3">

                        <i class="ti ti-trash fs-24"></i>

                    </div>


                    <h5 class="mb-2">

                        Delete
                        <span id="deleteCategoryName">
                            Category
                        </span>
                        ?

                    </h5>


                    <p
                        class="text-muted mb-0"
                        id="deleteCategoryMessage"
                    >

                        Are you sure you want to delete this category?

                    </p>


                </div>

            </div>


            <div class="modal-footer">


                <button
                    type="button"
                    class="btn btn-light"
                    data-bs-dismiss="modal"
                >

                    Cancel

                </button>


                <form
                    method="POST"
                    id="deleteCategoryForm"
                    action=""
                    class="mb-0"
                >

                    <button
                        type="submit"
                        class="btn btn-danger"
                    >

                        <i class="ti ti-trash me-1"></i>

                        Delete Category

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<script>

document.addEventListener(
    'DOMContentLoaded',
    function () {


        /*
        |--------------------------------------------------------------------------
        | MANAGE COLUMNS
        |--------------------------------------------------------------------------
        */

        const table =
            document.getElementById(
                'income-expense-categories-table'
            );


        const toggles =
            document.querySelectorAll(
                '.category-column-toggle[data-column]'
            );


        function applyColumn(
            columnIndex,
            visible
        ) {

            if (!table) {
                return;
            }


            table
                .querySelectorAll('tr')
                .forEach(
                    function(row) {

                        const cell =
                            row.children[
                                columnIndex
                            ];


                        if (!cell) {
                            return;
                        }


                        if (visible) {

                            cell.style.removeProperty(
                                'display'
                            );

                        } else {

                            cell.style.setProperty(
                                'display',
                                'none',
                                'important'
                            );

                        }

                    }
                );

        }


        toggles.forEach(
            function(toggle) {


                const column =
                    parseInt(
                        toggle.dataset.column,
                        10
                    );


                const key =
                    toggle.dataset.key ||
                    column;


                const storageKey =
                    'income_expense_category_col_' +
                    key;


                /*
                |--------------------------------------------------------------------------
                | RESTORE
                |--------------------------------------------------------------------------
                */

                const saved =
                    localStorage.getItem(
                        storageKey
                    );


                if (saved === '0') {

                    toggle.checked =
                        false;

                    applyColumn(
                        column,
                        false
                    );

                }


                /*
                |--------------------------------------------------------------------------
                | CHANGE
                |--------------------------------------------------------------------------
                */

                toggle.addEventListener(
                    'change',
                    function() {

                        const visible =
                            this.checked;


                        localStorage.setItem(
                            storageKey,
                            visible
                                ? '1'
                                : '0'
                        );


                        applyColumn(
                            column,
                            visible
                        );

                    }
                );

            }
        );


        /*
        |--------------------------------------------------------------------------
        | DELETE CATEGORY
        |--------------------------------------------------------------------------
        */

        const deleteModalElement =
            document.getElementById(
                'deleteCategoryModal'
            );


        const deleteModal =
            deleteModalElement &&
            typeof bootstrap !== 'undefined'
                ? new bootstrap.Modal(
                    deleteModalElement
                )
                : null;


        const deleteForm =
            document.getElementById(
                'deleteCategoryForm'
            );


        const deleteName =
            document.getElementById(
                'deleteCategoryName'
            );


        const deleteMessage =
            document.getElementById(
                'deleteCategoryMessage'
            );


        document
            .querySelectorAll(
                '.delete-category-btn'
            )
            .forEach(
                function(button) {


                    button.addEventListener(
                        'click',
                        function() {


                            const id =
                                this.dataset.id;


                            const name =
                                this.dataset.name ||
                                'Category';


                            const count =
                                parseInt(
                                    this.dataset.count || '0',
                                    10
                                );


                            /*
                            |--------------------------------------------------------------------------
                            | Modal Content
                            |--------------------------------------------------------------------------
                            */

                            if (deleteName) {

                                deleteName.textContent =
                                    '"' + name + '"';

                            }


                            if (deleteMessage) {

                                if (count > 0) {

                                    deleteMessage.innerHTML =
                                        'This category is currently used by <strong>' +
                                        count +
                                        '</strong> transaction' +
                                        (
                                            count === 1
                                                ? ''
                                                : 's'
                                        ) +
                                        '. It cannot be deleted until those transactions are moved or removed.';

                                } else {

                                    deleteMessage.textContent =
                                        'Are you sure you want to delete this category? This action cannot be undone.';

                                }

                            }


                            /*
                            |--------------------------------------------------------------------------
                            | Form Action
                            |--------------------------------------------------------------------------
                            */

                            if (deleteForm) {

                                deleteForm.action =
                                    '/admin/income-expense/categories/' +
                                    id +
                                    '/delete';

                            }


                            /*
                            |--------------------------------------------------------------------------
                            | Disable Delete if Used
                            |--------------------------------------------------------------------------
                            */

                            const submitButton =
                                deleteForm
                                    ? deleteForm.querySelector(
                                        'button[type="submit"]'
                                    )
                                    : null;


                            if (submitButton) {

                                if (count > 0) {

                                    submitButton.disabled =
                                        true;

                                    submitButton.innerHTML =
                                        '<i class="ti ti-lock me-1"></i> Cannot Delete';

                                } else {

                                    submitButton.disabled =
                                        false;

                                    submitButton.innerHTML =
                                        '<i class="ti ti-trash me-1"></i> Delete Category';

                                }

                            }


                            if (deleteModal) {

                                deleteModal.show();

                            }

                        }
                    );

                }
            );


    }
);

</script>


<%- include('../../adminlayout/footer') %>