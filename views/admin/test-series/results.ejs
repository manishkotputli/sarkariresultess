<%- include('../../adminlayout/header') %>

<%
    const currentSeries =
        typeof series !== 'undefined' && series
            ? series
            : {};

    const testItems =
        Array.isArray(tests)
            ? tests
            : [];

    const attemptItems =
        Array.isArray(attempts)
            ? attempts
            : [];

    const currentFilters =
        typeof filters !== 'undefined' && filters
            ? filters
            : {};

    const currentTestFilter =
        typeof currentFilters.test !== 'undefined'
            ? currentFilters.test
            : '';

    const currentUserFilter =
        typeof currentFilters.user !== 'undefined'
            ? currentFilters.user
            : '';

    const currentSort =
        typeof currentFilters.sort !== 'undefined'
            ? currentFilters.sort
            : '';

    const totalAttempts =
        typeof total !== 'undefined'
            ? total
            : attemptItems.length;

    const pageData =
        typeof pagination !== 'undefined' && pagination
            ? pagination
            : {
                page: 1,
                totalPages: 1,
                hasPrev: false,
                hasNext: false,
                pages: [1]
            };
%>


<div class="page-wrapper">

    <!-- Start Content -->
    <div class="content pb-0">


        <!-- =====================================================
             ALERTS
        ====================================================== -->

        <% if (typeof success !== 'undefined' && success) { %>

            <div class="alert alert-success alert-dismissible fade show mb-4"
                 role="alert">

                <%= success %>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>

            </div>

        <% } %>


        <% if (typeof errors !== 'undefined' &&
               errors &&
               errors.length) { %>

            <div class="alert alert-danger alert-dismissible fade show mb-4"
                 role="alert">

                <ul class="mb-0">

                    <% errors.forEach(function(err) { %>

                        <li>

                            <%= typeof err === 'string'
                                ? err
                                : (err.msg || err.message || 'Something went wrong.') %>

                        </li>

                    <% }) %>

                </ul>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>

            </div>

        <% } %>


        <% if (typeof error !== 'undefined' && error) { %>

            <div class="alert alert-danger alert-dismissible fade show mb-4"
                 role="alert">

                <%= error %>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>

            </div>

        <% } %>



        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">

            <div>

                <h4 class="mb-1">
                    Test Series Results
                </h4>

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb mb-0 p-0">

                        <li class="breadcrumb-item">

                            <a href="/admin">
                                Home
                            </a>

                        </li>

                        <li class="breadcrumb-item">

                            <a href="/admin/test-series">
                                Test Series
                            </a>

                        </li>

                        <li class="breadcrumb-item active"
                            aria-current="page">

                            Results

                        </li>

                    </ol>

                </nav>

            </div>


            <div class="gap-2 d-flex align-items-center flex-wrap">


                <!-- =================================================
                     BACK
                ================================================== -->

                <a href="/admin/test-series/<%= currentSeries.id %>/tests"
                   class="btn btn-outline-light shadow">

                    <i class="ti ti-arrow-left me-1"></i>

                    Back to Tests

                </a>



                <!-- =================================================
                     EXPORT
                ================================================== -->

                <div class="dropdown">

                    <a href="javascript:void(0);"
                       class="dropdown-toggle btn btn-outline-light px-2 shadow"
                       data-bs-toggle="dropdown">

                        <i class="ti ti-package-export me-2"></i>

                        Export

                    </a>


                    <div class="dropdown-menu dropdown-menu-end">

                        <ul>

                            <li>

                                <a href="/admin/test-series/<%= currentSeries.id %>/results/export/pdf"
                                   class="dropdown-item">

                                    <i class="ti ti-file-type-pdf me-1"></i>

                                    Export as PDF

                                </a>

                            </li>


                            <li>

                                <a href="/admin/test-series/<%= currentSeries.id %>/results/export/excel"
                                   class="dropdown-item">

                                    <i class="ti ti-file-type-xls me-1"></i>

                                    Export as Excel

                                </a>

                            </li>

                        </ul>

                    </div>

                </div>



                <!-- =================================================
                     REFRESH
                ================================================== -->

                <a href="javascript:location.reload();"
                   class="btn btn-icon btn-outline-light shadow"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   aria-label="Refresh"
                   data-bs-original-title="Refresh">

                    <i class="ti ti-refresh"></i>

                </a>



                <!-- =================================================
                     COLLAPSE
                ================================================== -->

                <a href="javascript:void(0);"
                   class="btn btn-icon btn-outline-light shadow"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   aria-label="Collapse"
                   data-bs-original-title="Collapse"
                   id="collapse-header">

                    <i class="ti ti-transition-top"></i>

                </a>

            </div>

        </div>



        <!-- =====================================================
             SERIES SUMMARY
        ====================================================== -->

        <div class="card border-0 rounded-0 mb-3">

            <div class="card-body">

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

                    <div>

                        <h5 class="mb-1">

                            Results -
                            <%= currentSeries.title || 'Test Series' %>

                        </h5>

                        <p class="mb-0 text-muted">

                            <%= totalAttempts %>
                            attempt<%= totalAttempts === 1 ? '' : 's' %>
                            across all tests in this series.

                        </p>

                    </div>


                    <div class="d-flex align-items-center gap-2">

                        <span class="badge bg-soft-primary text-primary">

                            <i class="ti ti-users me-1"></i>

                            <%= totalAttempts %>
                            Attempts

                        </span>

                    </div>

                </div>

            </div>

        </div>



        <!-- =====================================================
             RESULTS CARD
        ====================================================== -->

        <div class="card border-0 rounded-0">


            <!-- =================================================
                 CARD HEADER
            ================================================== -->

            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">


                <!-- FILTER FORM -->

                <form method="GET"
                      action="/admin/test-series/<%= currentSeries.id %>/results"
                      class="mb-0">

                    <div class="d-flex align-items-center gap-2 flex-wrap">


                        <!-- TEST FILTER -->

                        <select name="test"
                                class="form-select"
                                style="min-width:220px;"
                                onchange="this.form.submit()">

                            <option value="">
                                All Tests
                            </option>


                            <% testItems.forEach(function(t) { %>

                                <option value="<%= t.id %>"
                                    <%= String(currentTestFilter) === String(t.id)
                                        ? 'selected'
                                        : '' %>>

                                    Test <%= t.test_number %>:
                                    <%= t.title %>

                                </option>

                            <% }) %>

                        </select>


                        <!-- USER SEARCH -->

                        <input type="text"
                               name="user"
                               value="<%= currentUserFilter %>"
                               class="form-control"
                               placeholder="Search user..."
                               style="min-width:200px;">


                        <input type="hidden"
                               name="sort"
                               value="<%= currentSort %>">


                        <button type="submit"
                                class="btn btn-primary">

                            <i class="ti ti-filter me-1"></i>

                            Apply

                        </button>


                        <% if (currentTestFilter || currentUserFilter || currentSort) { %>

                            <a href="/admin/test-series/<%= currentSeries.id %>/results"
                               class="btn btn-light">

                                Clear

                            </a>

                        <% } %>

                    </div>

                </form>


                <!-- TOTAL -->

                <div class="d-flex align-items-center gap-2">

                    <span class="text-muted fs-13">

                        Total:

                    </span>

                    <strong>

                        <%= totalAttempts %>

                    </strong>

                </div>

            </div>



            <!-- =================================================
                 CARD BODY
            ================================================== -->

            <div class="card-body">


                <!-- =================================================
                     TABLE TOOLS
                ================================================== -->

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">


                    <!-- SORT -->

                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <div class="dropdown">

                            <a href="javascript:void(0);"
                               class="dropdown-toggle btn btn-outline-light shadow"
                               data-bs-toggle="dropdown">

                                <i class="ti ti-sort-ascending-2 me-2"></i>

                                Sort By

                            </a>


                            <div class="dropdown-menu">

                                <ul>


                                    <!-- NEWEST -->

                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/results?sort=newest&test=<%= encodeURIComponent(currentTestFilter) %>&user=<%= encodeURIComponent(currentUserFilter) %>"
                                           class="dropdown-item">

                                            Newest First

                                        </a>

                                    </li>


                                    <!-- OLDEST -->

                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/results?sort=oldest&test=<%= encodeURIComponent(currentTestFilter) %>&user=<%= encodeURIComponent(currentUserFilter) %>"
                                           class="dropdown-item">

                                            Oldest First

                                        </a>

                                    </li>


                                    <!-- SCORE HIGH -->

                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/results?sort=score_desc&test=<%= encodeURIComponent(currentTestFilter) %>&user=<%= encodeURIComponent(currentUserFilter) %>"
                                           class="dropdown-item">

                                            Score (High to Low)

                                        </a>

                                    </li>


                                    <!-- SCORE LOW -->

                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/results?sort=score_asc&test=<%= encodeURIComponent(currentTestFilter) %>&user=<%= encodeURIComponent(currentUserFilter) %>"
                                           class="dropdown-item">

                                            Score (Low to High)

                                        </a>

                                    </li>


                                    <!-- USER -->

                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/results?sort=user_asc&test=<%= encodeURIComponent(currentTestFilter) %>&user=<%= encodeURIComponent(currentUserFilter) %>"
                                           class="dropdown-item">

                                            User (A-Z)

                                        </a>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>



                    <!-- RIGHT TOOLS -->

                    <div class="d-flex align-items-center gap-2 flex-wrap">


                        <!-- =================================================
                             MANAGE COLUMNS
                        ================================================== -->

                        <div class="dropdown">

                            <a href="javascript:void(0);"
                               class="btn bg-soft-indigo border-0"
                               data-bs-toggle="dropdown"
                               data-bs-auto-close="outside">

                                <i class="ti ti-columns-3 me-2"></i>

                                Manage Columns

                            </a>


                            <div class="dropdown-menu dropdown-menu-md dropdown-md p-3">

                                <ul class="list-unstyled mb-0">


                                    <!-- USER -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    User
                                                </span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="0"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>



                                    <!-- TEST -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Test
                                                </span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="1"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>



                                    <!-- CORRECT -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Correct
                                                </span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="2"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>



                                    <!-- WRONG -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Wrong
                                                </span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="3"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>



                                    <!-- UNATTEMPTED -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Unattempted
                                                </span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="4"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>



                                    <!-- SCORE -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Score
                                                </span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="5"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>



                                    <!-- SUBMITTED -->

                                    <li class="gap-1 d-flex align-items-center mb-0">

                                        <i class="ti ti-columns me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>
                                                    Submitted
                                                </span>

                                                <input class="form-check-input column-toggle ms-auto"
                                                       type="checkbox"
                                                       data-column="6"
                                                       checked>

                                            </label>

                                        </div>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     RESULTS TABLE
                ================================================== -->

                <div class="table-responsive custom-table">

                    <table class="table table-nowrap"
                           id="test-results-table">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    User
                                </th>

                                <th>
                                    Test
                                </th>

                                <th>
                                    Correct
                                </th>

                                <th>
                                    Wrong
                                </th>

                                <th>
                                    Unattempted
                                </th>

                                <th>
                                    Score
                                </th>

                                <th>
                                    Submitted
                                </th>

                                <th class="text-end no-sort">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <% if (attemptItems.length) { %>


                                <% attemptItems.forEach(function(a) { %>

                                    <tr>


                                        <!-- =================================================
                                             USER
                                        ================================================== -->

                                        <td>

                                            <div class="d-flex align-items-center">

                                                <div class="avatar avatar-md avatar-soft-primary me-2">

                                                    <span>

                                                        <%= a.User
                                                            ? (a.User.name || 'U').charAt(0).toUpperCase()
                                                            : 'U' %>

                                                    </span>

                                                </div>


                                                <div>

                                                    <h6 class="mb-1">

                                                        <%= a.User
                                                            ? a.User.name
                                                            : '—' %>

                                                    </h6>


                                                    <% if (a.User && a.User.email) { %>

                                                        <p class="mb-0 text-muted fs-12">

                                                            <%= a.User.email %>

                                                        </p>

                                                    <% } %>

                                                </div>

                                            </div>

                                        </td>



                                        <!-- =================================================
                                             TEST
                                        ================================================== -->

                                        <td>

                                            <% if (a.Test) { %>

                                                <div>

                                                    <span class="fw-semibold text-dark">

                                                        Test
                                                        <%= a.Test.test_number %>

                                                    </span>

                                                    <p class="mb-0 text-muted fs-12">

                                                        <%= a.Test.title %>

                                                    </p>

                                                </div>

                                            <% } else { %>

                                                <span class="text-muted">
                                                    —
                                                </span>

                                            <% } %>

                                        </td>



                                        <!-- =================================================
                                             CORRECT
                                        ================================================== -->

                                        <td>

                                            <span class="badge bg-soft-success text-success">

                                                <i class="ti ti-check me-1"></i>

                                                <%= a.correct_count || 0 %>

                                            </span>

                                        </td>



                                        <!-- =================================================
                                             WRONG
                                        ================================================== -->

                                        <td>

                                            <span class="badge bg-soft-danger text-danger">

                                                <i class="ti ti-x me-1"></i>

                                                <%= a.wrong_count || 0 %>

                                            </span>

                                        </td>



                                        <!-- =================================================
                                             UNATTEMPTED
                                        ================================================== -->

                                        <td>

                                            <span class="badge bg-soft-secondary text-secondary">

                                                <i class="ti ti-minus me-1"></i>

                                                <%= a.unattempted_count || 0 %>

                                            </span>

                                        </td>



                                        <!-- =================================================
                                             SCORE
                                        ================================================== -->

                                        <td>

                                            <div>

                                                <span class="fw-bold text-dark">

                                                    <%= a.score %>

                                                </span>

                                                <span class="text-muted fs-12">

                                                    /
                                                    <%= a.total_questions %>

                                                </span>

                                            </div>

                                        </td>



                                        <!-- =================================================
                                             SUBMITTED
                                        ================================================== -->

                                        <td>

                                            <% if (a.submitted_at) { %>

                                                <span class="text-muted">

                                                    <%= typeof formatDate === 'function'
                                                        ? formatDate(a.submitted_at)
                                                        : a.submitted_at %>

                                                </span>

                                            <% } else { %>

                                                <span class="text-muted">
                                                    —
                                                </span>

                                            <% } %>

                                        </td>



                                        <!-- =================================================
                                             ACTION
                                        ================================================== -->

                                        <td class="text-end">

                                            <div class="dropdown">

                                                <a href="javascript:void(0);"
                                                   class="btn btn-icon btn-sm"
                                                   data-bs-toggle="dropdown"
                                                   aria-expanded="false">

                                                    <i class="ti ti-dots-vertical"></i>

                                                </a>


                                                <ul class="dropdown-menu dropdown-menu-end">

                                                    <li>

                                                        <a href="javascript:void(0);"
                                                           class="dropdown-item text-danger deleteAttemptBtn"
                                                           data-bs-toggle="modal"
                                                           data-bs-target="#deleteAttemptModal"
                                                           data-id="<%= a.id %>">

                                                            <i class="ti ti-trash me-1"></i>

                                                            Remove Attempt

                                                        </a>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>


                                <% }) %>


                            <% } else { %>


                                <!-- =================================================
                                     EMPTY
                                ================================================== -->

                                <tr id="noResultsRow">

                                    <td colspan="8"
                                        class="text-center py-5">

                                        <div class="text-muted">

                                            <i class="ti ti-chart-bar fs-40 d-block mb-2"></i>

                                            <h5>
                                                No Results Found
                                            </h5>

                                            <p class="mb-2">

                                                There are no attempts available
                                                for this test series.

                                            </p>

                                        </div>

                                    </td>

                                </tr>


                            <% } %>

                        </tbody>

                    </table>

                </div>



                <!-- =================================================
                     PAGINATION
                ================================================== -->

                <% if (pageData.totalPages > 1) { %>

                    <div class="row align-items-center mt-3">


                        <!-- INFO -->

                        <div class="col-md-6">

                            <div class="text-muted">

                                Page

                                <%= pageData.page %>

                                of

                                <%= pageData.totalPages %>

                                &nbsp;·&nbsp;

                                <%= totalAttempts %>

                                total attempts

                            </div>

                        </div>



                        <!-- PAGINATION -->

                        <div class="col-md-6">

                            <div class="d-flex justify-content-end">

                                <ul class="pagination mb-0">


                                    <!-- PREVIOUS -->

                                    <% if (pageData.hasPrev) { %>

                                        <li class="page-item">

                                            <a class="page-link"
                                               href="/admin/test-series/<%= currentSeries.id %>/results?page=<%= pageData.page - 1 %>&test=<%= encodeURIComponent(currentTestFilter) %>&user=<%= encodeURIComponent(currentUserFilter) %>&sort=<%= encodeURIComponent(currentSort) %>">

                                                <i class="ti ti-chevron-left"></i>

                                            </a>

                                        </li>

                                    <% } %>



                                    <!-- PAGES -->

                                    <% if (Array.isArray(pageData.pages)) { %>

                                        <% pageData.pages.forEach(function(page) { %>

                                            <li class="page-item <%= page === pageData.page ? 'active' : '' %>">

                                                <a class="page-link"
                                                   href="/admin/test-series/<%= currentSeries.id %>/results?page=<%= page %>&test=<%= encodeURIComponent(currentTestFilter) %>&user=<%= encodeURIComponent(currentUserFilter) %>&sort=<%= encodeURIComponent(currentSort) %>">

                                                    <%= page %>

                                                </a>

                                            </li>

                                        <% }) %>

                                    <% } %>



                                    <!-- NEXT -->

                                    <% if (pageData.hasNext) { %>

                                        <li class="page-item">

                                            <a class="page-link"
                                               href="/admin/test-series/<%= currentSeries.id %>/results?page=<%= pageData.page + 1 %>&test=<%= encodeURIComponent(currentTestFilter) %>&user=<%= encodeURIComponent(currentUserFilter) %>&sort=<%= encodeURIComponent(currentSort) %>">

                                                <i class="ti ti-chevron-right"></i>

                                            </a>

                                        </li>

                                    <% } %>

                                </ul>

                            </div>

                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

</div>



<!-- =========================================================
     DELETE ATTEMPT MODAL
========================================================= -->

<div class="modal fade"
     id="deleteAttemptModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">


            <form method="POST"
                  id="deleteAttemptForm"
                  action="">


                <div class="modal-header">

                    <h5 class="modal-title">
                        Remove Attempt
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>

                </div>


                <div class="modal-body">

                    <div class="text-center">


                        <div class="mb-3">

                            <div class="avatar avatar-xl bg-soft-danger text-danger rounded-circle mx-auto">

                                <i class="ti ti-trash fs-30"></i>

                            </div>

                        </div>


                        <h5 class="mb-2">
                            Remove Attempt?
                        </h5>


                        <p class="text-muted mb-0">

                            This will clear the result and allow the user
                            to retake the test.

                            <br>

                            <strong>
                                This action cannot be undone.
                            </strong>

                        </p>

                    </div>

                </div>


                <div class="modal-footer justify-content-center">


                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-danger">

                        <i class="ti ti-trash me-1"></i>

                        Remove

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

document.addEventListener('DOMContentLoaded', function () {


    /*
     * =====================================================
     * DELETE ATTEMPT
     * =====================================================
     */

    document
        .querySelectorAll('.deleteAttemptBtn')
        .forEach(function (btn) {

            btn.addEventListener('click', function () {

                const id =
                    btn.getAttribute('data-id');


                const form =
                    document.getElementById(
                        'deleteAttemptForm'
                    );


                if (form) {

                    form.action =
                        '/admin/test-series/<%= currentSeries.id %>/results/'
                        + id
                        + '/delete';

                }

            });

        });



    /*
     * =====================================================
     * MANAGE COLUMNS
     * =====================================================
     */

    const toggles =
        document.querySelectorAll(
            '#test-results-table .column-toggle'
        );


    const table =
        document.getElementById(
            'test-results-table'
        );


    if (!table) {
        return;
    }


    /*
     * Update Column
     */

    function updateColumnVisibility(
        colIndex,
        isVisible
    ) {


        /*
         * Header
         */

        const th =
            table.querySelector(
                `thead tr th:nth-child(${colIndex + 1})`
            );


        if (th) {

            th.classList.toggle(
                'd-none',
                !isVisible
            );

        }


        /*
         * Body
         */

        const rows =
            table.querySelectorAll(
                'tbody tr'
            );


        rows.forEach(function (row) {


            /*
             * Empty row ignore
             */

            if (
                row.id ===
                'noResultsRow'
            ) {

                return;

            }


            const td =
                row.querySelector(
                    `td:nth-child(${colIndex + 1})`
                );


            if (td) {

                td.classList.toggle(
                    'd-none',
                    !isVisible
                );

            }

        });


        /*
         * Empty row colspan
         */

        const emptyTd =
            table.querySelector(
                '#noResultsRow td'
            );


        if (emptyTd) {

            const visibleColumns =
                table.querySelectorAll(
                    'thead tr th:not(.d-none)'
                ).length;


            emptyTd.setAttribute(
                'colspan',
                visibleColumns || 1
            );

        }

    }



    /*
     * =====================================================
     * RESTORE SAVED COLUMN SETTINGS
     * =====================================================
     */

    toggles.forEach(function (toggle) {


        const colIndex =
            parseInt(
                toggle.getAttribute(
                    'data-column'
                ),
                10
            );


        const storageKey =
            'test_results_col_' +
            colIndex;


        /*
         * Restore
         */

        const savedState =
            localStorage.getItem(
                storageKey
            );


        if (savedState !== null) {

            const isChecked =
                savedState === 'true';


            toggle.checked =
                isChecked;


            updateColumnVisibility(
                colIndex,
                isChecked
            );

        }


        /*
         * Change
         */

        toggle.addEventListener(
            'change',
            function () {


                const isChecked =
                    this.checked;


                updateColumnVisibility(
                    colIndex,
                    isChecked
                );


                localStorage.setItem(
                    storageKey,
                    isChecked
                );

            }
        );

    });



    /*
     * =====================================================
     * FEATHER ICONS
     * =====================================================
     */

    if (
        typeof feather !==
        'undefined'
    ) {

        feather.replace();

    }

});

</script>


