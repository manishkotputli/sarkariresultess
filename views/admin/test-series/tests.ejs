<%- include('../../adminlayout/header') %>

<%
    const currentSeries =
        typeof series !== 'undefined' && series
            ? series
            : {};

    const testItems =
        Array.isArray(tests)
            ? tests
            : [];

    const currentFilters =
        typeof filters !== 'undefined' && filters
            ? filters
            : {};

    const currentSearch =
        typeof currentFilters.search !== 'undefined'
            ? currentFilters.search
            : '';

    const currentStatus =
        typeof currentFilters.status !== 'undefined'
            ? currentFilters.status
            : '';

    const currentSort =
        typeof currentFilters.sort !== 'undefined'
            ? currentFilters.sort
            : '';

    const pageData =
        typeof pagination !== 'undefined' && pagination
            ? pagination
            : {
                page: 1,
                totalPages: 1,
                hasPrev: false,
                hasNext: false,
                pages: [1]
            };

    const totalItems =
        typeof total !== 'undefined'
            ? total
            : testItems.length;

    const nextNumber =
        typeof nextTestNumber !== 'undefined'
            ? nextTestNumber
            : (testItems.length + 1);
%>


<div class="page-wrapper">

    <!-- Start Content -->
    <div class="content pb-0">


        <!-- =====================================================
             ALERTS
        ====================================================== -->

        <% if (typeof success !== 'undefined' && success) { %>

            <div class="alert alert-success alert-dismissible fade show mb-4"
                 role="alert">

                <%= success %>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>

            </div>

        <% } %>


        <% if (typeof error !== 'undefined' && error) { %>

            <div class="alert alert-danger alert-dismissible fade show mb-4"
                 role="alert">

                <%= error %>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>

            </div>

        <% } %>


        <% if (typeof errors !== 'undefined' &&
               Array.isArray(errors) &&
               errors.length) { %>

            <div class="alert alert-danger alert-dismissible fade show mb-4"
                 role="alert">

                <ul class="mb-0">

                    <% errors.forEach(function(err) { %>

                        <li>
                            <%= typeof err === 'string'
                                ? err
                                : (err.msg || err.message || 'Something went wrong.') %>
                        </li>

                    <% }) %>

                </ul>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>

            </div>

        <% } %>



        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">

            <div>

                <h4 class="mb-1">
                    Tests
                </h4>

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb mb-0 p-0">

                        <li class="breadcrumb-item">

                            <a href="/admin">
                                Home
                            </a>

                        </li>

                        <li class="breadcrumb-item">

                            <a href="/admin/test-series">
                                Test Series
                            </a>

                        </li>

                        <li class="breadcrumb-item active"
                            aria-current="page">

                            Tests

                        </li>

                    </ol>

                </nav>

            </div>


            <div class="gap-2 d-flex align-items-center flex-wrap">


                <!-- BACK -->

                <a href="/admin/test-series"
                   class="btn btn-outline-light shadow">

                    <i class="ti ti-arrow-left me-1"></i>

                    Back

                </a>


                <!-- VIEW RESULTS -->

                <a href="/admin/test-series/<%= currentSeries.id %>/results"
                   class="btn btn-outline-light shadow">

                    <i class="ti ti-chart-bar me-1"></i>

                    Results

                </a>


                <!-- REFRESH -->

                <a href="javascript:location.reload();"
                   class="btn btn-icon btn-outline-light shadow"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   aria-label="Refresh"
                   data-bs-original-title="Refresh">

                    <i class="ti ti-refresh"></i>

                </a>


                <!-- COLLAPSE -->

                <a href="javascript:void(0);"
                   class="btn btn-icon btn-outline-light shadow"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   aria-label="Collapse"
                   data-bs-original-title="Collapse"
                   id="collapse-header">

                    <i class="ti ti-transition-top"></i>

                </a>


                <!-- ADD TEST -->

                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#addTestModal">

                    <i class="ti ti-square-rounded-plus-filled me-1"></i>

                    Add Test

                </button>

            </div>

        </div>



        <!-- =====================================================
             SERIES INFORMATION
        ====================================================== -->

        <div class="card border-0 rounded-0 mb-3">

            <div class="card-body">

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

                    <div>

                        <h5 class="mb-1">

                            <%= currentSeries.title || 'Test Series' %>

                        </h5>

                        <p class="text-muted mb-0">

                            Manage the individual tests inside this series.

                        </p>

                    </div>


                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <span class="badge bg-soft-primary text-primary">

                            <i class="ti ti-list-check me-1"></i>

                            <%= totalItems %>
                            Tests

                        </span>

                        <% if (currentSeries.is_active) { %>

                            <span class="badge bg-soft-success text-success">

                                <i class="ti ti-circle-check me-1"></i>

                                Active

                            </span>

                        <% } %>

                    </div>

                </div>

            </div>

        </div>



        <!-- =====================================================
             TEST CARD
        ====================================================== -->

        <div class="card border-0 rounded-0">


            <!-- =================================================
                 CARD HEADER
            ================================================== -->

            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">


                <!-- SEARCH -->

                <form method="GET"
                      action="/admin/test-series/<%= currentSeries.id %>/tests"
                      class="mb-0">

                    <div class="input-icon input-icon-start position-relative">

                        <span class="input-icon-addon text-dark">

                            <i class="ti ti-search"></i>

                        </span>


                        <input type="text"
                               name="search"
                               value="<%= currentSearch %>"
                               class="form-control"
                               id="testSearch"
                               placeholder="Search tests...">

                        <input type="hidden"
                               name="status"
                               value="<%= currentStatus %>">

                        <input type="hidden"
                               name="sort"
                               value="<%= currentSort %>">

                    </div>

                </form>



                <!-- RIGHT HEADER TOOLS -->

                <div class="d-flex align-items-center gap-2 flex-wrap">


                    <!-- FILTER -->

                    <div class="dropdown">

                        <a href="javascript:void(0);"
                           class="btn btn-filter"
                           data-bs-toggle="dropdown"
                           data-bs-auto-close="outside">

                            <i data-feather="filter"
                               class="filter-icon"></i>

                            <span>
                                Filter
                            </span>

                            <i data-feather="chevron-down"
                               class="ms-1"></i>

                        </a>


                        <div class="dropdown-menu dropdown-menu-end p-3"
                             style="min-width:280px;">

                            <form method="GET"
                                  action="/admin/test-series/<%= currentSeries.id %>/tests">


                                <!-- SEARCH -->

                                <div class="mb-3">

                                    <label class="form-label">
                                        Search
                                    </label>

                                    <input type="text"
                                           name="search"
                                           class="form-control"
                                           value="<%= currentSearch %>"
                                           placeholder="Search tests">

                                </div>


                                <!-- STATUS -->

                                <div class="mb-3">

                                    <label class="form-label">
                                        Status
                                    </label>

                                    <select name="status"
                                            class="form-select">

                                        <option value="">
                                            All Status
                                        </option>

                                        <option value="active"
                                            <%= currentStatus === 'active'
                                                ? 'selected'
                                                : '' %>>

                                            Active

                                        </option>

                                        <option value="inactive"
                                            <%= currentStatus === 'inactive'
                                                ? 'selected'
                                                : '' %>>

                                            Inactive

                                        </option>

                                    </select>

                                </div>


                                <!-- ACTION -->

                                <div class="d-flex justify-content-end gap-2">

                                    <a href="/admin/test-series/<%= currentSeries.id %>/tests"
                                       class="btn btn-light">

                                        Reset

                                    </a>


                                    <button type="submit"
                                            class="btn btn-primary">

                                        Apply

                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>



                    <!-- MANAGE COLUMNS -->

                    <div class="dropdown">

                        <a href="javascript:void(0);"
                           class="btn bg-soft-indigo border-0"
                           data-bs-toggle="dropdown"
                           data-bs-auto-close="outside">

                            <i class="ti ti-columns-3 me-2"></i>

                            Manage Columns

                        </a>


                        <div class="dropdown-menu dropdown-menu-md dropdown-md p-3">

                            <ul class="list-unstyled mb-0">


                                <!-- NUMBER -->

                                <li class="gap-1 d-flex align-items-center mb-2">

                                    <i class="ti ti-columns me-1"></i>

                                    <div class="form-check form-switch w-100 ps-0">

                                        <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                            <span>
                                                #
                                            </span>

                                            <input class="form-check-input column-toggle ms-auto"
                                                   type="checkbox"
                                                   data-column="0"
                                                   checked>

                                        </label>

                                    </div>

                                </li>


                                <!-- TEST -->

                                <li class="gap-1 d-flex align-items-center mb-2">

                                    <i class="ti ti-columns me-1"></i>

                                    <div class="form-check form-switch w-100 ps-0">

                                        <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                            <span>
                                                Test
                                            </span>

                                            <input class="form-check-input column-toggle ms-auto"
                                                   type="checkbox"
                                                   data-column="1"
                                                   checked>

                                        </label>

                                    </div>

                                </li>


                                <!-- DURATION -->

                                <li class="gap-1 d-flex align-items-center mb-2">

                                    <i class="ti ti-columns me-1"></i>

                                    <div class="form-check form-switch w-100 ps-0">

                                        <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                            <span>
                                                Duration
                                            </span>

                                            <input class="form-check-input column-toggle ms-auto"
                                                   type="checkbox"
                                                   data-column="2"
                                                   checked>

                                        </label>

                                    </div>

                                </li>


                                <!-- NEGATIVE -->

                                <li class="gap-1 d-flex align-items-center mb-2">

                                    <i class="ti ti-columns me-1"></i>

                                    <div class="form-check form-switch w-100 ps-0">

                                        <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                            <span>
                                                Negative Marking
                                            </span>

                                            <input class="form-check-input column-toggle ms-auto"
                                                   type="checkbox"
                                                   data-column="3"
                                                   checked>

                                        </label>

                                    </div>

                                </li>


                                <!-- QUESTIONS -->

                                <li class="gap-1 d-flex align-items-center mb-2">

                                    <i class="ti ti-columns me-1"></i>

                                    <div class="form-check form-switch w-100 ps-0">

                                        <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                            <span>
                                                Questions
                                            </span>

                                            <input class="form-check-input column-toggle ms-auto"
                                                   type="checkbox"
                                                   data-column="4"
                                                   checked>

                                        </label>

                                    </div>

                                </li>


                                <!-- ATTEMPTS -->

                                <li class="gap-1 d-flex align-items-center mb-2">

                                    <i class="ti ti-columns me-1"></i>

                                    <div class="form-check form-switch w-100 ps-0">

                                        <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                            <span>
                                                Attempts
                                            </span>

                                            <input class="form-check-input column-toggle ms-auto"
                                                   type="checkbox"
                                                   data-column="5"
                                                   checked>

                                        </label>

                                    </div>

                                </li>


                                <!-- STATUS -->

                                <li class="gap-1 d-flex align-items-center mb-0">

                                    <i class="ti ti-columns me-1"></i>

                                    <div class="form-check form-switch w-100 ps-0">

                                        <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                            <span>
                                                Status
                                            </span>

                                            <input class="form-check-input column-toggle ms-auto"
                                                   type="checkbox"
                                                   data-column="6"
                                                   checked>

                                        </label>

                                    </div>

                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>



            <!-- =================================================
                 CARD BODY
            ================================================== -->

            <div class="card-body">


                <!-- TABLE TOOLBAR -->

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">


                    <!-- SORT -->

                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <div class="dropdown">

                            <a href="javascript:void(0);"
                               class="dropdown-toggle btn btn-outline-light shadow"
                               data-bs-toggle="dropdown">

                                <i class="ti ti-sort-ascending-2 me-2"></i>

                                Sort By

                            </a>


                            <div class="dropdown-menu">

                                <ul>


                                    <!-- DEFAULT -->

                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/tests?search=<%= encodeURIComponent(currentSearch) %>&status=<%= encodeURIComponent(currentStatus) %>"
                                           class="dropdown-item">

                                            Default

                                        </a>

                                    </li>


                                    <!-- TEST NUMBER -->

                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/tests?sort=number_asc&search=<%= encodeURIComponent(currentSearch) %>&status=<%= encodeURIComponent(currentStatus) %>"
                                           class="dropdown-item">

                                            Test Number (Low to High)

                                        </a>

                                    </li>


                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/tests?sort=number_desc&search=<%= encodeURIComponent(currentSearch) %>&status=<%= encodeURIComponent(currentStatus) %>"
                                           class="dropdown-item">

                                            Test Number (High to Low)

                                        </a>

                                    </li>


                                    <!-- TITLE -->

                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/tests?sort=title_asc&search=<%= encodeURIComponent(currentSearch) %>&status=<%= encodeURIComponent(currentStatus) %>"
                                           class="dropdown-item">

                                            Title (A-Z)

                                        </a>

                                    </li>


                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/tests?sort=title_desc&search=<%= encodeURIComponent(currentSearch) %>&status=<%= encodeURIComponent(currentStatus) %>"
                                           class="dropdown-item">

                                            Title (Z-A)

                                        </a>

                                    </li>


                                    <!-- QUESTIONS -->

                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/tests?sort=questions_desc&search=<%= encodeURIComponent(currentSearch) %>&status=<%= encodeURIComponent(currentStatus) %>"
                                           class="dropdown-item">

                                            Questions (High to Low)

                                        </a>

                                    </li>


                                    <!-- ATTEMPTS -->

                                    <li>

                                        <a href="/admin/test-series/<%= currentSeries.id %>/tests?sort=attempts_desc&search=<%= encodeURIComponent(currentSearch) %>&status=<%= encodeURIComponent(currentStatus) %>"
                                           class="dropdown-item">

                                            Attempts (High to Low)

                                        </a>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>


                </div>



                <!-- =================================================
                     TABLE
                ================================================== -->

                <div class="table-responsive custom-table">

                    <table class="table table-nowrap"
                           id="tests-table">


                        <thead class="table-light">

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    Test
                                </th>

                                <th>
                                    Duration
                                </th>

                                <th>
                                    Negative Marking
                                </th>

                                <th>
                                    Questions
                                </th>

                                <th>
                                    Attempts
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end no-sort">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <% if (testItems.length) { %>


                                <% testItems.forEach(function(t) { %>

                                    <tr>


                                        <!-- =================================================
                                             NUMBER
                                        ================================================== -->

                                        <td>

                                            <span class="fw-semibold text-dark">

                                                #<%= t.test_number %>

                                            </span>

                                        </td>



                                        <!-- =================================================
                                             TEST
                                        ================================================== -->

                                        <td>

                                            <div class="d-flex align-items-center">

                                                <div class="avatar avatar-md avatar-soft-primary me-2">

                                                    <span>

                                                        <%= (t.title || 'T')
                                                            .charAt(0)
                                                            .toUpperCase() %>

                                                    </span>

                                                </div>


                                                <div>

                                                    <h6 class="mb-1">

                                                        <a href="/admin/test-series/<%= currentSeries.id %>/tests/<%= t.id %>/questions"
                                                           class="fw-semibold text-dark">

                                                            <%= t.title %>

                                                        </a>

                                                    </h6>


                                                    <p class="mb-0 text-muted fs-12">

                                                        Test <%= t.test_number %>

                                                    </p>

                                                </div>

                                            </div>

                                        </td>



                                        <!-- =================================================
                                             DURATION
                                        ================================================== -->

                                        <td>

                                            <%
                                                const testDuration =
                                                    t.duration_minutes ||
                                                    currentSeries.default_duration_minutes;
                                            %>

                                            <% if (testDuration) { %>

                                                <span class="text-dark">

                                                    <%= testDuration %> min

                                                </span>

                                            <% } else { %>

                                                <span class="text-muted">
                                                    —
                                                </span>

                                            <% } %>

                                        </td>



                                        <!-- =================================================
                                             NEGATIVE MARKING
                                        ================================================== -->

                                        <td>

                                            <%
                                                const negativeMarking =
                                                    t.negative_marking !== null &&
                                                    typeof t.negative_marking !== 'undefined'
                                                        ? t.negative_marking
                                                        : currentSeries.default_negative_marking;
                                            %>

                                            <span class="text-dark">

                                                -<%= typeof negativeMarking !== 'undefined'
                                                    ? negativeMarking
                                                    : 0 %>

                                            </span>

                                            <span class="text-muted fs-12">
                                                / wrong
                                            </span>

                                        </td>



                                        <!-- =================================================
                                             QUESTIONS
                                        ================================================== -->

                                        <td>

                                            <a href="/admin/test-series/<%= currentSeries.id %>/tests/<%= t.id %>/questions"
                                               class="badge bg-soft-primary text-primary">

                                                <i class="ti ti-list-check me-1"></i>

                                                <%= typeof t.questionCount !== 'undefined'
                                                    ? t.questionCount
                                                    : 0 %>

                                            </a>

                                        </td>



                                        <!-- =================================================
                                             ATTEMPTS
                                        ================================================== -->

                                        <td>

                                            <span class="badge bg-soft-info text-info">

                                                <i class="ti ti-users me-1"></i>

                                                <%= typeof t.attemptCount !== 'undefined'
                                                    ? t.attemptCount
                                                    : 0 %>

                                            </span>

                                        </td>



                                        <!-- =================================================
                                             STATUS
                                        ================================================== -->

                                        <td>

                                            <% if (t.is_active) { %>

                                                <span class="badge bg-soft-success text-success">

                                                    <i class="ti ti-circle-filled fs-7 me-1"></i>

                                                    Active

                                                </span>

                                            <% } else { %>

                                                <span class="badge bg-soft-danger text-danger">

                                                    <i class="ti ti-circle-filled fs-7 me-1"></i>

                                                    Inactive

                                                </span>

                                            <% } %>

                                        </td>



                                        <!-- =================================================
                                             ACTION
                                        ================================================== -->

                                        <td class="text-end">

                                            <div class="dropdown">

                                                <a href="javascript:void(0);"
                                                   class="btn btn-icon btn-sm"
                                                   data-bs-toggle="dropdown"
                                                   aria-expanded="false">

                                                    <i class="ti ti-dots-vertical"></i>

                                                </a>


                                                <ul class="dropdown-menu dropdown-menu-end">


                                                    <!-- QUESTIONS -->

                                                    <li>

                                                        <a href="/admin/test-series/<%= currentSeries.id %>/tests/<%= t.id %>/questions"
                                                           class="dropdown-item">

                                                            <i class="ti ti-list-check me-1"></i>

                                                            Questions

                                                        </a>

                                                    </li>


                                                    <!-- RESULTS -->

                                                    <li>

                                                        <a href="/admin/test-series/<%= currentSeries.id %>/results?test=<%= t.id %>"
                                                           class="dropdown-item">

                                                            <i class="ti ti-chart-bar me-1"></i>

                                                            Results

                                                        </a>

                                                    </li>


                                                    <!-- EDIT -->

                                                    <li>

                                                        <a href="javascript:void(0);"
                                                           class="dropdown-item editTestBtn"
                                                           data-bs-toggle="modal"
                                                           data-bs-target="#editTestModal"
                                                           data-id="<%= t.id %>"
                                                           data-number="<%= t.test_number %>"
                                                           data-title="<%= t.title %>"
                                                           data-duration="<%= t.duration_minutes || '' %>"
                                                           data-negative="<%= t.negative_marking !== null && typeof t.negative_marking !== 'undefined' ? t.negative_marking : '' %>"
                                                           data-active="<%= t.is_active ? '1' : '0' %>">

                                                            <i class="ti ti-edit me-1"></i>

                                                            Edit

                                                        </a>

                                                    </li>


                                                    <li>

                                                        <hr class="dropdown-divider">

                                                    </li>


                                                    <!-- DELETE -->

                                                    <li>

                                                        <a href="javascript:void(0);"
                                                           class="dropdown-item text-danger deleteTestBtn"
                                                           data-bs-toggle="modal"
                                                           data-bs-target="#deleteTestModal"
                                                           data-id="<%= t.id %>"
                                                           data-title="<%= t.title %>">

                                                            <i class="ti ti-trash me-1"></i>

                                                            Delete

                                                        </a>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>


                            <% } else { %>


                                <!-- =================================================
                                     EMPTY
                                ================================================== -->

                                <tr id="noTestsRow">

                                    <td colspan="8"
                                        class="text-center py-5">

                                        <div class="text-muted">

                                            <i class="ti ti-file-question fs-40 d-block mb-2"></i>

                                            <h5>
                                                No Tests Found
                                            </h5>

                                            <p class="mb-2">

                                                There are no tests available
                                                in this test series.

                                            </p>


                                            <button type="button"
                                                    class="btn btn-primary btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#addTestModal">

                                                <i class="ti ti-plus me-1"></i>

                                                Add Your First Test

                                            </button>

                                        </div>

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>



                <!-- =================================================
                     PAGINATION
                ================================================== -->

                <% if (pageData.totalPages > 1) { %>

                    <div class="row align-items-center mt-3">


                        <div class="col-md-6">

                            <div class="text-muted">

                                Page

                                <%= pageData.page %>

                                of

                                <%= pageData.totalPages %>

                                &nbsp;·&nbsp;

                                <%= totalItems %>

                                total tests

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="d-flex justify-content-end">

                                <ul class="pagination mb-0">


                                    <% if (pageData.hasPrev) { %>

                                        <li class="page-item">

                                            <a class="page-link"
                                               href="/admin/test-series/<%= currentSeries.id %>/tests?page=<%= pageData.page - 1 %>&search=<%= encodeURIComponent(currentSearch) %>&status=<%= encodeURIComponent(currentStatus) %>&sort=<%= encodeURIComponent(currentSort) %>">

                                                <i class="ti ti-chevron-left"></i>

                                            </a>

                                        </li>

                                    <% } %>


                                    <% if (Array.isArray(pageData.pages)) { %>

                                        <% pageData.pages.forEach(function(page) { %>

                                            <li class="page-item <%= page === pageData.page ? 'active' : '' %>">

                                                <a class="page-link"
                                                   href="/admin/test-series/<%= currentSeries.id %>/tests?page=<%= page %>&search=<%= encodeURIComponent(currentSearch) %>&status=<%= encodeURIComponent(currentStatus) %>&sort=<%= encodeURIComponent(currentSort) %>">

                                                    <%= page %>

                                                </a>

                                            </li>

                                        <% }) %>

                                    <% } %>


                                    <% if (pageData.hasNext) { %>

                                        <li class="page-item">

                                            <a class="page-link"
                                               href="/admin/test-series/<%= currentSeries.id %>/tests?page=<%= pageData.page + 1 %>&search=<%= encodeURIComponent(currentSearch) %>&status=<%= encodeURIComponent(currentStatus) %>&sort=<%= encodeURIComponent(currentSort) %>">

                                                <i class="ti ti-chevron-right"></i>

                                            </a>

                                        </li>

                                    <% } %>

                                </ul>

                            </div>

                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

</div>



