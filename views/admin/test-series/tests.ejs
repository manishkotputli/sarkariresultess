<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

document.addEventListener('DOMContentLoaded', function () {


    /*
     * =====================================================
     * SEARCH
     * =====================================================
     */

    const searchInput =
        document.getElementById('testSearch');


    if (searchInput) {

        searchInput.addEventListener(
            'keydown',
            function (event) {

                if (event.key === 'Enter') {

                    event.preventDefault();

                    this.closest('form').submit();

                }

            }
        );

    }



    /*
     * =====================================================
     * EDIT TEST
     * =====================================================
     */

    document
        .querySelectorAll('.editTestBtn')
        .forEach(function (btn) {

            btn.addEventListener(
                'click',
                function () {


                    const id =
                        btn.getAttribute(
                            'data-id'
                        );


                    const form =
                        document.getElementById(
                            'editTestForm'
                        );


                    if (form) {

                        form.action =
                            '/admin/test-series/<%= currentSeries.id %>/tests/'
                            + id
                            + '/update';

                    }


                    document.getElementById(
                        'editTestNumber'
                    ).value =
                        btn.getAttribute(
                            'data-number'
                        ) || '';


                    document.getElementById(
                        'editTestTitle'
                    ).value =
                        btn.getAttribute(
                            'data-title'
                        ) || '';


                    document.getElementById(
                        'editTestDuration'
                    ).value =
                        btn.getAttribute(
                            'data-duration'
                        ) || '';


                    document.getElementById(
                        'editTestNegative'
                    ).value =
                        btn.getAttribute(
                            'data-negative'
                        ) || '';


                    document.getElementById(
                        'editTestActive'
                    ).checked =
                        btn.getAttribute(
                            'data-active'
                        ) === '1';

                }
            );

        });



    /*
     * =====================================================
     * DELETE TEST
     * =====================================================
     */

    document
        .querySelectorAll('.deleteTestBtn')
        .forEach(function (btn) {

            btn.addEventListener(
                'click',
                function () {


                    const id =
                        btn.getAttribute(
                            'data-id'
                        );


                    const title =
                        btn.getAttribute(
                            'data-title'
                        );


                    const form =
                        document.getElementById(
                            'deleteTestForm'
                        );


                    if (form) {

                        form.action =
                            '/admin/test-series/<%= currentSeries.id %>/tests/'
                            + id
                            + '/delete';

                    }


                    const titleElement =
                        document.getElementById(
                            'deleteTestTitle'
                        );


                    if (titleElement) {

                        titleElement.textContent =
                            title || 'this test';

                    }

                }
            );

        });



    /*
     * =====================================================
     * MANAGE COLUMNS
     * =====================================================
     */

    const toggles =
        document.querySelectorAll(
            '#tests-table .column-toggle'
        );


    const table =
        document.getElementById(
            'tests-table'
        );


    if (table) {


        function updateColumnVisibility(
            colIndex,
            isVisible
        ) {


            /*
             * HEADER
             */

            const th =
                table.querySelector(
                    `thead tr th:nth-child(${colIndex + 1})`
                );


            if (th) {

                th.classList.toggle(
                    'd-none',
                    !isVisible
                );

            }


            /*
             * BODY
             */

            table
                .querySelectorAll(
                    'tbody tr'
                )
                .forEach(function (row) {


                    if (
                        row.id ===
                        'noTestsRow'
                    ) {

                        return;

                    }


                    const td =
                        row.querySelector(
                            `td:nth-child(${colIndex + 1})`
                        );


                    if (td) {

                        td.classList.toggle(
                            'd-none',
                            !isVisible
                        );

                    }

                });


            /*
             * EMPTY ROW COLSPAN
             */

            const emptyTd =
                table.querySelector(
                    '#noTestsRow td'
                );


            if (emptyTd) {

                const visibleColumns =
                    table.querySelectorAll(
                        'thead tr th:not(.d-none)'
                    ).length;


                emptyTd.setAttribute(
                    'colspan',
                    visibleColumns || 1
                );

            }

        }



        /*
         * RESTORE + LISTEN
         */

        toggles.forEach(function (toggle) {


            const colIndex =
                parseInt(
                    toggle.getAttribute(
                        'data-column'
                    ),
                    10
                );


            const storageKey =
                'test_series_tests_col_' +
                colIndex;


            /*
             * Restore saved state
             */

            const savedState =
                localStorage.getItem(
                    storageKey
                );


            if (savedState !== null) {

                const isChecked =
                    savedState === 'true';


                toggle.checked =
                    isChecked;


                updateColumnVisibility(
                    colIndex,
                    isChecked
                );

            }


            /*
             * Change
             */

            toggle.addEventListener(
                'change',
                function () {


                    const isChecked =
                        this.checked;


                    updateColumnVisibility(
                        colIndex,
                        isChecked
                    );


                    localStorage.setItem(
                        storageKey,
                        isChecked
                    );

                }
            );

        });

    }



    /*
     * =====================================================
     * FEATHER ICONS
     * =====================================================
     */

    if (
        typeof feather !==
        'undefined'
    ) {

        feather.replace();

    }

});

</script>


