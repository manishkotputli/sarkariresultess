<%- include('../../adminlayout/header') %>

<%
    const currentSeriesId = seriesId;
    const currentTest = test || {};

    const questionItems =
        Array.isArray(questions) ? questions : [];

    const currentTotal =
        typeof total !== 'undefined' ? total : questionItems.length;

    const pageData =
        typeof pagination !== 'undefined' && pagination
            ? pagination
            : {
                page: 1,
                totalPages: 1,
                hasPrev: false,
                hasNext: false,
                pages: [1]
            };
%>


<div class="page-wrapper">
    <div class="content pb-0">

        <!-- =========================
             PAGE HEADER
        ========================== -->
        <div class="page-header">

            <div class="add-item d-flex">

                <div class="page-title">

                    <h4 class="fw-bold mb-1">
                        Test <%= currentTest.test_number %>:
                        <%= currentTest.title %>
                    </h4>

                    <h6 class="mb-0">
                        <%= currentTotal %>
                        question<%= currentTotal === 1 ? '' : 's' %>
                        in this test
                    </h6>

                </div>

            </div>


            <ul class="table-top-head">

                <li>
                    <a href="/admin/test-series/<%= currentSeriesId %>/tests"
                       data-bs-toggle="tooltip"
                       data-bs-placement="top"
                       title="Back to Tests">

                        <i data-feather="arrow-left"></i>

                    </a>
                </li>


                <li>
                    <a href="javascript:void(0);"
                       data-bs-toggle="tooltip"
                       data-bs-placement="top"
                       title="Refresh"
                       onclick="window.location.reload();">

                        <i data-feather="rotate-ccw"></i>

                    </a>
                </li>


                <li>
                    <a href="javascript:void(0);"
                       data-bs-toggle="tooltip"
                       data-bs-placement="top"
                       title="Collapse"
                       id="collapse-header">

                        <i data-feather="chevron-up"></i>

                    </a>
                </li>

            </ul>


            <div class="page-btn">

                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#addQuestionModal">

                    <i data-feather="plus" class="me-2"></i>

                    Add Question

                </button>

            </div>

        </div>


        <!-- =========================
             TEST INFO CARD
        ========================== -->
        <div class="card border-0 rounded-0 mb-3">

            <div class="card-body">

                <div class="row align-items-center">

                    <div class="col-md-8">

                        <div class="d-flex align-items-center">

                            <div class="avatar avatar-lg avatar-soft-primary me-3">

                                <i data-feather="help-circle"></i>

                            </div>

                            <div>

                                <h5 class="mb-1">
                                    Test <%= currentTest.test_number %>
                                </h5>

                                <p class="mb-0 text-muted">
                                    <%= currentTest.title %>
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="d-flex justify-content-md-end mt-3 mt-md-0">

                            <div class="text-center px-3 border-end">

                                <h5 class="mb-0">
                                    <%= currentTotal %>
                                </h5>

                                <span class="text-muted fs-12">
                                    Questions
                                </span>

                            </div>


                            <div class="text-center px-3">

                                <h5 class="mb-0">

                                    <%= currentTest.default_duration_minutes ||
                                        currentTest.duration_minutes ||
                                        '—' %>

                                    <% if (currentTest.default_duration_minutes || currentTest.duration_minutes) { %>
                                        <small class="text-muted fs-12">min</small>
                                    <% } %>

                                </h5>

                                <span class="text-muted fs-12">
                                    Duration
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================
             QUESTIONS CARD
        ========================== -->
        <div class="card border-0 rounded-0">

            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <div>

                    <h5 class="mb-1">
                        Questions
                    </h5>

                    <p class="mb-0 text-muted fs-12">
                        Manage questions, options, marks and correct answers.
                    </p>

                </div>


                <div class="d-flex align-items-center gap-2">

                    <span class="badge badge-soft-primary">

                        <i data-feather="list"
                           class="me-1"
                           style="width:14px;height:14px;"></i>

                        <%= currentTotal %>
                        Question<%= currentTotal === 1 ? '' : 's' %>

                    </span>

                </div>

            </div>


            <div class="card-body p-0">

                <% if (questionItems.length) { %>

                    <div class="table-responsive">

                        <table class="table datatable"
                               id="questions-table">

                            <thead class="thead-light">

                                <tr>

                                    <th>
                                        #
                                    </th>

                                    <th>
                                        Question
                                    </th>

                                    <th>
                                        Options
                                    </th>

                                    <th>
                                        Correct
                                    </th>

                                    <th>
                                        Marks
                                    </th>

                                    <th class="text-end">
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <% questionItems.forEach(function(q, idx) { %>

                                    <%
                                        const questionNumber =
                                            idx + 1 +
                                            ((Number(pageData.page) - 1) * 20);
                                    %>

                                    <tr>

                                        <!-- NUMBER -->
                                        <td>

                                            <span class="fw-semibold text-muted">

                                                Q<%= questionNumber %>

                                            </span>

                                        </td>


                                        <!-- QUESTION -->
                                        <td>

                                            <div style="max-width:420px;">

                                                <h6 class="mb-1 fw-semibold">

                                                    <%= q.question_text %>

                                                </h6>

                                            </div>

                                        </td>


                                        <!-- OPTIONS -->
                                        <td>

                                            <div class="d-flex flex-wrap gap-1">

                                                <span class="badge badge-light">
                                                    A
                                                </span>

                                                <span class="badge badge-light">
                                                    B
                                                </span>

                                                <span class="badge badge-light">
                                                    C
                                                </span>

                                                <span class="badge badge-light">
                                                    D
                                                </span>

                                            </div>

                                        </td>


                                        <!-- CORRECT OPTION -->
                                        <td>

                                            <span class="badge badge-success">

                                                <i data-feather="check-circle"
                                                   class="me-1"
                                                   style="width:13px;height:13px;"></i>

                                                <%= q.correct_option %>

                                            </span>

                                        </td>


                                        <!-- MARKS -->
                                        <td>

                                            <span class="fw-semibold">

                                                <%= q.marks %>

                                            </span>

                                            <span class="text-muted fs-12">

                                                mark<%= Number(q.marks) === 1 ? '' : 's' %>

                                            </span>

                                        </td>


                                        <!-- ACTION -->
                                        <td class="text-end">

                                            <div class="dropdown">

                                                <a href="javascript:void(0);"
                                                   class="btn btn-sm btn-icon btn-flat btn-light"
                                                   data-bs-toggle="dropdown">

                                                    <i data-feather="more-vertical"></i>

                                                </a>


                                                <ul class="dropdown-menu dropdown-menu-end">

                                                    <li>

                                                        <a href="javascript:void(0);"
                                                           class="dropdown-item editQuestionBtn"

                                                           data-bs-toggle="modal"
                                                           data-bs-target="#editQuestionModal"

                                                           data-id="<%= q.id %>"
                                                           data-text="<%= q.question_text %>"
                                                           data-a="<%= q.option_a %>"
                                                           data-b="<%= q.option_b %>"
                                                           data-c="<%= q.option_c %>"
                                                           data-d="<%= q.option_d %>"
                                                           data-correct="<%= q.correct_option %>"
                                                           data-marks="<%= q.marks %>">

                                                            <i data-feather="edit"
                                                               class="me-2"></i>

                                                            Edit

                                                        </a>

                                                    </li>


                                                    <li>

                                                        <a href="javascript:void(0);"
                                                           class="dropdown-item text-danger deleteQuestionBtn"

                                                           data-bs-toggle="modal"
                                                           data-bs-target="#deleteQuestionModal"

                                                           data-id="<%= q.id %>">

                                                            <i data-feather="trash-2"
                                                               class="me-2"></i>

                                                            Delete

                                                        </a>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>


                                    <!-- OPTIONS DETAIL ROW -->
                                    <tr class="question-options-row">

                                        <td></td>

                                        <td colspan="5">

                                            <div class="row g-2">

                                                <div class="col-md-6">

                                                    <div class="border rounded p-2
                                                        <%= q.correct_option === 'A'
                                                            ? 'border-success bg-success-subtle'
                                                            : '' %>">

                                                        <div class="d-flex align-items-start">

                                                            <span class="badge
                                                                <%= q.correct_option === 'A'
                                                                    ? 'badge-success'
                                                                    : 'badge-light' %>
                                                                me-2">

                                                                A

                                                            </span>

                                                            <span class="text-muted fs-13">

                                                                <%= q.option_a %>

                                                            </span>

                                                        </div>

                                                    </div>

                                                </div>


                                                <div class="col-md-6">

                                                    <div class="border rounded p-2
                                                        <%= q.correct_option === 'B'
                                                            ? 'border-success bg-success-subtle'
                                                            : '' %>">

                                                        <div class="d-flex align-items-start">

                                                            <span class="badge
                                                                <%= q.correct_option === 'B'
                                                                    ? 'badge-success'
                                                                    : 'badge-light' %>
                                                                me-2">

                                                                B

                                                            </span>

                                                            <span class="text-muted fs-13">

                                                                <%= q.option_b %>

                                                            </span>

                                                        </div>

                                                    </div>

                                                </div>


                                                <div class="col-md-6">

                                                    <div class="border rounded p-2
                                                        <%= q.correct_option === 'C'
                                                            ? 'border-success bg-success-subtle'
                                                            : '' %>">

                                                        <div class="d-flex align-items-start">

                                                            <span class="badge
                                                                <%= q.correct_option === 'C'
                                                                    ? 'badge-success'
                                                                    : 'badge-light' %>
                                                                me-2">

                                                                C

                                                            </span>

                                                            <span class="text-muted fs-13">

                                                                <%= q.option_c %>

                                                            </span>

                                                        </div>

                                                    </div>

                                                </div>


                                                <div class="col-md-6">

                                                    <div class="border rounded p-2
                                                        <%= q.correct_option === 'D'
                                                            ? 'border-success bg-success-subtle'
                                                            : '' %>">

                                                        <div class="d-flex align-items-start">

                                                            <span class="badge
                                                                <%= q.correct_option === 'D'
                                                                    ? 'badge-success'
                                                                    : 'badge-light' %>
                                                                me-2">

                                                                D

                                                            </span>

                                                            <span class="text-muted fs-13">

                                                                <%= q.option_d %>

                                                            </span>

                                                        </div>

                                                    </div>

                                                </div>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>


                <% } else { %>

                    <!-- EMPTY STATE -->

                    <div class="text-center py-5">

                        <div class="avatar avatar-xl avatar-soft-primary mx-auto mb-3">

                            <i data-feather="help-circle"
                               style="width:35px;height:35px;"></i>

                        </div>

                        <h5 class="mb-2">
                            No Questions Yet
                        </h5>

                        <p class="text-muted mb-3">

                            Add the first question to this test
                            and start building your test series.

                        </p>

                        <button type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#addQuestionModal">

                            <i data-feather="plus"
                               class="me-1"></i>

                            Add Question

                        </button>

                    </div>

                <% } %>


                <!-- =========================
                     PAGINATION
                ========================== -->

                <% if (pageData.totalPages > 1) { %>

                    <div class="row align-items-center p-3">

                        <div class="col-sm-12 col-md-5">

                            <p class="mb-0 text-muted">

                                Page

                                <strong>
                                    <%= pageData.page %>
                                </strong>

                                of

                                <strong>
                                    <%= pageData.totalPages %>
                                </strong>

                                &middot;

                                <strong>
                                    <%= currentTotal %>
                                </strong>

                                total

                            </p>

                        </div>


                        <div class="col-sm-12 col-md-7">

                            <div class="d-flex justify-content-md-end justify-content-center mt-2 mt-md-0">

                                <ul class="pagination mb-0">


                                    <% if (pageData.hasPrev) { %>

                                        <li class="page-item">

                                            <a class="page-link"
                                               href="/admin/test-series/<%= currentSeriesId %>/tests/<%= currentTest.id %>/questions?page=<%= pageData.page - 1 %>">

                                                <i data-feather="chevron-left"></i>

                                            </a>

                                        </li>

                                    <% } %>


                                    <% if (Array.isArray(pageData.pages)) { %>

                                        <% pageData.pages.forEach(function(p) { %>

                                            <li class="page-item <%= p === pageData.page ? 'active' : '' %>">

                                                <a class="page-link"
                                                   href="/admin/test-series/<%= currentSeriesId %>/tests/<%= currentTest.id %>/questions?page=<%= p %>">

                                                    <%= p %>

                                                </a>

                                            </li>

                                        <% }) %>

                                    <% } %>


                                    <% if (pageData.hasNext) { %>

                                        <li class="page-item">

                                            <a class="page-link"
                                               href="/admin/test-series/<%= currentSeriesId %>/tests/<%= currentTest.id %>/questions?page=<%= pageData.page + 1 %>">

                                                <i data-feather="chevron-right"></i>

                                            </a>

                                        </li>

                                    <% } %>

                                </ul>

                            </div>

                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </div>
</div>



<!-- =========================================================
     ADD QUESTION MODAL
========================================================= -->

<div class="modal fade"
     id="addQuestionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <form method="POST"
                  action="/admin/test-series/<%= currentSeriesId %>/tests/<%= currentTest.id %>/questions">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Add Question
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>

                </div>


                <div class="modal-body">

                    <!-- QUESTION -->

                    <div class="mb-3">

                        <label class="form-label">
                            Question
                            <span class="text-danger">*</span>
                        </label>

                        <textarea name="question_text"
                                  required
                                  rows="3"
                                  class="form-control"
                                  placeholder="Enter question"></textarea>

                    </div>


                    <!-- OPTIONS -->

                    <div class="mb-3">

                        <label class="form-label">
                            Options
                        </label>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <div class="input-group">

                                    <span class="input-group-text">
                                        A
                                    </span>

                                    <input type="text"
                                           name="option_a"
                                           required
                                           class="form-control"
                                           placeholder="Option A">

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="input-group">

                                    <span class="input-group-text">
                                        B
                                    </span>

                                    <input type="text"
                                           name="option_b"
                                           required
                                           class="form-control"
                                           placeholder="Option B">

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="input-group">

                                    <span class="input-group-text">
                                        C
                                    </span>

                                    <input type="text"
                                           name="option_c"
                                           required
                                           class="form-control"
                                           placeholder="Option C">

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="input-group">

                                    <span class="input-group-text">
                                        D
                                    </span>

                                    <input type="text"
                                           name="option_d"
                                           required
                                           class="form-control"
                                           placeholder="Option D">

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- CORRECT + MARKS -->

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">

                                Correct Option

                                <span class="text-danger">*</span>

                            </label>

                            <select name="correct_option"
                                    required
                                    class="form-select">

                                <option value="A">
                                    A
                                </option>

                                <option value="B">
                                    B
                                </option>

                                <option value="C">
                                    C
                                </option>

                                <option value="D">
                                    D
                                </option>

                            </select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Marks
                            </label>

                            <input type="number"
                                   step="0.5"
                                   min="0"
                                   name="marks"
                                   value="1"
                                   class="form-control"
                                   placeholder="Marks">

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        <i data-feather="plus"
                           class="me-1"></i>

                        Add Question

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- =========================================================
     EDIT QUESTION MODAL
========================================================= -->

<div class="modal fade"
     id="editQuestionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <form method="POST"
                  id="editQuestionForm"
                  action="">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Edit Question
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>

                </div>


                <div class="modal-body">

                    <!-- QUESTION -->

                    <div class="mb-3">

                        <label class="form-label">

                            Question

                            <span class="text-danger">*</span>

                        </label>

                        <textarea name="question_text"
                                  id="editQuestionText"
                                  required
                                  rows="3"
                                  class="form-control"
                                  placeholder="Enter question"></textarea>

                    </div>


                    <!-- OPTIONS -->

                    <div class="mb-3">

                        <label class="form-label">
                            Options
                        </label>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <div class="input-group">

                                    <span class="input-group-text">
                                        A
                                    </span>

                                    <input type="text"
                                           name="option_a"
                                           id="editOptionA"
                                           required
                                           class="form-control"
                                           placeholder="Option A">

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="input-group">

                                    <span class="input-group-text">
                                        B
                                    </span>

                                    <input type="text"
                                           name="option_b"
                                           id="editOptionB"
                                           required
                                           class="form-control"
                                           placeholder="Option B">

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="input-group">

                                    <span class="input-group-text">
                                        C
                                    </span>

                                    <input type="text"
                                           name="option_c"
                                           id="editOptionC"
                                           required
                                           class="form-control"
                                           placeholder="Option C">

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="input-group">

                                    <span class="input-group-text">
                                        D
                                    </span>

                                    <input type="text"
                                           name="option_d"
                                           id="editOptionD"
                                           required
                                           class="form-control"
                                           placeholder="Option D">

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- CORRECT + MARKS -->

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">

                                Correct Option

                                <span class="text-danger">*</span>

                            </label>

                            <select name="correct_option"
                                    id="editCorrectOption"
                                    required
                                    class="form-select">

                                <option value="A">
                                    A
                                </option>

                                <option value="B">
                                    B
                                </option>

                                <option value="C">
                                    C
                                </option>

                                <option value="D">
                                    D
                                </option>

                            </select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Marks
                            </label>

                            <input type="number"
                                   step="0.5"
                                   min="0"
                                   name="marks"
                                   id="editMarks"
                                   class="form-control"
                                   placeholder="Marks">

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        <i data-feather="save"
                           class="me-1"></i>

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- =========================================================
     DELETE QUESTION MODAL
========================================================= -->

<div class="modal fade"
     id="deleteQuestionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="POST"
                  id="deleteQuestionForm"
                  action="">

                <div class="modal-body text-center p-4 p-md-5">

                    <div class="avatar avatar-xl avatar-soft-danger mx-auto mb-3">

                        <i data-feather="trash-2"
                           style="width:32px;height:32px;"></i>

                    </div>


                    <h5 class="mb-2">
                        Delete Question
                    </h5>


                    <p class="text-muted mb-0">

                        Are you sure you want to delete this question?

                        <br>

                        <strong>
                            This action cannot be undone.
                        </strong>

                    </p>

                </div>


                <div class="modal-footer justify-content-center">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-danger">

                        <i data-feather="trash-2"
                           class="me-1"></i>

                        Delete

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- =========================================================
     PAGE SCRIPT
========================================================= -->

<script>

document.addEventListener('DOMContentLoaded', function () {

    /*
     * ---------------------------------------
     * EDIT QUESTION
     * ---------------------------------------
     */

    document
        .querySelectorAll('.editQuestionBtn')
        .forEach(function (btn) {

            btn.addEventListener('click', function () {

                const id =
                    btn.dataset.id;

                const editForm =
                    document.getElementById(
                        'editQuestionForm'
                    );

                if (editForm) {

                    editForm.action =
                        '/admin/test-series/<%= currentSeriesId %>/tests/<%= currentTest.id %>/questions/'
                        + id
                        + '/update';

                }


                const questionText =
                    document.getElementById(
                        'editQuestionText'
                    );

                const optionA =
                    document.getElementById(
                        'editOptionA'
                    );

                const optionB =
                    document.getElementById(
                        'editOptionB'
                    );

                const optionC =
                    document.getElementById(
                        'editOptionC'
                    );

                const optionD =
                    document.getElementById(
                        'editOptionD'
                    );

                const correct =
                    document.getElementById(
                        'editCorrectOption'
                    );

                const marks =
                    document.getElementById(
                        'editMarks'
                    );


                if (questionText) {
                    questionText.value =
                        btn.dataset.text || '';
                }

                if (optionA) {
                    optionA.value =
                        btn.dataset.a || '';
                }

                if (optionB) {
                    optionB.value =
                        btn.dataset.b || '';
                }

                if (optionC) {
                    optionC.value =
                        btn.dataset.c || '';
                }

                if (optionD) {
                    optionD.value =
                        btn.dataset.d || '';
                }

                if (correct) {
                    correct.value =
                        btn.dataset.correct || 'A';
                }

                if (marks) {
                    marks.value =
                        btn.dataset.marks || '1';
                }

            });

        });


    /*
     * ---------------------------------------
     * DELETE QUESTION
     * ---------------------------------------
     */

    document
        .querySelectorAll('.deleteQuestionBtn')
        .forEach(function (btn) {

            btn.addEventListener('click', function () {

                const id =
                    btn.dataset.id;

                const deleteForm =
                    document.getElementById(
                        'deleteQuestionForm'
                    );

                if (deleteForm) {

                    deleteForm.action =
                        '/admin/test-series/<%= currentSeriesId %>/tests/<%= currentTest.id %>/questions/'
                        + id
                        + '/delete';

                }

            });

        });


    /*
     * ---------------------------------------
     * FEATHER ICONS
     * ---------------------------------------
     */

    if (typeof feather !== 'undefined') {

        feather.replace();

    }

});

</script>


<%- include('../../adminlayout/footer') %>