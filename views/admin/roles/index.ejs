<%- include('../../adminlayout/header') %>

<div class="page-wrapper">
    <div class="content pb-0">

        <!-- ALERTS -->
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <ul class="mb-0">
                    <% errors.forEach(function(error) { %>
                        <li><%= error %></li>
                    <% }) %>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- PAGE HEADER -->
        <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">
            <div>
                <h4 class="mb-1">Roles &amp; Permissions</h4>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 p-0">
                        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Roles</li>
                    </ol>
                </nav>
            </div>

            <div class="gap-2 d-flex align-items-center flex-wrap">
                <a href="javascript:location.reload();" class="btn btn-icon btn-outline-light shadow" data-bs-toggle="tooltip" title="Refresh">
                    <i class="ti ti-refresh"></i>
                </a>
            </div>
        </div>

        <!-- ROLES CARD -->
        <div class="card border-0 rounded-0">
            <!-- CARD HEADER -->
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <form method="GET" action="/admin/roles" class="mb-0">
                    <div class="input-icon input-icon-start position-relative">
                        <span class="input-icon-addon text-dark">
                            <i class="ti ti-search"></i>
                        </span>
                        <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" class="form-control" placeholder="Search roles...">
                    </div>
                </form>

                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRoleModal">
                    <i class="ti ti-square-rounded-plus-filled me-1"></i> Add Role
                </button>
            </div>

            <!-- CARD BODY -->
            <div class="card-body">
                <div class="table-responsive custom-table">
                    <table class="table table-nowrap align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Role</th>
                                <th>Prefix</th>
                                <th>Users</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (roles && roles.length) { %>
                                <% roles.forEach(function(role) { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="avatar avatar-sm rounded-circle bg-soft-primary text-primary flex-shrink-0">
                                                    <i class="ti ti-shield-check fs-18"></i>
                                                </span>
                                                <span class="fw-semibold text-dark"><%= role.name %></span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark font-monospace"><%= role.prefix %></span>
                                        </td>
                                        <td>
                                            <span class="text-muted"><%= role.get('userCount') %> users</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-end gap-1">
                                                <button type="button" 
                                                        class="btn btn-icon btn-sm btn-outline-light editRoleBtn"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#editRoleModal"
                                                        data-id="<%= role.id %>"
                                                        data-name="<%= role.name %>"
                                                        data-prefix="<%= role.prefix %>">
                                                    <i class="ti ti-edit"></i>
                                                </button>
                                                <button type="button" 
                                                        class="btn btn-icon btn-sm btn-outline-light text-danger deleteRoleBtn"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#deleteRoleModal"
                                                        data-id="<%= role.id %>"
                                                        data-name="<%= role.name %>">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">No roles found.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ADD ROLE MODAL -->
<div class="modal fade" id="addRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="POST" action="/admin/roles">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body space-y-3">
                    <div class="mb-3">
                        <label class="form-label">Role Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" required placeholder="e.g. Content Editor" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Prefix <span class="text-danger">*</span></label>
                        <input type="text" name="prefix" required maxlength="10" placeholder="e.g. CE" class="form-control text-uppercase">
                        <small class="text-muted">Used to build user codes, e.g. CE-000001</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT ROLE MODAL -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="POST" id="editRoleForm" action="">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Edit Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Role Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editRoleName" required class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Prefix <span class="text-danger">*</span></label>
                        <input type="text" name="prefix" id="editRolePrefix" required maxlength="10" class="form-control text-uppercase">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DELETE ROLE MODAL -->
<div class="modal fade" id="deleteRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="POST" id="deleteRoleForm" action="">
                <div class="modal-body text-center p-4">
                    <div class="avatar avatar-xl rounded-circle bg-soft-danger text-danger mx-auto mb-3">
                        <i class="ti ti-trash fs-24"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Delete Role</h5>
                    <p class="text-muted mb-0">Are you sure you want to delete "<span id="deleteRoleName" class="fw-semibold text-dark"></span>"? Roles with existing users cannot be deleted.</p>
                </div>
                <div class="modal-footer justify-content-center border-0 pt-0">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.editRoleBtn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('editRoleForm').action = '/admin/roles/' + btn.dataset.id + '/update';
            document.getElementById('editRoleName').value = btn.dataset.name || '';
            document.getElementById('editRolePrefix').value = btn.dataset.prefix || '';
        });
    });

    document.querySelectorAll('.deleteRoleBtn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('deleteRoleForm').action = '/admin/roles/' + btn.dataset.id + '/delete';
            document.getElementById('deleteRoleName').textContent = btn.dataset.name || '';
        });
    });
});
</script>

<%- include('../../adminlayout/footer') %>