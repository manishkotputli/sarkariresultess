<%- include('../adminlayout/header') %>

<!-- Start Content -->
 <div class="page-wrapper">
<div class="content pb-0">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->
    <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">

        <div>
            <h4 class="mb-1">Dashboard</h4>
            <p class="mb-0 text-muted">
                Welcome back! Here's what's happening on your website.
            </p>
        </div>

        <div class="gap-2 d-flex align-items-center flex-wrap">

            <div class="daterangepick form-control w-auto d-flex align-items-center me-2">
                <i class="ti ti-calendar text-dark me-2"></i>
                <span class="reportrange-picker-field text-dark">
                    Today
                </span>
            </div>

            <a href="/admin/posts/create"
               class="btn btn-primary d-flex align-items-center">
                <i class="ti ti-plus me-1"></i>
                Add Post
            </a>

            <a href="javascript:void(0);"
               onclick="window.location.reload();"
               class="btn btn-icon btn-outline-light shadow"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               aria-label="Refresh"
               data-bs-original-title="Refresh">
                <i class="ti ti-refresh"></i>
            </a>

            <a href="javascript:void(0);"
               class="btn btn-icon btn-outline-light shadow"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               aria-label="Collapse"
               data-bs-original-title="Collapse"
               id="collapse-header">
                <i class="ti ti-transition-top"></i>
            </a>

        </div>

    </div>
    <!-- End Page Header -->


    <!-- =========================================================
         STAT CARDS
    ========================================================== -->

    <div class="row">

        <!-- Total Posts -->
        <div class="col-xl-3 col-sm-6 d-flex">
            <div class="card flex-fill">

                <div class="card-body position-relative">

                    <p class="fw-medium mb-1">
                        Total Posts
                    </p>

                    <h4 class="mb-3">
                        <%= stats?.totalPosts ?? 0 %>
                    </h4>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-primary border-0">
                            Posts
                        </span>

                        <p class="text-dark mb-0">
                            Published content
                        </p>
                    </div>

                    <div class="custom-card-icon">
                        <div class="avatar avatar-rounded avatar-lg bg-primary-gradient-100 position-absolute top-0 end-0">
                            <i class="ti ti-file-text fs-28 text-primary"></i>
                        </div>
                    </div>

                </div>

            </div>
        </div>


        <!-- Total Categories -->
        <div class="col-xl-3 col-sm-6 d-flex">
            <div class="card flex-fill">

                <div class="card-body position-relative">

                    <p class="fw-medium mb-1">
                        Categories
                    </p>

                    <h4 class="mb-3">
                        <%= stats?.totalCategories ?? 0 %>
                    </h4>

                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-success border-0">
                            Categories
                        </span>

                        <p class="text-dark mb-0">
                            Content categories
                        </p>

                    </div>

                    <div class="custom-card-icon">
                        <div class="avatar avatar-rounded avatar-lg bg-info-gradient-100 position-absolute top-0 end-0">
                            <i class="ti ti-category fs-28 text-info"></i>
                        </div>
                    </div>

                </div>

            </div>
        </div>


        <!-- Total Blogs -->
        <div class="col-xl-3 col-sm-6 d-flex">
            <div class="card flex-fill">

                <div class="card-body position-relative">

                    <p class="fw-medium mb-1">
                        Blog Posts
                    </p>

                    <h4 class="mb-3">
                        <%= stats?.totalBlogs ?? 0 %>
                    </h4>

                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-warning border-0">
                            Blogs
                        </span>

                        <p class="text-dark mb-0">
                            Published blogs
                        </p>

                    </div>

                    <div class="custom-card-icon">
                        <div class="avatar avatar-rounded avatar-lg bg-warning-gradient-100 position-absolute top-0 end-0">
                            <i class="ti ti-news fs-28 text-warning"></i>
                        </div>
                    </div>

                </div>

            </div>
        </div>


        <!-- Total Users -->
        <div class="col-xl-3 col-sm-6 d-flex">
            <div class="card flex-fill">

                <div class="card-body position-relative">

                    <p class="fw-medium mb-1">
                        Total Users
                    </p>

                    <h4 class="mb-3">
                        <%= stats?.totalUsers ?? 0 %>
                    </h4>

                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <span class="d-inline-flex align-items-center badge rounded-pill badge-soft-success border-0">
                            Users
                        </span>

                        <p class="text-dark mb-0">
                            Registered users
                        </p>

                    </div>

                    <div class="custom-card-icon">
                        <div class="avatar avatar-rounded avatar-lg bg-success-gradient-100 position-absolute top-0 end-0">
                            <i class="ti ti-users fs-28 text-success"></i>
                        </div>
                    </div>

                </div>

            </div>
        </div>

    </div>

    <!-- End Stat Cards -->


    <!-- =========================================================
         MAIN DASHBOARD ROW
    ========================================================== -->

    <div class="row">


        <!-- =====================================================
             RECENT POSTS
        ====================================================== -->

        <div class="col-xxl-8 col-xl-7 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">

                        <h5 class="mb-0 fs-16 fw-bold d-inline-flex align-items-center">
                            <span class="line-title d-block me-2"></span>
                            Recent Posts
                        </h5>

                        <a href="/admin/posts"
                           class="btn btn-sm btn-light d-flex align-items-center">

                            View All

                            <i class="ti ti-chevron-right ms-1"></i>

                        </a>

                    </div>


                    <div class="table-responsive custom-table">

                        <table class="table table-bordered table-nowrap">

                            <thead class="table-white">

                                <tr>

                                    <th>
                                        Title
                                    </th>

                                    <th>
                                        Category
                                    </th>

                                    <th>
                                        Posted
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <% if (recentPosts && recentPosts.length) { %>

                                    <% recentPosts.forEach(function(post) { %>

                                        <tr>

                                            <!-- Title -->
                                            <td>

                                                <div class="d-flex align-items-center">

                                                    <div class="avatar avatar-sm bg-primary-transparent rounded me-2">
                                                        <i class="ti ti-file-text text-primary"></i>
                                                    </div>

                                                    <div class="flex-fill">

                                                        <h6 class="fw-medium mb-0 text-truncate"
                                                            style="max-width: 350px;">

                                                            <%= post.title %>

                                                        </h6>

                                                    </div>

                                                </div>

                                            </td>


                                            <!-- Category -->
                                            <td>

                                                <% if (post.Category) { %>

                                                    <span class="badge badge-soft-primary">
                                                        <%= post.Category.name %>
                                                    </span>

                                                <% } else { %>

                                                    <span class="text-muted">
                                                        -
                                                    </span>

                                                <% } %>

                                            </td>


                                            <!-- Date -->
                                            <td>

                                                <span class="text-muted">

                                                    <%= formatDate(
                                                        post.post_date || post.created_at || post.createdAt
                                                    ) %>

                                                </span>

                                            </td>


                                            <!-- Action -->
                                            <td>

                                                <div class="d-flex align-items-center gap-2">

                                                    <a href="/admin/posts/<%= post.id %>/edit"
                                                       class="btn btn-sm btn-icon btn-outline-light"
                                                       data-bs-toggle="tooltip"
                                                       title="Edit">

                                                        <i class="ti ti-edit"></i>

                                                    </a>

                                                    <a href="/admin/posts/<%= post.id %>"
                                                       class="btn btn-sm btn-icon btn-outline-light"
                                                       data-bs-toggle="tooltip"
                                                       title="View">

                                                        <i class="ti ti-eye"></i>

                                                    </a>

                                                </div>

                                            </td>

                                        </tr>

                                    <% }) %>


                                <% } else { %>

                                    <tr>

                                        <td colspan="4"
                                            class="text-center py-5">

                                            <div class="mb-2">
                                                <i class="ti ti-file-off fs-32 text-muted"></i>
                                            </div>

                                            <p class="text-muted mb-2">
                                                No posts available.
                                            </p>

                                            <a href="/admin/posts/create"
                                               class="btn btn-sm btn-primary">

                                                <i class="ti ti-plus me-1"></i>
                                                Add Your First Post

                                            </a>

                                        </td>

                                    </tr>

                                <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             POSTS BY CATEGORY
        ====================================================== -->

        <div class="col-xxl-4 col-xl-5 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">

                        <h5 class="mb-0 fs-16 fw-bold d-inline-flex align-items-center">

                            <span class="line-title d-block me-2"></span>

                            Posts by Category

                        </h5>

                        <a href="/admin/categories"
                           class="btn btn-sm btn-icon btn-outline-light"
                           data-bs-toggle="tooltip"
                           title="Manage Categories">

                            <i class="ti ti-arrow-right"></i>

                        </a>

                    </div>


                    <% if (categoriesWithCounts && categoriesWithCounts.length) { %>

                        <div class="category-list">

                            <% categoriesWithCounts.forEach(function(cat) { %>

                                <div class="d-flex align-items-center justify-content-between p-2 border-bottom">

                                    <div class="d-flex align-items-center">

                                        <div class="avatar avatar-sm bg-primary-transparent rounded me-2">

                                            <i class="ti ti-folder text-primary"></i>

                                        </div>

                                        <span class="text-dark fw-medium">

                                            <%= cat.name %>

                                        </span>

                                    </div>


                                    <span class="badge badge-soft-primary">

                                        <%= cat.get('postCount') || 0 %>

                                    </span>

                                </div>

                            <% }) %>

                        </div>


                    <% } else { %>

                        <div class="text-center py-5">

                            <div class="mb-2">
                                <i class="ti ti-folder-off fs-32 text-muted"></i>
                            </div>

                            <p class="text-muted mb-2">
                                No categories available.
                            </p>

                            <a href="/admin/categories"
                               class="btn btn-sm btn-light">

                                Manage Categories

                            </a>

                        </div>

                    <% } %>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         MODULE OVERVIEW
    ========================================================== -->

    <div class="row">


        <!-- Jobs -->
        <div class="col-xl-3 col-sm-6 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between mb-3">

                        <div class="avatar avatar-lg bg-primary-transparent rounded">
                            <i class="ti ti-briefcase fs-28 text-primary"></i>
                        </div>

                        <a href="/admin/jobs"
                           class="btn btn-sm btn-icon btn-outline-light">

                            <i class="ti ti-arrow-up-right"></i>

                        </a>

                    </div>

                    <p class="fw-medium mb-1">
                        Jobs
                    </p>

                    <h4 class="mb-1">
                        <%= stats?.totalJobs ?? 0 %>
                    </h4>

                    <p class="text-muted mb-0 fs-13">
                        Total job posts
                    </p>

                </div>

            </div>

        </div>


        <!-- Results -->
        <div class="col-xl-3 col-sm-6 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between mb-3">

                        <div class="avatar avatar-lg bg-success-transparent rounded">
                            <i class="ti ti-trophy fs-28 text-success"></i>
                        </div>

                        <a href="/admin/results"
                           class="btn btn-sm btn-icon btn-outline-light">

                            <i class="ti ti-arrow-up-right"></i>

                        </a>

                    </div>

                    <p class="fw-medium mb-1">
                        Results
                    </p>

                    <h4 class="mb-1">
                        <%= stats?.totalResults ?? 0 %>
                    </h4>

                    <p class="text-muted mb-0 fs-13">
                        Total results
                    </p>

                </div>

            </div>

        </div>


        <!-- Admit Cards -->
        <div class="col-xl-3 col-sm-6 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between mb-3">

                        <div class="avatar avatar-lg bg-warning-transparent rounded">
                            <i class="ti ti-id fs-28 text-warning"></i>
                        </div>

                        <a href="/admin/admit-cards"
                           class="btn btn-sm btn-icon btn-outline-light">

                            <i class="ti ti-arrow-up-right"></i>

                        </a>

                    </div>

                    <p class="fw-medium mb-1">
                        Admit Cards
                    </p>

                    <h4 class="mb-1">
                        <%= stats?.totalAdmitCards ?? 0 %>
                    </h4>

                    <p class="text-muted mb-0 fs-13">
                        Total admit cards
                    </p>

                </div>

            </div>

        </div>


        <!-- Score Cards -->
        <div class="col-xl-3 col-sm-6 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between mb-3">

                        <div class="avatar avatar-lg bg-info-transparent rounded">
                            <i class="ti ti-id-badge fs-28 text-info"></i>
                        </div>

                        <a href="/admin/score-cards"
                           class="btn btn-sm btn-icon btn-outline-light">

                            <i class="ti ti-arrow-up-right"></i>

                        </a>

                    </div>

                    <p class="fw-medium mb-1">
                        Score Cards
                    </p>

                    <h4 class="mb-1">
                        <%= stats?.totalScoreCards ?? 0 %>
                    </h4>

                    <p class="text-muted mb-0 fs-13">
                        Total score cards
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         SECOND MODULE ROW
    ========================================================== -->

    <div class="row">


        <!-- Courses -->
        <div class="col-xl-3 col-sm-6 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between mb-3">

                        <div class="avatar avatar-lg bg-purple-transparent rounded">
                            <i class="ti ti-school fs-28 text-purple"></i>
                        </div>

                        <a href="/admin/courses"
                           class="btn btn-sm btn-icon btn-outline-light">

                            <i class="ti ti-arrow-up-right"></i>

                        </a>

                    </div>

                    <p class="fw-medium mb-1">
                        Courses
                    </p>

                    <h4 class="mb-1">
                        <%= stats?.totalCourses ?? 0 %>
                    </h4>

                    <p class="text-muted mb-0 fs-13">
                        Available courses
                    </p>

                </div>

            </div>

        </div>


        <!-- Test Series -->
        <div class="col-xl-3 col-sm-6 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between mb-3">

                        <div class="avatar avatar-lg bg-danger-transparent rounded">
                            <i class="ti ti-clipboard-check fs-28 text-danger"></i>
                        </div>

                        <a href="/admin/test-series"
                           class="btn btn-sm btn-icon btn-outline-light">

                            <i class="ti ti-arrow-up-right"></i>

                        </a>

                    </div>

                    <p class="fw-medium mb-1">
                        Test Series
                    </p>

                    <h4 class="mb-1">
                        <%= stats?.totalTestSeries ?? 0 %>
                    </h4>

                    <p class="text-muted mb-0 fs-13">
                        Total test series
                    </p>

                </div>

            </div>

        </div>


        <!-- Questions -->
        <div class="col-xl-3 col-sm-6 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between mb-3">

                        <div class="avatar avatar-lg bg-secondary-transparent rounded">
                            <i class="ti ti-help-circle fs-28 text-secondary"></i>
                        </div>

                        <a href="/admin/questions"
                           class="btn btn-sm btn-icon btn-outline-light">

                            <i class="ti ti-arrow-up-right"></i>

                        </a>

                    </div>

                    <p class="fw-medium mb-1">
                        Questions
                    </p>

                    <h4 class="mb-1">
                        <%= stats?.totalQuestions ?? 0 %>
                    </h4>

                    <p class="text-muted mb-0 fs-13">
                        Question bank
                    </p>

                </div>

            </div>

        </div>


        <!-- Subscribers / Users -->
        <div class="col-xl-3 col-sm-6 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between mb-3">

                        <div class="avatar avatar-lg bg-success-transparent rounded">
                            <i class="ti ti-users fs-28 text-success"></i>
                        </div>

                        <a href="/admin/users"
                           class="btn btn-sm btn-icon btn-outline-light">

                            <i class="ti ti-arrow-up-right"></i>

                        </a>

                    </div>

                    <p class="fw-medium mb-1">
                        Registered Users
                    </p>

                    <h4 class="mb-1">
                        <%= stats?.totalUsers ?? 0 %>
                    </h4>

                    <p class="text-muted mb-0 fs-13">
                        Website users
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         QUICK ACTIONS + WEBSITE OVERVIEW
    ========================================================== -->

    <div class="row">


        <!-- Quick Actions -->
        <div class="col-xl-6 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between mb-4">

                        <h5 class="mb-0 fs-16 fw-bold d-inline-flex align-items-center">

                            <span class="line-title d-block me-2"></span>

                            Quick Actions

                        </h5>

                    </div>


                    <div class="row g-3">


                        <div class="col-sm-6">

                            <a href="/admin/posts/create"
                               class="d-flex align-items-center p-3 border rounded">

                                <div class="avatar avatar-md bg-primary-transparent rounded me-3">

                                    <i class="ti ti-file-plus text-primary fs-20"></i>

                                </div>

                                <div>

                                    <h6 class="mb-1">
                                        Add New Post
                                    </h6>

                                    <p class="mb-0 text-muted fs-13">
                                        Create a new result post
                                    </p>

                                </div>

                            </a>

                        </div>


                        <div class="col-sm-6">

                            <a href="/admin/blogs/create"
                               class="d-flex align-items-center p-3 border rounded">

                                <div class="avatar avatar-md bg-warning-transparent rounded me-3">

                                    <i class="ti ti-news text-warning fs-20"></i>

                                </div>

                                <div>

                                    <h6 class="mb-1">
                                        Add Blog
                                    </h6>

                                    <p class="mb-0 text-muted fs-13">
                                        Publish a new blog
                                    </p>

                                </div>

                            </a>

                        </div>


                        <div class="col-sm-6">

                            <a href="/admin/jobs/create"
                               class="d-flex align-items-center p-3 border rounded">

                                <div class="avatar avatar-md bg-success-transparent rounded me-3">

                                    <i class="ti ti-briefcase text-success fs-20"></i>

                                </div>

                                <div>

                                    <h6 class="mb-1">
                                        Add Job
                                    </h6>

                                    <p class="mb-0 text-muted fs-13">
                                        Create a new job post
                                    </p>

                                </div>

                            </a>

                        </div>


                        <div class="col-sm-6">

                            <a href="/admin/results/create"
                               class="d-flex align-items-center p-3 border rounded">

                                <div class="avatar avatar-md bg-info-transparent rounded me-3">

                                    <i class="ti ti-trophy text-info fs-20"></i>

                                </div>

                                <div>

                                    <h6 class="mb-1">
                                        Add Result
                                    </h6>

                                    <p class="mb-0 text-muted fs-13">
                                        Publish latest result
                                    </p>

                                </div>

                            </a>

                        </div>


                        <div class="col-sm-6">

                            <a href="/admin/admit-cards/create"
                               class="d-flex align-items-center p-3 border rounded">

                                <div class="avatar avatar-md bg-danger-transparent rounded me-3">

                                    <i class="ti ti-id text-danger fs-20"></i>

                                </div>

                                <div>

                                    <h6 class="mb-1">
                                        Add Admit Card
                                    </h6>

                                    <p class="mb-0 text-muted fs-13">
                                        Add latest admit card
                                    </p>

                                </div>

                            </a>

                        </div>


                        <div class="col-sm-6">

                            <a href="/admin/score-cards/create"
                               class="d-flex align-items-center p-3 border rounded">

                                <div class="avatar avatar-md bg-purple-transparent rounded me-3">

                                    <i class="ti ti-id-badge text-purple fs-20"></i>

                                </div>

                                <div>

                                    <h6 class="mb-1">
                                        Add Score Card
                                    </h6>

                                    <p class="mb-0 text-muted fs-13">
                                        Create score card
                                    </p>

                                </div>

                            </a>

                        </div>


                    </div>

                </div>

            </div>

        </div>


        <!-- Website Overview -->
        <div class="col-xl-6 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between mb-4">

                        <h5 class="mb-0 fs-16 fw-bold d-inline-flex align-items-center">

                            <span class="line-title d-block me-2"></span>

                            Website Overview

                        </h5>

                        <a href="/admin/analytics"
                           class="btn btn-sm btn-light">

                            Analytics

                            <i class="ti ti-chevron-right ms-1"></i>

                        </a>

                    </div>


                    <div class="row g-3">


                        <div class="col-6">

                            <div class="p-3 bg-light rounded">

                                <div class="d-flex align-items-center mb-2">

                                    <i class="ti ti-eye text-primary me-2"></i>

                                    <span class="text-muted fs-13">
                                        Page Views
                                    </span>

                                </div>

                                <h5 class="mb-0">
                                    <%= stats?.pageViews ?? 0 %>
                                </h5>

                            </div>

                        </div>


                        <div class="col-6">

                            <div class="p-3 bg-light rounded">

                                <div class="d-flex align-items-center mb-2">

                                    <i class="ti ti-users text-success me-2"></i>

                                    <span class="text-muted fs-13">
                                        Visitors
                                    </span>

                                </div>

                                <h5 class="mb-0">
                                    <%= stats?.visitors ?? 0 %>
                                </h5>

                            </div>

                        </div>


                        <div class="col-6">

                            <div class="p-3 bg-light rounded">

                                <div class="d-flex align-items-center mb-2">

                                    <i class="ti ti-file-text text-warning me-2"></i>

                                    <span class="text-muted fs-13">
                                        Posts
                                    </span>

                                </div>

                                <h5 class="mb-0">
                                    <%= stats?.totalPosts ?? 0 %>
                                </h5>

                            </div>

                        </div>


                        <div class="col-6">

                            <div class="p-3 bg-light rounded">

                                <div class="d-flex align-items-center mb-2">

                                    <i class="ti ti-news text-info me-2"></i>

                                    <span class="text-muted fs-13">
                                        Blogs
                                    </span>

                                </div>

                                <h5 class="mb-0">
                                    <%= stats?.totalBlogs ?? 0 %>
                                </h5>

                            </div>

                        </div>


                    </div>


                    <div class="mt-4">

                        <div class="d-flex align-items-center justify-content-between mb-2">

                            <span class="text-muted fs-13">
                                Content Published
                            </span>

                            <span class="fw-semibold">
                                <%= stats?.totalPosts ?? 0 %>
                            </span>

                        </div>

                        <div class="progress progress-sm">

                            <div class="progress-bar bg-primary"
                                 role="progressbar"
                                 style="width: 75%;"
                                 aria-valuenow="75"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         RECENT ACTIVITY
    ========================================================== -->

    <div class="row">

        <div class="col-md-12 d-flex">

            <div class="card flex-fill">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between flex-wrap row-gap-3 mb-3">

                        <h5 class="mb-0 fs-16 fw-bold d-inline-flex align-items-center">

                            <span class="line-title d-block me-2"></span>

                            Recent Posts

                        </h5>

                        <a class="btn btn-sm btn-light d-inline-flex align-items-center"
                           href="/admin/posts">

                            View All

                            <i class="ti ti-chevron-right ms-1"></i>

                        </a>

                    </div>


                    <div class="table-responsive custom-table">

                        <table class="table table-bordered table-nowrap">

                            <thead class="table-white">

                                <tr>

                                    <th>
                                        Post
                                    </th>

                                    <th>
                                        Category
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th>
                                        Published
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <% if (recentPosts && recentPosts.length) { %>

                                    <% recentPosts.forEach(function(post) { %>

                                        <tr>

                                            <td>

                                                <div class="d-flex align-items-center">

                                                    <div class="avatar avatar-md bg-light rounded me-2">

                                                        <i class="ti ti-file-text text-primary fs-18"></i>

                                                    </div>

                                                    <div>

                                                        <h6 class="fw-medium mb-1">

                                                            <%= post.title %>

                                                        </h6>

                                                        <span class="text-muted fs-12">

                                                            ID: #<%= post.id %>

                                                        </span>

                                                    </div>

                                                </div>

                                            </td>


                                            <td>

                                                <% if (post.Category) { %>

                                                    <span class="badge badge-soft-primary">

                                                        <%= post.Category.name %>

                                                    </span>

                                                <% } else { %>

                                                    <span class="text-muted">
                                                        -
                                                    </span>

                                                <% } %>

                                            </td>


                                            <td>

                                                <span class="badge badge-soft-success">

                                                    Published

                                                </span>

                                            </td>


                                            <td>

                                                <%= formatDate(
                                                    post.post_date ||
                                                    post.created_at ||
                                                    post.createdAt
                                                ) %>

                                            </td>


                                            <td>

                                                <div class="d-flex align-items-center gap-2">

                                                    <a href="/admin/posts/<%= post.id %>"
                                                       class="btn btn-sm btn-icon btn-outline-light"
                                                       title="View">

                                                        <i class="ti ti-eye"></i>

                                                    </a>

                                                    <a href="/admin/posts/<%= post.id %>/edit"
                                                       class="btn btn-sm btn-icon btn-outline-light"
                                                       title="Edit">

                                                        <i class="ti ti-edit"></i>

                                                    </a>

                                                </div>

                                            </td>

                                        </tr>

                                    <% }) %>


                                <% } else { %>

                                    <tr>

                                        <td colspan="5"
                                            class="text-center py-5">

                                            <div class="mb-2">

                                                <i class="ti ti-file-off fs-32 text-muted"></i>

                                            </div>

                                            <p class="text-muted mb-2">
                                                No posts found.
                                            </p>

                                            <a href="/admin/posts/create"
                                               class="btn btn-sm btn-primary">

                                                <i class="ti ti-plus me-1"></i>

                                                Add New Post

                                            </a>

                                        </td>

                                    </tr>

                                <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>


</div>
</div>
<!-- End Content -->


<%- include('../adminlayout/footer') %>