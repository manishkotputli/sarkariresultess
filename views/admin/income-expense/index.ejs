<%
    /*
    |--------------------------------------------------------------------------
    | Safe Locals
    |--------------------------------------------------------------------------
    */

    const currentFilters =
        typeof filters !== 'undefined' && filters
            ? filters
            : {};

    const currentSearch =
        currentFilters.search || '';

    const currentType =
        currentFilters.type || '';

    const currentSort =
        currentFilters.sort || '';

    const entryList =
        Array.isArray(entries)
            ? entries
            : [];

    const bankList =
        Array.isArray(banks)
            ? banks
            : [];

    const bankSelectList =
        Array.isArray(allBanks)
            ? allBanks
            : [];

    const categorySelectList =
        Array.isArray(allCategories)
            ? allCategories
            : [];

    const userList =
        Array.isArray(users)
            ? users
            : [];

    const currentPage =
        Number(page) || 1;

    const entriesPerPage =
        Number(perPage) || 15;

    const totalEntries =
        Number(total) || 0;

    const totalBankCount =
        Number(banksTotal) || 0;

    const totalBankPages =
        Math.max(
            1,
            Math.ceil(
                totalBankCount / (
                    Number(banksPerPage) || 8
                )
            )
        );

    const totalEntryPages =
        Math.max(
            1,
            Math.ceil(
                totalEntries / entriesPerPage
            )
        );


    /*
    |--------------------------------------------------------------------------
    | Money Formatter
    |--------------------------------------------------------------------------
    */

    function money(value) {

        return '₹' + Number(value || 0).toLocaleString(
            'en-IN',
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }
        );

    }


    /*
    |--------------------------------------------------------------------------
    | Date Formatter
    |--------------------------------------------------------------------------
    */

    function displayDate(value) {

        if (!value) {
            return '-';
        }

        try {

            const date = new Date(value);

            if (isNaN(date.getTime())) {
                return value;
            }

            return date.toLocaleDateString(
                'en-IN',
                {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                }
            );

        } catch (e) {

            return value;

        }

    }


    /*
    |--------------------------------------------------------------------------
    | Account Number Mask
    |--------------------------------------------------------------------------
    */

    function maskAccount(value) {

        if (!value) {
            return '•••• ••••';
        }

        const clean =
            String(value).replace(/\s+/g, '');

        const last4 =
            clean.slice(-4);

        return last4
            ? '•••• ' + last4
            : '•••• ••••';

    }


    /*
    |--------------------------------------------------------------------------
    | Card Themes
    |--------------------------------------------------------------------------
    */

    const cardThemes = [
        'fin-card-a',
        'fin-card-b',
        'fin-card-c',
        'fin-card-d',
        'fin-card-e',
        'fin-card-f'
    ];


    /*
    |--------------------------------------------------------------------------
    | JSON For Javascript
    |--------------------------------------------------------------------------
    */

    const bankOptionsJson =
        JSON.stringify(
            bankSelectList.map(function (bank) {

                return {
                    id: bank.id,
                    name: bank.name,
                    user_id: bank.user_id
                };

            })
        );

    const categoryOptionsJson =
        JSON.stringify(
            categorySelectList.map(function (category) {

                return {
                    id: category.id,
                    name: category.name,
                    user_id: category.user_id,
                    type: category.type
                };

            })
        );


    /*
    |--------------------------------------------------------------------------
    | Query Builder
    |--------------------------------------------------------------------------
    */

    function buildQuery(params) {

        const query = [];

        Object.keys(params).forEach(function (key) {

            const value = params[key];

            if (
                value !== undefined &&
                value !== null &&
                value !== ''
            ) {

                query.push(
                    encodeURIComponent(key) +
                    '=' +
                    encodeURIComponent(value)
                );

            }

        });

        return query.join('&');

    }
%>


<%- include('../../adminlayout/header') %>


<style>

    /*
    |--------------------------------------------------------------------------
    | Finance Account Cards
    |--------------------------------------------------------------------------
    */

    .finance-account-card {
        color: #fff;
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        min-height: 205px;
        box-shadow: 0 10px 30px -12px rgba(0, 0, 0, .30);
        transition: all .25s ease;
    }

    .finance-account-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 35px -12px rgba(0, 0, 0, .38);
    }

    .finance-account-card::after {
        content: "";
        position: absolute;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .08);
        right: -45px;
        bottom: -55px;
    }

    .fin-card-a {
        background: linear-gradient(
            135deg,
            #232b36 0%,
            #0c0f14 100%
        );
    }

    .fin-card-b {
        background: linear-gradient(
            135deg,
            #0f9b8e 0%,
            #0b5f57 100%
        );
    }

    .fin-card-c {
        background: linear-gradient(
            135deg,
            #4a8f34 0%,
            #16260f 100%
        );
    }

    .fin-card-d {
        background: linear-gradient(
            135deg,
            #0f6aad 0%,
            #062338 100%
        );
    }

    .fin-card-e {
        background: linear-gradient(
            135deg,
            #5b4a9e 0%,
            #1c1533 100%
        );
    }

    .fin-card-f {
        background: linear-gradient(
            135deg,
            #c17a24 0%,
            #2e1a08 100%
        );
    }


    /*
    |--------------------------------------------------------------------------
    | Finance Stat Cards
    |--------------------------------------------------------------------------
    */

    .finance-stat-card {
        border: 1px solid #e9edf4;
        transition: all .2s ease;
    }

    .finance-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, .06);
    }

    .finance-stat-icon {
        width: 54px;
        height: 54px;
        min-width: 54px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }


    /*
    |--------------------------------------------------------------------------
    | Table
    |--------------------------------------------------------------------------
    */

    #income-expense-table th {
        white-space: nowrap;
    }

    #income-expense-table td {
        vertical-align: middle;
    }

    .finance-title {
        max-width: 280px;
    }

    .finance-title .title-text {
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: block;
    }


    /*
    |--------------------------------------------------------------------------
    | Account Number
    |--------------------------------------------------------------------------
    */

    .account-number {
        letter-spacing: 1.5px;
        font-size: 13px;
    }


    /*
    |--------------------------------------------------------------------------
    | Empty State
    |--------------------------------------------------------------------------
    */

    .finance-empty-state {
        padding: 55px 20px;
        text-align: center;
    }

    .finance-empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 15px;
    }


    /*
    |--------------------------------------------------------------------------
    | Modal
    |--------------------------------------------------------------------------
    */

    .finance-modal .modal-header {
        border-bottom: 1px solid #eef1f5;
    }

    .finance-modal .modal-footer {
        border-top: 1px solid #eef1f5;
    }

    .finance-modal .form-label {
        font-weight: 600;
        font-size: 13px;
    }


    /*
    |--------------------------------------------------------------------------
    | Responsive
    |--------------------------------------------------------------------------
    */

    @media (max-width: 767px) {

        .finance-title {
            max-width: 180px;
        }

        .finance-title .title-text {
            max-width: 170px;
        }

        .finance-account-card {
            min-height: 190px;
        }

    }

</style>


<div class="page-wrapper">

    <div class="content pb-0">


        <!-- =========================================================
             ALERTS
        ========================================================== -->

        <% if (typeof success !== 'undefined' && success) { %>

            <div
                class="alert alert-success alert-dismissible fade show mb-4"
                role="alert"
            >
                <i class="ti ti-circle-check me-2"></i>

                <%= success %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>

            </div>

        <% } %>


        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>

            <div
                class="alert alert-danger alert-dismissible fade show mb-4"
                role="alert"
            >

                <ul class="mb-0 ps-3">

                    <% errors.forEach(function(error) { %>

                        <li>
                            <%= error %>
                        </li>

                    <% }) %>

                </ul>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>

            </div>

        <% } %>


        <!-- =========================================================
             PAGE HEADER
        ========================================================== -->

        <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">

            <div>

                <h4 class="mb-1">
                    Income &amp; Expense
                </h4>

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb mb-0 p-0">

                        <li class="breadcrumb-item">

                            <a href="/admin">
                                Home
                            </a>

                        </li>

                        <li
                            class="breadcrumb-item active"
                            aria-current="page"
                        >
                            Income &amp; Expense
                        </li>

                    </ol>

                </nav>

            </div>


            <div class="gap-2 d-flex align-items-center flex-wrap">

                <!-- Refresh -->

                <a
                    href="javascript:location.reload();"
                    class="btn btn-icon btn-outline-light shadow"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    aria-label="Refresh"
                    data-bs-original-title="Refresh"
                >
                    <i class="ti ti-refresh"></i>
                </a>


                <!-- Collapse -->

                <a
                    href="javascript:void(0);"
                    class="btn btn-icon btn-outline-light shadow"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    aria-label="Collapse"
                    data-bs-original-title="Collapse"
                    id="collapse-header"
                >
                    <i class="ti ti-transition-top"></i>
                </a>

            </div>

        </div>


        <!-- =========================================================
             STAT CARDS
        ========================================================== -->

        <div class="row mb-4">


            <!-- Total Income -->

            <div class="col-xl-3 col-md-6 mb-3">

                <div class="card finance-stat-card h-100 mb-0">

                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">

                            <div>

                                <p class="text-muted mb-1">
                                    Total Income
                                </p>

                                <h4 class="mb-0 fw-bold text-success">
                                    <%= money(stats && stats.income) %>
                                </h4>

                                <small class="text-muted">
                                    All your income entries
                                </small>

                            </div>

                            <span class="finance-stat-icon bg-soft-success text-success">
                                <i class="ti ti-trending-up"></i>
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Total Expense -->

            <div class="col-xl-3 col-md-6 mb-3">

                <div class="card finance-stat-card h-100 mb-0">

                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">

                            <div>

                                <p class="text-muted mb-1">
                                    Total Expense
                                </p>

                                <h4 class="mb-0 fw-bold text-danger">
                                    <%= money(stats && stats.expense) %>
                                </h4>

                                <small class="text-muted">
                                    All your expense entries
                                </small>

                            </div>

                            <span class="finance-stat-icon bg-soft-danger text-danger">
                                <i class="ti ti-trending-down"></i>
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Net Balance -->

            <div class="col-xl-3 col-md-6 mb-3">

                <div class="card finance-stat-card h-100 mb-0">

                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">

                            <div>

                                <p class="text-muted mb-1">
                                    Net Balance
                                </p>

                                <h4 class="mb-0 fw-bold <%= Number(stats && stats.balance) >= 0 ? 'text-primary' : 'text-danger' %>">
                                    <%= money(stats && stats.balance) %>
                                </h4>

                                <small class="text-muted">
                                    Income minus expense
                                </small>

                            </div>

                            <span class="finance-stat-icon bg-soft-primary text-primary">
                                <i class="ti ti-scale"></i>
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Active Accounts -->

            <div class="col-xl-3 col-md-6 mb-3">

                <div class="card finance-stat-card h-100 mb-0">

                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">

                            <div>

                                <p class="text-muted mb-1">
                                    Active Accounts
                                </p>

                                <h4 class="mb-0 fw-bold text-info">
                                    <%= Number(stats && stats.totalBanks) || 0 %>
                                </h4>

                                <small class="text-muted">
                                    Your active bank/accounts
                                </small>

                            </div>

                            <span class="finance-stat-icon bg-soft-info text-info">
                                <i class="ti ti-wallet"></i>
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             ACCOUNTS
        ========================================================== -->

        <div
            class="card border-0 rounded-0 mb-4"
            id="accounts"
        >

            <!-- Header -->

            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">

                <div>

                    <h5 class="mb-1">
                        My Accounts
                    </h5>

                    <p class="text-muted mb-0">
                        <%= totalBankCount %>
                        account<%= totalBankCount === 1 ? '' : 's' %>
                        available
                    </p>

                </div>


                <button
                    type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addBankModal"
                >

                    <i class="ti ti-square-rounded-plus-filled me-1"></i>

                    Add Account

                </button>

            </div>


            <!-- Accounts Body -->

            <div class="card-body">

                <% if (bankList.length) { %>

                    <div class="row">

                        <% bankList.forEach(function(bank, bankIndex) { %>

                            <%
                                const theme =
                                    cardThemes[
                                        Number(bank.id) %
                                        cardThemes.length
                                    ];
                            %>


                            <div class="col-xl-4 col-md-6 mb-4">

                                <div
                                    class="finance-account-card <%= theme %> p-4 h-100"
                                >


                                    <!-- Top -->

                                    <div class="d-flex align-items-start justify-content-between mb-4">

                                        <div>

                                            <div
                                                class="text-white-50 text-uppercase small fw-semibold mb-1"
                                            >
                                                Account
                                            </div>

                                            <h5 class="text-white mb-0">
                                                <%= bank.name %>
                                            </h5>

                                        </div>


                                        <div class="dropdown">

                                            <button
                                                type="button"
                                                class="btn btn-sm btn-icon text-white"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                            >

                                                <i class="ti ti-dots-vertical"></i>

                                            </button>


                                            <ul class="dropdown-menu dropdown-menu-end">

                                                <li>

                                                    <a
                                                        href="javascript:void(0);"
                                                        class="dropdown-item editBankBtn"
                                                        data-id="<%= bank.id %>"
                                                        data-name="<%= bank.name %>"
                                                        data-account="<%= bank.account_number || '' %>"
                                                        data-balance="<%= bank.opening_balance || 0 %>"
                                                        data-active="<%= bank.is_active ? '1' : '0' %>"
                                                    >

                                                        <i class="ti ti-edit me-2"></i>

                                                        Edit

                                                    </a>

                                                </li>


                                                <li>

                                                    <a
                                                        href="javascript:void(0);"
                                                        class="dropdown-item text-danger deleteBankBtn"
                                                        data-id="<%= bank.id %>"
                                                        data-name="<%= bank.name %>"
                                                    >

                                                        <i class="ti ti-trash me-2"></i>

                                                        Remove

                                                    </a>

                                                </li>

                                            </ul>

                                        </div>

                                    </div>


                                    <!-- Card Chip -->

                                    <div
                                        class="mb-3"
                                        style="
                                            width:42px;
                                            height:30px;
                                            border-radius:6px;
                                            background:linear-gradient(135deg,#f7d774,#b7891c);
                                        "
                                    ></div>


                                    <!-- Account Number -->

                                    <div class="mb-4">

                                        <div class="account-number text-white fw-semibold">

                                            <%= maskAccount(bank.account_number) %>

                                        </div>

                                    </div>


                                    <!-- Bottom -->

                                    <div class="d-flex align-items-end justify-content-between gap-3">

                                        <div class="min-w-0">

                                            <small class="text-white-50 d-block text-uppercase">
                                                Account Holder
                                            </small>

                                            <strong class="text-white d-block text-truncate">
                                                <%= bank.User ? bank.User.name : 'My Account' %>
                                            </strong>

                                        </div>


                                        <div class="text-end">

                                            <small class="text-white-50 d-block text-uppercase">
                                                Current Balance
                                            </small>

                                            <strong class="text-white d-block">
                                                <%= money(bank.current_balance) %>
                                            </strong>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        <% }) %>

                    </div>


                    <!-- Account Pagination -->

                    <% if (totalBankPages > 1) { %>

                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-2">

                            <div class="text-muted small">

                                Page
                                <strong><%= Number(bankPage) || 1 %></strong>
                                of
                                <strong><%= totalBankPages %></strong>

                            </div>


                            <ul class="pagination pagination-sm mb-0">

                                <% if (Number(bankPage) > 1) { %>

                                    <li class="page-item">

                                        <a
                                            class="page-link"
                                            href="/admin/income-expense?<%= buildQuery({
                                                bank_page: Number(bankPage) - 1,
                                                search: currentSearch,
                                                type: currentType
                                            }) %>#accounts"
                                        >

                                            <i class="ti ti-chevron-left"></i>

                                        </a>

                                    </li>

                                <% } %>


                                <%
                                    const bankStart =
                                        Math.max(
                                            1,
                                            (Number(bankPage) || 1) - 2
                                        );

                                    const bankEnd =
                                        Math.min(
                                            totalBankPages,
                                            (Number(bankPage) || 1) + 2
                                        );
                                %>


                                <% for (let bp = bankStart; bp <= bankEnd; bp++) { %>

                                    <li
                                        class="page-item <%= bp === Number(bankPage) ? 'active' : '' %>"
                                    >

                                        <a
                                            class="page-link"
                                            href="/admin/income-expense?<%= buildQuery({
                                                bank_page: bp,
                                                search: currentSearch,
                                                type: currentType
                                            }) %>#accounts"
                                        >
                                            <%= bp %>
                                        </a>

                                    </li>

                                <% } %>


                                <% if (Number(bankPage) < totalBankPages) { %>

                                    <li class="page-item">

                                        <a
                                            class="page-link"
                                            href="/admin/income-expense?<%= buildQuery({
                                                bank_page: Number(bankPage) + 1,
                                                search: currentSearch,
                                                type: currentType
                                            }) %>#accounts"
                                        >

                                            <i class="ti ti-chevron-right"></i>

                                        </a>

                                    </li>

                                <% } %>

                            </ul>

                        </div>

                    <% } %>


                <% } else { %>


                    <!-- Empty Accounts -->

                    <div class="finance-empty-state">

                        <div class="finance-empty-icon bg-soft-primary text-primary">

                            <i class="ti ti-wallet"></i>

                        </div>

                        <h5 class="mb-1">
                            No Accounts Found
                        </h5>

                        <p class="text-muted mb-3">
                            You have not added any bank or wallet account yet.
                        </p>

                        <button
                            type="button"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#addBankModal"
                        >

                            <i class="ti ti-plus me-1"></i>

                            Add Your First Account

                        </button>

                    </div>


                <% } %>

            </div>

        </div>


        <!-- =========================================================
             TRANSACTIONS
        ========================================================== -->

        <div
            class="card border-0 rounded-0"
            id="transactions"
        >


            <!-- Header -->

            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">

                <div>

                    <h5 class="mb-1">
                        Transactions
                    </h5>

                    <p class="text-muted mb-0">

                        <%= totalEntries %>

                        transaction<%= totalEntries === 1 ? '' : 's' %>
                        recorded

                    </p>

                </div>


                <button
                    type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addEntryModal"
                >

                    <i class="ti ti-square-rounded-plus-filled me-1"></i>

                    Add Entry

                </button>

            </div>


            <!-- =====================================================
                 FILTER TOOLBAR
            ====================================================== -->

            <div class="card-body border-bottom">

                <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">


                    <!-- Search -->

                    <form
                        method="GET"
                        action="/admin/income-expense"
                        class="mb-0 d-flex align-items-center gap-2 flex-wrap"
                    >

                        <div class="input-icon input-icon-start position-relative">

                            <span class="input-icon-addon text-dark">

                                <i class="ti ti-search"></i>

                            </span>


                            <input
                                type="text"
                                name="search"
                                value="<%= currentSearch %>"
                                class="form-control"
                                placeholder="Search transactions..."
                            >

                        </div>


                        <!-- Preserve type -->

                        <input
                            type="hidden"
                            name="type"
                            value="<%= currentType %>"
                        >


                        <!-- Search button -->

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >

                            Search

                        </button>


                        <% if (currentSearch || currentType) { %>

                            <a
                                href="/admin/income-expense"
                                class="btn btn-link text-muted text-decoration-none"
                            >

                                Clear

                            </a>

                        <% } %>

                    </form>


                    <!-- Filter / Columns -->

                    <div class="d-flex align-items-center gap-2 flex-wrap">


                        <!-- Filter -->

                        <div class="dropdown">

                            <a
                                href="javascript:void(0);"
                                class="btn btn-outline-light shadow dropdown-toggle"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                            >

                                <i class="ti ti-filter me-2"></i>

                                Filter

                                <% if (currentType) { %>

                                    <span class="badge bg-primary ms-1">
                                        1
                                    </span>

                                <% } %>

                            </a>


                            <div class="dropdown-menu dropdown-menu-end p-3">

                                <form
                                    method="GET"
                                    action="/admin/income-expense"
                                >

                                    <div class="mb-3">

                                        <label class="form-label">
                                            Transaction Type
                                        </label>

                                        <select
                                            name="type"
                                            class="form-select"
                                        >

                                            <option value="">
                                                All Types
                                            </option>

                                            <option
                                                value="1"
                                                <%= currentType === '1' ? 'selected' : '' %>
                                            >
                                                Income
                                            </option>

                                            <option
                                                value="2"
                                                <%= currentType === '2' ? 'selected' : '' %>
                                            >
                                                Expense
                                            </option>

                                        </select>

                                    </div>


                                    <input
                                        type="hidden"
                                        name="search"
                                        value="<%= currentSearch %>"
                                    >


                                    <div class="d-flex gap-2">

                                        <button
                                            type="submit"
                                            class="btn btn-primary flex-fill"
                                        >

                                            Apply

                                        </button>


                                        <a
                                            href="/admin/income-expense"
                                            class="btn btn-light flex-fill"
                                        >

                                            Clear

                                        </a>

                                    </div>

                                </form>

                            </div>

                        </div>


                        <!-- Manage Columns -->

                        <div class="dropdown">

                            <a
                                href="javascript:void(0);"
                                class="btn bg-soft-indigo border-0"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                            >

                                <i class="ti ti-columns-3 me-2"></i>

                                Manage Columns

                            </a>


                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-md p-3">

                                <ul class="list-unstyled mb-0">


                                    <!-- Date -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-calendar me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Date</span>

                                                <input
                                                    class="form-check-input column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="0"
                                                    data-key="date"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- Title -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-file-description me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Title</span>

                                                <input
                                                    class="form-check-input column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="1"
                                                    data-key="title"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- Category -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-category me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Category</span>

                                                <input
                                                    class="form-check-input column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="2"
                                                    data-key="category"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- Account -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-wallet me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Account</span>

                                                <input
                                                    class="form-check-input column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="3"
                                                    data-key="account"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- Type -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-arrows-transfer-up me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Type</span>

                                                <input
                                                    class="form-check-input column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="4"
                                                    data-key="type"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- Amount -->

                                    <li class="gap-1 d-flex align-items-center mb-2">

                                        <i class="ti ti-currency-rupee me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Amount</span>

                                                <input
                                                    class="form-check-input column-toggle ms-auto"
                                                    type="checkbox"
                                                    data-column="5"
                                                    data-key="amount"
                                                    checked
                                                >

                                            </label>

                                        </div>

                                    </li>


                                    <!-- Action -->

                                    <li class="gap-1 d-flex align-items-center">

                                        <i class="ti ti-settings me-1"></i>

                                        <div class="form-check form-switch w-100 ps-0">

                                            <label class="form-check-label d-flex align-items-center gap-2 w-100">

                                                <span>Action</span>

                                                <input
                                                    class="form-check-input"
                                                    type="checkbox"
                                                    checked
                                                    disabled
                                                >

                                            </label>

                                        </div>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 TABLE
            ====================================================== -->

            <div class="card-body pt-0">

                <div class="table-responsive custom-table">

                    <table
                        class="table table-nowrap"
                        id="income-expense-table"
                    >

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Title
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Account
                                </th>

                                <th>
                                    Type
                                </th>

                                <th class="text-end">
                                    Amount
                                </th>

                                <th class="text-end no-sort">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% if (entryList.length) { %>


                                <% entryList.forEach(function(entry) { %>

                                    <tr>


                                        <!-- DATE -->

                                        <td>

                                            <span class="text-muted">

                                                <i class="ti ti-calendar-event me-1"></i>

                                                <%= displayDate(entry.transaction_date) %>

                                            </span>

                                        </td>


                                        <!-- TITLE -->

                                        <td>

                                            <div class="d-flex align-items-center gap-3 finance-title">


                                                <span
                                                    class="avatar avatar-sm rounded-circle
                                                    <%= Number(entry.type) === 1
                                                        ? 'bg-soft-success text-success'
                                                        : 'bg-soft-danger text-danger'
                                                    %>"
                                                >

                                                    <i
                                                        class="ti
                                                        <%= Number(entry.type) === 1
                                                            ? 'ti-arrow-up'
                                                            : 'ti-arrow-down'
                                                        %>"
                                                    ></i>

                                                </span>


                                                <div>

                                                    <h6 class="mb-0 fw-semibold">

                                                        <span
                                                            class="title-text"
                                                            title="<%= entry.title %>"
                                                        >

                                                            <%= entry.title %>

                                                        </span>

                                                    </h6>


                                                    <% if (entry.note) { %>

                                                        <small
                                                            class="text-muted d-block text-truncate"
                                                            style="max-width:240px;"
                                                            title="<%= entry.note %>"
                                                        >

                                                            <%= entry.note %>

                                                        </small>

                                                    <% } %>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- CATEGORY -->

                                        <td>

                                            <% if (entry.IncomeExpenseCategory) { %>

                                                <span class="badge bg-soft-primary text-primary">

                                                    <i class="ti ti-category me-1"></i>

                                                    <%= entry.IncomeExpenseCategory.name %>

                                                </span>

                                            <% } else { %>

                                                <span class="text-muted">
                                                    -
                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- ACCOUNT -->

                                        <td>

                                            <% if (entry.Bank) { %>

                                                <div>

                                                    <span class="fw-medium">
                                                        <%= entry.Bank.name %>
                                                    </span>

                                                    <% if (entry.Bank.account_number) { %>

                                                        <small class="text-muted d-block">

                                                            <%= maskAccount(entry.Bank.account_number) %>

                                                        </small>

                                                    <% } %>

                                                </div>

                                            <% } else { %>

                                                <span class="badge bg-soft-secondary text-secondary">

                                                    <i class="ti ti-cash me-1"></i>

                                                    Cash / No Account

                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- TYPE -->

                                        <td>

                                            <% if (Number(entry.type) === 1) { %>

                                                <span class="badge bg-soft-success text-success">

                                                    <i class="ti ti-arrow-up me-1"></i>

                                                    Income

                                                </span>

                                            <% } else { %>

                                                <span class="badge bg-soft-danger text-danger">

                                                    <i class="ti ti-arrow-down me-1"></i>

                                                    Expense

                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- AMOUNT -->

                                        <td class="text-end">

                                            <span
                                                class="fw-bold
                                                <%= Number(entry.type) === 1
                                                    ? 'text-success'
                                                    : 'text-danger'
                                                %>"
                                            >

                                                <%= Number(entry.type) === 1 ? '+' : '-' %>

                                                <%= money(entry.amount) %>

                                            </span>

                                        </td>


                                        <!-- ACTION -->

                                        <td class="text-end">

                                            <div class="dropdown">

                                                <a
                                                    href="javascript:void(0);"
                                                    class="btn btn-icon btn-sm"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false"
                                                >

                                                    <i class="ti ti-dots-vertical"></i>

                                                </a>


                                                <ul class="dropdown-menu dropdown-menu-end">


                                                    <!-- EDIT -->

                                                    <li>

                                                        <a
                                                            href="javascript:void(0);"
                                                            class="dropdown-item editEntryBtn"

                                                            data-id="<%= entry.id %>"

                                                            data-type="<%= entry.type %>"

                                                            data-category="<%= entry.category_id %>"

                                                            data-bank="<%= entry.bank_id || '' %>"

                                                            data-title="<%= entry.title %>"

                                                            data-amount="<%= entry.amount %>"

                                                            data-date="<%= entry.transaction_date %>"

                                                            data-note="<%= entry.note || '' %>"
                                                        >

                                                            <i class="ti ti-edit me-2"></i>

                                                            Edit

                                                        </a>

                                                    </li>


                                                    <!-- DELETE -->

                                                    <li>

                                                        <a
                                                            href="javascript:void(0);"
                                                            class="dropdown-item text-danger deleteEntryBtn"

                                                            data-id="<%= entry.id %>"

                                                            data-title="<%= entry.title %>"
                                                        >

                                                            <i class="ti ti-trash me-2"></i>

                                                            Delete

                                                        </a>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>


                            <% } else { %>


                                <!-- EMPTY -->

                                <tr>

                                    <td
                                        colspan="7"
                                        class="text-center py-5"
                                    >

                                        <div class="text-muted">

                                            <i class="ti ti-report-money fs-40 d-block mb-2"></i>

                                            <h5>
                                                No Transactions Found
                                            </h5>

                                            <p class="mb-3">
                                                No income or expense entries match your current filters.
                                            </p>


                                            <% if (currentSearch || currentType) { %>

                                                <a
                                                    href="/admin/income-expense"
                                                    class="btn btn-light btn-sm me-1"
                                                >

                                                    Clear Filters

                                                </a>

                                            <% } %>


                                            <button
                                                type="button"
                                                class="btn btn-primary btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#addEntryModal"
                                            >

                                                <i class="ti ti-plus me-1"></i>

                                                Add Entry

                                            </button>

                                        </div>

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     PAGINATION
                ================================================== -->

                <% if (totalEntryPages > 1) { %>

                    <div class="row align-items-center mt-3">


                        <!-- Info -->

                        <div class="col-md-6">

                            <div class="text-muted">

                                Page
                                <%= currentPage %>
                                of
                                <%= totalEntryPages %>

                                &nbsp;·&nbsp;

                                <%= totalEntries %>
                                total entries

                            </div>

                        </div>


                        <!-- Pagination -->

                        <div class="col-md-6">

                            <div class="d-flex justify-content-end">

                                <ul class="pagination mb-0">


                                    <!-- Previous -->

                                    <% if (currentPage > 1) { %>

                                        <li class="page-item">

                                            <a
                                                class="page-link"
                                                href="/admin/income-expense?<%= buildQuery({
                                                    page: currentPage - 1,
                                                    search: currentSearch,
                                                    type: currentType
                                                }) %>#transactions"
                                            >

                                                <i class="ti ti-chevron-left"></i>

                                            </a>

                                        </li>

                                    <% } %>


                                    <%
                                        const pageStart =
                                            Math.max(
                                                1,
                                                currentPage - 2
                                            );

                                        const pageEnd =
                                            Math.min(
                                                totalEntryPages,
                                                currentPage + 2
                                            );
                                    %>


                                    <% for (let pg = pageStart; pg <= pageEnd; pg++) { %>

                                        <li
                                            class="page-item <%= pg === currentPage ? 'active' : '' %>"
                                        >

                                            <a
                                                class="page-link"
                                                href="/admin/income-expense?<%= buildQuery({
                                                    page: pg,
                                                    search: currentSearch,
                                                    type: currentType
                                                }) %>#transactions"
                                            >

                                                <%= pg %>

                                            </a>

                                        </li>

                                    <% } %>


                                    <!-- Next -->

                                    <% if (currentPage < totalEntryPages) { %>

                                        <li class="page-item">

                                            <a
                                                class="page-link"
                                                href="/admin/income-expense?<%= buildQuery({
                                                    page: currentPage + 1,
                                                    search: currentSearch,
                                                    type: currentType
                                                }) %>#transactions"
                                            >

                                                <i class="ti ti-chevron-right"></i>

                                            </a>

                                        </li>

                                    <% } %>

                                </ul>

                            </div>

                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

</div>


<!-- ================================================================
     ADD ACCOUNT MODAL
================================================================ -->

<div
    class="modal fade finance-modal"
    id="addBankModal"
    tabindex="-1"
    aria-hidden="true"
>

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">


            <form
                method="POST"
                action="/admin/income-expense/bank"
            >


                <div class="modal-header">

                    <div>

                        <h5 class="modal-title mb-1">
                            Add Account
                        </h5>

                        <small class="text-muted">
                            Add your bank, wallet or cash account.
                        </small>

                    </div>


                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                    ></button>

                </div>


                <div class="modal-body">


                    <!-- Account Name -->

                    <div class="mb-3">

                        <label class="form-label">

                            Account Name

                            <span class="text-danger">
                                *
                            </span>

                        </label>

                        <input
                            type="text"
                            name="name"
                            class="form-control"
                            required
                            maxlength="255"
                            placeholder="e.g. HDFC Savings"
                        >

                    </div>


                    <!-- Account Number -->

                    <div class="mb-3">

                        <label class="form-label">

                            Account Number

                            <span class="text-muted fw-normal">
                                (Optional)
                            </span>

                        </label>

                        <input
                            type="text"
                            name="account_number"
                            class="form-control"
                            maxlength="100"
                            placeholder="Enter account number"
                        >

                    </div>


                    <!-- Opening Balance -->

                    <div class="mb-3">

                        <label class="form-label">
                            Opening Balance
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input
                                type="number"
                                name="opening_balance"
                                class="form-control"
                                min="0"
                                step="0.01"
                                value="0"
                                placeholder="0.00"
                            >

                        </div>

                    </div>


                    <!-- Active -->

                    <div class="form-check form-switch">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            name="is_active"
                            value="1"
                            id="addBankActive"
                            checked
                        >

                        <label
                            class="form-check-label"
                            for="addBankActive"
                        >
                            Active Account
                        </label>

                    </div>


                </div>


                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>


                    <button
                        type="submit"
                        class="btn btn-primary"
                    >

                        <i class="ti ti-plus me-1"></i>

                        Add Account

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


