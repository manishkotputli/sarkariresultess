================================================================ -->

<div
    class="modal fade finance-modal"
    id="addEntryModal"
    tabindex="-1"
    aria-hidden="true"
>

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">


            <form
                method="POST"
                action="/admin/income-expense"
            >


                <div class="modal-header">

                    <div>

                        <h5 class="modal-title mb-1">
                            Add Income / Expense
                        </h5>

                        <small class="text-muted">
                            Record a transaction against your account.
                        </small>

                    </div>


                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                    ></button>

                </div>


                <div class="modal-body">


                    <div class="row">


                        <!-- TYPE -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Transaction Type

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <select
                                name="type"
                                id="addEntryType"
                                class="form-select"
                                required
                            >

                                <option value="">
                                    Select type
                                </option>

                                <option value="1">
                                    Income
                                </option>

                                <option value="2">
                                    Expense
                                </option>

                            </select>

                        </div>


                        <!-- CATEGORY -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Category

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <select
                                name="category_id"
                                id="addEntryCategory"
                                class="form-select"
                                required
                            >

                                <option value="">
                                    Select category
                                </option>

                            </select>

                        </div>


                        <!-- ACCOUNT -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Account

                                <span class="text-muted fw-normal">
                                    (Optional)
                                </span>

                            </label>

                            <select
                                name="bank_id"
                                id="addEntryBank"
                                class="form-select"
                            >

                                <option value="">
                                    Cash / No Account
                                </option>

                            </select>

                        </div>


                        <!-- TITLE -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Title

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <input
                                type="text"
                                name="title"
                                class="form-control"
                                required
                                maxlength="255"
                                placeholder="e.g. Course sale commission"
                            >

                        </div>


                        <!-- AMOUNT -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Amount

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₹
                                </span>

                                <input
                                    type="number"
                                    name="amount"
                                    class="form-control"
                                    required
                                    min="0.01"
                                    step="0.01"
                                    placeholder="0.00"
                                >

                            </div>

                        </div>


                        <!-- DATE -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Transaction Date

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <input
                                type="date"
                                name="transaction_date"
                                class="form-control"
                                required
                                id="addEntryDate"
                            >

                        </div>


                        <!-- NOTE -->

                        <div class="col-12 mb-0">

                            <label class="form-label">

                                Note

                                <span class="text-muted fw-normal">
                                    (Optional)
                                </span>

                            </label>

                            <textarea
                                name="note"
                                rows="3"
                                class="form-control"
                                maxlength="2000"
                                placeholder="Add any additional note..."
                            ></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>


                    <button
                        type="submit"
                        class="btn btn-primary"
                    >

                        <i class="ti ti-plus me-1"></i>

                        Add Entry

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ================================================================
     EDIT ENTRY MODAL
================================================================ -->

<div
    class="modal fade finance-modal"
    id="editEntryModal"
    tabindex="-1"
    aria-hidden="true"
>

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">


            <form
                method="POST"
                id="editEntryForm"
                action=""
            >


                <div class="modal-header">

                    <div>

                        <h5 class="modal-title mb-1">
                            Edit Income / Expense
                        </h5>

                        <small class="text-muted">
                            Update transaction details.
                        </small>

                    </div>


                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                    ></button>

                </div>


                <div class="modal-body">

                    <div class="row">


                        <!-- TYPE -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Transaction Type

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <select
                                name="type"
                                id="editEntryType"
                                class="form-select"
                                required
                            >

                                <option value="1">
                                    Income
                                </option>

                                <option value="2">
                                    Expense
                                </option>

                            </select>

                        </div>


                        <!-- CATEGORY -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Category

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <select
                                name="category_id"
                                id="editEntryCategory"
                                class="form-select"
                                required
                            >

                                <option value="">
                                    Select category
                                </option>

                            </select>

                        </div>


                        <!-- ACCOUNT -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Account

                                <span class="text-muted fw-normal">
                                    (Optional)
                                </span>

                            </label>

                            <select
                                name="bank_id"
                                id="editEntryBank"
                                class="form-select"
                            >

                                <option value="">
                                    Cash / No Account
                                </option>

                            </select>

                        </div>


                        <!-- TITLE -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Title

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <input
                                type="text"
                                name="title"
                                id="editEntryTitle"
                                class="form-control"
                                required
                                maxlength="255"
                            >

                        </div>


                        <!-- AMOUNT -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Amount

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₹
                                </span>

                                <input
                                    type="number"
                                    name="amount"
                                    id="editEntryAmount"
                                    class="form-control"
                                    required
                                    min="0.01"
                                    step="0.01"
                                >

                            </div>

                        </div>


                        <!-- DATE -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Transaction Date

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <input
                                type="date"
                                name="transaction_date"
                                id="editEntryDate"
                                class="form-control"
                                required
                            >

                        </div>


                        <!-- NOTE -->

                        <div class="col-12">

                            <label class="form-label">

                                Note

                                <span class="text-muted fw-normal">
                                    (Optional)
                                </span>

                            </label>

                            <textarea
                                name="note"
                                id="editEntryNote"
                                rows="3"
                                class="form-control"
                                maxlength="2000"
                            ></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>


                    <button
                        type="submit"
                        class="btn btn-primary"
                    >

                        <i class="ti ti-device-floppy me-1"></i>

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ================================================================
     DELETE ENTRY MODAL
================================================================ -->

<div
    class="modal fade"
    id="deleteEntryModal"
    tabindex="-1"
    aria-hidden="true"
>

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">


            <form
                method="POST"
                id="deleteEntryForm"
                action=""
            >


                <div class="modal-body text-center p-4 p-md-5">

                    <div
                        class="avatar avatar-xl bg-soft-danger text-danger rounded-circle mx-auto mb-3"
                    >

                        <i class="ti ti-trash fs-24"></i>

                    </div>


                    <h5 class="mb-2">
                        Delete Transaction?
                    </h5>


                    <p class="text-muted mb-0">

                        Are you sure you want to delete

                        <strong id="deleteEntryTitle">
                        </strong>?

                        This action cannot be undone.

                    </p>

                </div>


                <div class="modal-footer justify-content-center">

                    <button
                        type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>


                    <button
                        type="submit"
                        class="btn btn-danger"
                    >

                        <i class="ti ti-trash me-1"></i>

                        Delete Entry

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<script>

document.addEventListener(
    'DOMContentLoaded',
    function () {


        /*
        |--------------------------------------------------------------------------
        | Data
        |--------------------------------------------------------------------------
        */

        const ALL_BANKS =
            <%- bankOptionsJson %>;

        const ALL_CATEGORIES =
            <%- categoryOptionsJson %>;


        /*
        |--------------------------------------------------------------------------
        | Today's Date
        |--------------------------------------------------------------------------
        */

        const addDate =
            document.getElementById(
                'addEntryDate'
            );

        if (addDate && !addDate.value) {

            const today =
                new Date();

            const year =
                today.getFullYear();

            const month =
                String(
                    today.getMonth() + 1
                ).padStart(2, '0');

            const day =
                String(
                    today.getDate()
                ).padStart(2, '0');

            addDate.value =
                year +
                '-' +
                month +
                '-' +
                day;

        }


        /*
        |--------------------------------------------------------------------------
        | Bootstrap Modal Helper
        |--------------------------------------------------------------------------
        */

        function openModal(id) {

            const element =
                document.getElementById(id);

            if (!element) {
                return;
            }

            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    element
                );

            modal.show();

        }


        /*
        |--------------------------------------------------------------------------
        | Populate Bank Select
        |--------------------------------------------------------------------------
        */

        function populateBanks(
            selectId,
            selectedValue
        ) {

            const select =
                document.getElementById(
                    selectId
                );

            if (!select) {
                return;
            }


            select.innerHTML = '';


            const blank =
                document.createElement(
                    'option'
                );

            blank.value = '';

            blank.textContent =
                'Cash / No Account';

            select.appendChild(blank);


            ALL_BANKS.forEach(
                function (bank) {

                    const option =
                        document.createElement(
                            'option'
                        );

                    option.value =
                        bank.id;

                    option.textContent =
                        bank.name;

                    if (
                        String(bank.id) ===
                        String(selectedValue || '')
                    ) {

                        option.selected =
                            true;

                    }

                    select.appendChild(
                        option
                    );

                }
            );

        }


        /*
        |--------------------------------------------------------------------------
        | Populate Categories
        |--------------------------------------------------------------------------
        */

        function populateCategories(
            selectId,
            type,
            selectedValue
        ) {

            const select =
                document.getElementById(
                    selectId
                );

            if (!select) {
                return;
            }


            select.innerHTML = '';


            const blank =
                document.createElement(
                    'option'
                );

            blank.value = '';

            blank.textContent =
                'Select category';

            select.appendChild(
                blank
            );


            ALL_CATEGORIES
                .filter(
                    function (category) {

                        return (
                            !type ||
                            Number(category.type) ===
                            Number(type)
                        );

                    }
                )
                .forEach(
                    function (category) {

                        const option =
                            document.createElement(
                                'option'
                            );

                        option.value =
                            category.id;

                        option.textContent =
                            category.name;


                        if (
                            String(category.id) ===
                            String(selectedValue || '')
                        ) {

                            option.selected =
                                true;

                        }


                        select.appendChild(
                            option
                        );

                    }
                );

        }


        /*
        |--------------------------------------------------------------------------
        | Add Entry Type
        |--------------------------------------------------------------------------
        */

        const addType =
            document.getElementById(
                'addEntryType'
            );

        if (addType) {

            addType.addEventListener(
                'change',
                function () {

                    populateCategories(
                        'addEntryCategory',
                        this.value,
                        ''
                    );

                }
            );

        }


        /*
        |--------------------------------------------------------------------------
        | Initial Add Selects
        |--------------------------------------------------------------------------
        */

        populateBanks(
            'addEntryBank',
            ''
        );

        populateCategories(
            'addEntryCategory',
            addType
                ? addType.value
                : '',
            ''
        );


        /*
        |--------------------------------------------------------------------------
        | Edit Bank
        |--------------------------------------------------------------------------
        */

        document
            .querySelectorAll(
                '.editBankBtn'
            )
            .forEach(
                function (button) {

                    button.addEventListener(
                        'click',
                        function () {

                            const id =
                                this.dataset.id;

                            document
                                .getElementById(
                                    'editBankForm'
                                )
                                .action =
                                '/admin/income-expense/bank/' +
                                id +
                                '/update';


                            document
                                .getElementById(
                                    'editBankName'
                                )
                                .value =
                                this.dataset.name ||
                                '';


                            document
                                .getElementById(
                                    'editBankAccount'
                                )
                                .value =
                                this.dataset.account ||
                                '';


                            document
                                .getElementById(
                                    'editBankBalance'
                                )
                                .value =
                                this.dataset.balance ||
                                '0';


                            document
                                .getElementById(
                                    'editBankActive'
                                )
                                .checked =
                                this.dataset.active ===
                                '1';


                            openModal(
                                'editBankModal'
                            );

                        }
                    );

                }
            );


        /*
        |--------------------------------------------------------------------------
        | Delete Bank
        |--------------------------------------------------------------------------
        */

        document
            .querySelectorAll(
                '.deleteBankBtn'
            )
            .forEach(
                function (button) {

                    button.addEventListener(
                        'click',
                        function () {

                            document
                                .getElementById(
                                    'deleteBankForm'
                                )
                                .action =
                                '/admin/income-expense/bank/' +
                                this.dataset.id +
                                '/delete';


                            document
                                .getElementById(
                                    'deleteBankName'
                                )
                                .textContent =
                                this.dataset.name ||
                                'this account';


                            openModal(
                                'deleteBankModal'
                            );

                        }
                    );

                }
            );


        /*
        |--------------------------------------------------------------------------
        | Edit Entry
        |--------------------------------------------------------------------------
        */

        document
            .querySelectorAll(
                '.editEntryBtn'
            )
            .forEach(
                function (button) {

                    button.addEventListener(
                        'click',
                        function () {

                            const type =
                                this.dataset.type ||
                                '1';

                            const category =
                                this.dataset.category ||
                                '';

                            const bank =
                                this.dataset.bank ||
                                '';


                            document
                                .getElementById(
                                    'editEntryForm'
                                )
                                .action =
                                '/admin/income-expense/' +
                                this.dataset.id +
                                '/update';


                            document
                                .getElementById(
                                    'editEntryType'
                                )
                                .value =
                                type;


                            populateCategories(
                                'editEntryCategory',
                                type,
                                category
                            );


                            populateBanks(
                                'editEntryBank',
                                bank
                            );


                            document
                                .getElementById(
                                    'editEntryTitle'
                                )
                                .value =
                                this.dataset.title ||
                                '';


                            document
                                .getElementById(
                                    'editEntryAmount'
                                )
                                .value =
                                this.dataset.amount ||
                                '';


                            document
                                .getElementById(
                                    'editEntryDate'
                                )
                                .value =
                                this.dataset.date ||
                                '';


                            document
                                .getElementById(
                                    'editEntryNote'
                                )
                                .value =
                                this.dataset.note ||
                                '';


                            openModal(
                                'editEntryModal'
                            );

                        }
                    );

                }
            );


        /*
        |--------------------------------------------------------------------------
        | Edit Entry Type Change
        |--------------------------------------------------------------------------
        */

        const editType =
            document.getElementById(
                'editEntryType'
            );

        if (editType) {

            editType.addEventListener(
                'change',
                function () {

                    populateCategories(
                        'editEntryCategory',
                        this.value,
                        ''
                    );

                }
            );

        }


        /*
        |--------------------------------------------------------------------------
        | Delete Entry
        |--------------------------------------------------------------------------
        */

        document
            .querySelectorAll(
                '.deleteEntryBtn'
            )
            .forEach(
                function (button) {

                    button.addEventListener(
                        'click',
                        function () {

                            document
                                .getElementById(
                                    'deleteEntryForm'
                                )
                                .action =
                                '/admin/income-expense/' +
                                this.dataset.id +
                                '/delete';


                            document
                                .getElementById(
                                    'deleteEntryTitle'
                                )
                                .textContent =
                                this.dataset.title ||
                                'this transaction';


                            openModal(
                                'deleteEntryModal'
                            );

                        }
                    );

                }
            );


        /*
        |--------------------------------------------------------------------------
        | Manage Columns
        |--------------------------------------------------------------------------
        */

        const table =
            document.getElementById(
                'income-expense-table'
            );

        const toggles =
            document.querySelectorAll(
                '#income-expense-table ~ * .column-toggle'
            );


        /*
         * Better selector because Manage Columns
         * is outside the table.
         */

        const columnToggles =
            document.querySelectorAll(
                '.column-toggle[data-column]'
            );


        function applyColumn(
            columnIndex,
            visible
        ) {

            if (!table) {
                return;
            }


            const display =
                visible
                    ? ''
                    : 'none';


            table
                .querySelectorAll(
                    'tr'
                )
                .forEach(
                    function (row) {

                        const cell =
                            row.children[
                                columnIndex
                            ];


                        if (!cell) {
                            return;
                        }


                        if (visible) {

                            cell.style.removeProperty(
                                'display'
                            );

                        } else {

                            cell.style.setProperty(
                                'display',
                                'none',
                                'important'
                            );

                        }

                    }
                );

        }


        columnToggles.forEach(
            function (toggle) {

                const column =
                    parseInt(
                        toggle.dataset.column,
                        10
                    );

                const key =
                    toggle.dataset.key ||
                    column;


                const storageKey =
                    'income_expense_column_' +
                    key;


                const saved =
                    localStorage.getItem(
                        storageKey
                    );


                if (
                    saved === '0'
                ) {

                    toggle.checked =
                        false;

                    applyColumn(
                        column,
                        false
                    );

                }


                toggle.addEventListener(
                    'change',
                    function () {

                        const visible =
                            this.checked;


                        localStorage.setItem(
                            storageKey,
                            visible
                                ? '1'
                                : '0'
                        );


                        applyColumn(
                            column,
                            visible
                        );

                    }
                );

            }
        );


    }
);

</script>


<%- include('../../adminlayout/footer') %>