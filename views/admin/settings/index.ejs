                                    <!-- ADSENSE FOOTER -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            AdSense (Footer)
                                        </label>

                                        <textarea name="adsense_footer"
                                                  rows="3"
                                                  class="form-control font-monospace fs-12"><%= setting.adsense_footer || '' %></textarea>

                                    </div>


                                    <!-- ADSENSE SIDEBAR -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            AdSense (Sidebar)
                                        </label>

                                        <textarea name="adsense_sidebar"
                                                  rows="3"
                                                  class="form-control font-monospace fs-12"><%= setting.adsense_sidebar || '' %></textarea>

