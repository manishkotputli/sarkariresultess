<%- include('../../adminlayout/header') %>

<div class="page-wrapper">

    <!-- Start Content -->
    <div class="content pb-0">

        <!-- =========================
             ALERTS
        ========================== -->

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <%= success %>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        <% } %>

        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">

                <ul class="mb-0">

                    <% errors.forEach(function(error) { %>
                        <li><%= error %></li>
                    <% }) %>

                </ul>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>

            </div>
        <% } %>


        <!-- =========================
             PAGE HEADER
        ========================== -->

        <div class="d-flex align-items-center justify-content-between gap-2 mb-4 flex-wrap">

            <div>

                <h4 class="mb-1">Settings</h4>

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb mb-0 p-0">

                        <li class="breadcrumb-item">
                            <a href="/admin">Home</a>
                        </li>

                        <li class="breadcrumb-item active"
                            aria-current="page">

                            Settings

                        </li>

                    </ol>

                </nav>

            </div>


            <div class="gap-2 d-flex align-items-center flex-wrap">

                <!-- Refresh -->
                <a href="javascript:location.reload();"
                   class="btn btn-icon btn-outline-light shadow"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   aria-label="Refresh"
                   data-bs-original-title="Refresh">

                    <i class="ti ti-refresh"></i>

                </a>


                <!-- Collapse -->
                <a href="javascript:void(0);"
                   class="btn btn-icon btn-outline-light shadow"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   aria-label="Collapse"
                   data-bs-original-title="Collapse"
                   id="collapse-header">

                    <i class="ti ti-transition-top"></i>

                </a>

            </div>

        </div>


        <!-- =========================
             SETTINGS FORM
        ========================== -->

        <form method="POST"
              action="/admin/settings"
              enctype="multipart/form-data"
              id="settingsForm">

            <div class="row">


                <!-- =========================================
                     SETTINGS SIDEBAR
                ========================================== -->

                <div class="col-xl-3 col-lg-4 mb-4">

                    <div class="card border-0 rounded-0">

                        <div class="card-body p-2">

                            <div class="nav flex-column nav-pills"
                                 id="settingsTabs"
                                 role="tablist"
                                 aria-orientation="vertical">


                                <!-- General -->

                                <button type="button"
                                        class="settingsTabBtn nav-link text-start active"
                                        data-tab="general">

                                    <i class="ti ti-settings me-2"></i>

                                    General

                                </button>


                                <!-- Contact -->

                                <button type="button"
                                        class="settingsTabBtn nav-link text-start"
                                        data-tab="contact">

                                    <i class="ti ti-address-book me-2"></i>

                                    Contact &amp; Social

                                </button>


                                <!-- SEO -->

                                <button type="button"
                                        class="settingsTabBtn nav-link text-start"
                                        data-tab="seo">

                                    <i class="ti ti-seo me-2"></i>

                                    SEO &amp; Scripts

                                </button>


                                <!-- SMTP -->

                                <button type="button"
                                        class="settingsTabBtn nav-link text-start"
                                        data-tab="smtp">

                                    <i class="ti ti-mail-cog me-2"></i>

                                    SMTP

                                </button>


                                <!-- Maintenance -->

                                <button type="button"
                                        class="settingsTabBtn nav-link text-start"
                                        data-tab="maintenance">

                                    <i class="ti ti-tool me-2"></i>

                                    Maintenance Mode

                                </button>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =========================================
                     SETTINGS CONTENT
                ========================================== -->

                <div class="col-xl-9 col-lg-8">


                    <!-- =====================================
                         GENERAL
                    ====================================== -->

                    <div class="settingsTabPanel"
                         data-tab-panel="general">


                        <!-- GENERAL -->

                        <div class="card border-0 rounded-0 mb-4">

                            <div class="card-header">

                                <h5 class="card-title mb-0">

                                    <i class="ti ti-settings me-2"></i>

                                    General

                                </h5>

                            </div>


                            <div class="card-body">

                                <div class="row">


                                    <!-- SITE TITLE -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Site Title
                                        </label>

                                        <input type="text"
                                               name="site_title"
                                               value="<%= setting.site_title || '' %>"
                                               class="form-control">

                                    </div>


                                    <!-- TAGLINE -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Tagline
                                        </label>

                                        <input type="text"
                                               name="tagline"
                                               value="<%= setting.tagline || '' %>"
                                               class="form-control">

                                    </div>


                                    <!-- HOME NOTE -->

                                    <div class="col-12 mb-3">

                                        <label class="form-label">
                                            Home Page Note
                                        </label>

                                        <textarea name="home_note"
                                                  rows="3"
                                                  class="form-control"><%= setting.home_note || '' %></textarea>

                                    </div>


                                    <!-- FOOTER TEXT -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Footer Text
                                        </label>

                                        <textarea name="footer_text"
                                                  rows="2"
                                                  class="form-control"><%= setting.footer_text || '' %></textarea>

                                    </div>


                                    <!-- COPYRIGHT -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Footer Copyright
                                        </label>

                                        <input type="text"
                                               name="footer_copyright"
                                               value="<%= setting.footer_copyright || '' %>"
                                               class="form-control">

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- BRANDING -->

                        <div class="card border-0 rounded-0">

                            <div class="card-header">

                                <h5 class="card-title mb-0">

                                    <i class="ti ti-brand-framer me-2"></i>

                                    Branding

                                </h5>

                            </div>


                            <div class="card-body">

                                <div class="row">


                                    <!-- LOGO -->

                                    <div class="col-md-4 mb-3">

                                        <label class="form-label">
                                            Logo
                                        </label>

                                        <% if (setting.logo) { %>

                                            <div class="mb-3 p-2 border rounded">

                                                <img src="<%= setting.logo %>"
                                                     class="img-fluid"
                                                     style="max-height:70px;"
                                                     alt="Logo">

                                            </div>

                                        <% } %>

                                        <input type="file"
                                               name="logo"
                                               accept="image/*"
                                               class="form-control">

                                    </div>


                                    <!-- FAVICON -->

                                    <div class="col-md-4 mb-3">

                                        <label class="form-label">
                                            Favicon
                                        </label>

                                        <% if (setting.favicon) { %>

                                            <div class="mb-3 p-2 border rounded">

                                                <img src="<%= setting.favicon %>"
                                                     class="img-fluid"
                                                     style="max-height:70px;"
                                                     alt="Favicon">

                                            </div>

                                        <% } %>

                                        <input type="file"
                                               name="favicon"
                                               accept="image/*"
                                               class="form-control">

                                    </div>


                                    <!-- FOOTER LOGO -->

                                    <div class="col-md-4 mb-3">

                                        <label class="form-label">
                                            Footer Logo
                                        </label>

                                        <% if (setting.footer_logo) { %>

                                            <div class="mb-3 p-2 border rounded">

                                                <img src="<%= setting.footer_logo %>"
                                                     class="img-fluid"
                                                     style="max-height:70px;"
                                                     alt="Footer Logo">

                                            </div>

                                        <% } %>

                                        <input type="file"
                                               name="footer_logo"
                                               accept="image/*"
                                               class="form-control">

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =====================================
                         CONTACT & SOCIAL
                    ====================================== -->

                    <div class="settingsTabPanel d-none"
                         data-tab-panel="contact">


                        <!-- CONTACT INFO -->

                        <div class="card border-0 rounded-0 mb-4">

                            <div class="card-header">

                                <h5 class="card-title mb-0">

                                    <i class="ti ti-address-book me-2"></i>

                                    Contact Information

                                </h5>

                            </div>


                            <div class="card-body">

                                <div class="row">


                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Contact Email
